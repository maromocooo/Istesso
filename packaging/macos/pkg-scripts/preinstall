#!/bin/bash
# Runs as root before the files are replaced. Stops the agent of the user who is logged in
# at the console, so that the executable is not replaced under a running process.
# It never fails the installation.
user=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)
if [ -n "$user" ] && [ "$user" != "root" ]; then
    uid=$(/usr/bin/id -u "$user" 2>/dev/null || true)
    if [ -n "$uid" ]; then
        /bin/launchctl bootout "gui/$uid/com.maromoco.istesso.agent" >/dev/null 2>&1 || true
    fi
fi
exit 0
