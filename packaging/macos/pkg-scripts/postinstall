#!/bin/bash
# Runs as root after the files are in place. Starts the agent for the user who is logged in
# at the console. Other users get it at their next login (RunAtLoad).
# It does not touch the permission database, the user's files or keys. It never fails the
# installation.
user=$(/usr/bin/stat -f %Su /dev/console 2>/dev/null || true)
plist=/Library/LaunchAgents/com.maromoco.istesso.agent.plist
if [ -n "$user" ] && [ "$user" != "root" ] && [ -f "$plist" ]; then
    uid=$(/usr/bin/id -u "$user" 2>/dev/null || true)
    if [ -n "$uid" ]; then
        /bin/launchctl bootstrap "gui/$uid" "$plist" >/dev/null 2>&1 || true
    fi
fi
exit 0
