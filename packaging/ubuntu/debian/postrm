#!/bin/sh
# Removing the package keeps /etc/istesso. Purging removes the one file the package wrote
# there. The group "istesso", and every user's keys and paired devices, stay.
set -e

case "$1" in
remove | purge)
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
    fi
    ;;
esac
case "$1" in
purge)
    rm -f /etc/istesso/encoder-sessions
    rmdir /etc/istesso 2>/dev/null || true
    ;;
esac

exit 0
