#!/bin/sh
# What it does: creates the system group "istesso"; reloads the udev rules; writes the
# number of pictures the GPU may compress at once, if there is none yet.
# What it does NOT do: add anybody to a group; enable or start any service; enable linger;
# touch any user's files, keys or paired devices; change any kernel or sleep setting;
# download anything.
set -e

case "$1" in
configure)
    if ! getent group istesso >/dev/null; then
        addgroup --system istesso >/dev/null
    fi

    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload-rules >/dev/null 2>&1 || true
    fi

    # Number of simultaneous compression sessions: counted once, while no picture flows, as
    # (what the GPU allows) minus 2; 8 when it was not counted. Never overwritten later.
    conf=/etc/istesso/encoder-sessions
    if [ ! -e "$conf" ]; then
        n=8
        helper=/usr/libexec/istesso/count-encoder-sessions
        if [ -x "$helper" ]; then
            counted=$("$helper" --only-when-idle 2>/dev/null || true)
            case "$counted" in
            '' | *[!0-9]*) ;;
            *)
                if [ "$counted" -gt 2 ]; then n=$((counted - 2)); else n=1; fi
                ;;
            esac
        fi
        mkdir -p /etc/istesso
        echo "$n" >"$conf"
    fi
    ;;
esac

exit 0
