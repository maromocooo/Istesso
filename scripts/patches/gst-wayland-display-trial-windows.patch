+    // before, and is told it is active now.
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    click(&mut f);
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    assert!(f.client.told_active(0));
+    assert!(!f.client.told_active(1));
+}
