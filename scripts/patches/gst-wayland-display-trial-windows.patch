+/// Whether the server's keyboard is in this window, or in a popup of it.
+fn keyboard_in(f: &Fixture, window: &smithay::desktop::Window) -> (bool, bool) {
+    match f.server.seat.get_keyboard().unwrap().current_focus() {
+        Some(crate::comp::FocusTarget::Wayland(w)) => (&w == window, false),
+        Some(crate::comp::FocusTarget::Popup(_)) => (false, true),
+        None => (false, false),
+    }
+}
