+fn after_a_submenu_has_closed_a_click_outside_still_dismisses_its_menu() {
+    // (With the order of the seat's grabs in this compositor, a submenu's grab leaves the
+    // keyboard on the window, so the submenu is never the keyboard's focus here and this
+    // test passes with or without the check for an open menu; it guards the outcome.)
+    let mut f = fixture();
+    let menu = open_a_menu(&mut f);
+    let serial = f.client.last_button_serial().unwrap();
+    let submenu = f.client.open_popup_on_popup(menu, serial);
+    f.round_trip();
+    f.round_trip();
+    assert!(!f.client.popup_dismissed(submenu));
+    // The submenu closes (the person goes back to the menu); the menu stays open.
+    f.client.close_popup(submenu);
+    f.round_trip();
+    assert!(!f.client.popup_dismissed(menu));
+    // A click outside the menu, in the window: the menu is dismissed.
+    click(&mut f);
+    f.round_trip();
+    assert!(f.client.popup_dismissed(menu));
+}
