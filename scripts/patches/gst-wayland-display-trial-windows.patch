+use smithay::{
+    delegate_xdg_activation,
+    reexports::wayland_server::protocol::wl_surface::WlSurface,
+    wayland::{
+        seat::WaylandFocus,
+        xdg_activation::{
+            XdgActivationHandler, XdgActivationState, XdgActivationToken, XdgActivationTokenData,
+        },
+    },
+};
+
+use crate::comp::State;
+
+/// How long a token is good for: an application asks for a window to come forward right
+/// after it was told to (a second instance started, a link opened).
+const TOKEN_LIFETIME_S: u64 = 10;
+
+impl XdgActivationHandler for State {
+    fn activation_state(&mut self) -> &mut XdgActivationState {
+        &mut self.activation_state
+    }
+
+    fn request_activation(
+        &mut self,
+        token: XdgActivationToken,
+        token_data: XdgActivationTokenData,
+        surface: WlSurface,
+    ) {
+        self.activation_state.remove_token(&token);
+        if token_data.timestamp.elapsed().as_secs() >= TOKEN_LIFETIME_S {
+            return;
+        }
+        // A window that is not shown yet comes in front, with the keyboard, when it is.
+        let shown = self
+            .space
+            .elements()
+            .find(|w| w.wl_surface().is_some_and(|s| *s == surface))
+            .cloned();
+        if let Some(window) = shown {
+            self.activate_window(&window);
+        }
+    }
+}
+
+delegate_xdg_activation!(State);
