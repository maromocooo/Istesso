+//! Integration tests for everyday use: the pointer, the button and the keyboard go to the same
+//! window, the one a person sees under the pointer; a window is told to be maximized, not
+//! fullscreen, unless it asks; a second window keeps its own size and is not lost under the
+//! first. A real Wayland client opens the windows.
+
+use crate::comp::apply_video_info;
+use crate::tests::fixture::Fixture;
+use crate::utils::RenderTarget;
+use crate::utils::video_info::GstVideoInfo;
+use smithay::backend::input::ButtonState;
+use smithay::utils::Point;
+use test_log::test;
+use wayland_protocols::xdg::shell::client::xdg_toplevel::State as Told;
+
+const WHITE: [u8; 4] = [255, 255, 255, 255];
+
+/// A first window that fills the output of 320 by 240, with the pointer in its middle.
+fn fixture() -> Fixture {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    f.server.set_cursor_sink(Some(Box::new(|_| {})));
+    f
+}
+
+fn click(f: &mut Fixture) {
+    f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    f.server.pointer_button(0, 0x110, ButtonState::Released);
+    f.round_trip();
+}
+
+#[test]
+fn a_window_shown_before_its_first_picture_has_the_pointer_from_that_picture_on() {
+    let mut f = fixture();
+    assert_eq!(f.client.pointer_and_buttons().0, Some(0));
+
+    // A second window without a parent that answers its configure and commits before it
+    // has drawn anything, as Blender does with its Preferences: it is shown, but has nothing
+    // in it yet that the pointer could be in.
+    f.client.create_window();
+    f.round_trip();
+    f.client.ack_and_commit_without_a_picture();
+    f.round_trip();
+    f.round_trip();
+    assert_eq!(f.server.space.elements().count(), 2);
+    assert_eq!(f.client.keyboard_window(), Some(1));
+
+    // Its first picture covers the place of the pointer, which has not moved: the pointer
+    // is in it from then on.
+    f.client.draw_last_window_of_one_colour((320, 240), WHITE);
+    f.round_trip();
+    f.round_trip();
+    assert_eq!(f.client.pointer_and_buttons().0, Some(1));
+
+    // A click without a move goes to it, and so does the keyboard.
+    click(&mut f);
+    assert_eq!(f.client.pointer_and_buttons(), (Some(1), vec![0, 2]));
+    assert_eq!(f.client.keyboard_window(), Some(1));
+    // And it is the active window; the first is told it is not.
+    assert!(f.client.told_active(1));
+    assert!(!f.client.told_active(0));
+}
+
+#[test]
+fn a_click_without_a_move_reaches_a_lone_window_with_the_keyboard() {
+    // The pointer has never moved: it stands where the output put it.
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    assert_eq!(f.client.pointer_and_buttons().0, None);
+
+    click(&mut f);
+    assert_eq!(f.client.pointer_and_buttons(), (Some(0), vec![2]));
+    assert_eq!(f.client.keyboard_window(), Some(0));
+}
+
+#[test]
+fn a_click_beside_a_dialog_gives_the_button_and_the_keyboard_to_the_parent() {
+    let mut f = fixture();
+    f.client.create_child_window();
+    f.round_trip();
+    f.client.setup_window_of_one_colour((120, 80), WHITE);
+    f.round_trip();
+    f.round_trip();
+    // The dialog lies over the middle, under the pointer, and has both.
+    assert_eq!(f.client.pointer_and_buttons().0, Some(1));
+    assert_eq!(f.client.keyboard_window(), Some(1));
+
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    click(&mut f);
+    assert_eq!(f.client.pointer_and_buttons(), (Some(0), vec![2, 0]));
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    // The parent is told it is the active window again, the dialog that it is not.
+    assert!(f.client.told_active(0));
+    assert!(!f.client.told_active(1));
+}
+
+#[test]
+fn the_first_window_is_told_maximized_at_the_size_of_the_output_not_fullscreen() {
+    let f = fixture();
+    let states = f.client.states_told_to_last_window();
+    assert!(states.contains(&Told::Maximized), "{states:?}");
+    assert!(!states.contains(&Told::Fullscreen), "{states:?}");
+    assert_eq!(f.client.told_to_last_window().0, (320, 240));
+}
+
+#[test]
+fn a_window_that_asks_for_fullscreen_has_it_and_is_maximized_again_when_it_leaves_it() {
+    let mut f = fixture();
+    f.client.ask_for_fullscreen(true);
+    f.round_trip();
+    let states = f.client.states_told_to_last_window();
+    assert!(states.contains(&Told::Fullscreen), "{states:?}");
+    assert_eq!(f.client.told_to_last_window().0, (320, 240));
+    f.client.ack_and_commit();
+    f.round_trip();
+
+    f.client.ask_for_fullscreen(false);
+    f.round_trip();
+    let states = f.client.states_told_to_last_window();
+    assert!(!states.contains(&Told::Fullscreen), "{states:?}");
+    assert!(states.contains(&Told::Maximized), "{states:?}");
+    assert_eq!(f.client.told_to_last_window().0, (320, 240));
+}
+
+#[test]
+fn a_maximized_window_is_told_the_new_size_of_the_output() {
+    let mut f = fixture();
+    let video_info = GstVideoInfo::RAW(
+        gst_video::VideoInfo::builder(gst_video::VideoFormat::Rgba, 640, 360)
+            .fps(gst::Fraction::new(30, 1))
+            .build()
+            .unwrap(),
+    );
+    apply_video_info(&mut f.server, video_info, &RenderTarget::Software, None);
+    f.round_trip();
+    f.round_trip();
+    let states = f.client.states_told_to_last_window();
+    assert!(states.contains(&Told::Maximized), "{states:?}");
+    assert!(!states.contains(&Told::Fullscreen), "{states:?}");
+    assert_eq!(f.client.told_to_last_window().0, (640, 360));
+}
+
+/// Opens a second window without a parent that draws itself once at this size.
+fn open_a_second_window(f: &mut Fixture, size: (i32, i32)) {
+    f.client.create_window();
+    f.round_trip();
+    f.client.setup_window_of_one_colour(size, WHITE);
+    f.round_trip();
+    f.round_trip();
+}
+
+#[test]
+fn a_second_window_without_a_parent_keeps_its_size_and_lies_over_the_middle() {
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    assert_eq!(
+        f.client.told_to_last_window(),
+        ((0, 0), Some((320, 240)), false)
+    );
+    let stack: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(
+        f.server.space.element_location(&stack[1]).unwrap(),
+        (100, 80).into()
+    );
+    // It came up under the pointer, which stood in the middle: it has the pointer and the
+    // keyboard.
+    assert_eq!(f.client.pointer_and_buttons().0, Some(1));
+    assert_eq!(f.client.keyboard_window(), Some(1));
+
+    // Fullscreen, and back: it has its own size again, not the output's.
+    f.client.ask_for_fullscreen(true);
+    f.round_trip();
+    assert_eq!(
+        f.client.told_to_last_window(),
+        ((320, 240), Some((320, 240)), true)
+    );
+    f.client.ack_and_commit();
+    f.round_trip();
+    f.client.ask_for_fullscreen(false);
+    f.round_trip();
+    assert_eq!(
+        f.client.told_to_last_window(),
+        ((0, 0), Some((320, 240)), false)
+    );
+}
+
+#[test]
+fn the_main_window_raised_by_a_click_brings_the_smaller_window_back_on_top() {
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    let (main, smaller) = {
+        let stack: Vec<_> = f.server.space.elements().cloned().collect();
+        (stack[0].clone(), stack[1].clone())
+    };
+
+    // A click in the smaller window, and the application asks, as the answer to it, for its
+    // main window to come forward (xdg_activation_v1): the main window is raised over the
+    // smaller one and has the keyboard.
+    click(&mut f);
+    let serial = f.client.last_button_serial();
+    f.client.ask_for_an_activation_token(serial);
+    f.round_trip();
+    f.client.activate_first_window();
+    f.round_trip();
+    f.round_trip();
+    let stack: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(stack, [smaller.clone(), main.clone()]);
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    assert!(f.client.told_active(0));
+    assert!(!f.client.told_active(1));
+    // The pointer, which stood over the smaller window, is in the main window now.
+    assert_eq!(f.client.pointer_and_buttons().0, Some(0));
+    let buttons_before = f.client.pointer_and_buttons().1;
+
+    // A click on the main window, beside where the smaller one lies: the main window has the
+    // button and the keyboard, and the smaller window is on top again.
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    click(&mut f);
+    let stack: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(stack, [main, smaller]);
+    assert_eq!(
+        f.client.pointer_and_buttons(),
+        (Some(0), vec![buttons_before[0] + 2, buttons_before[1]])
+    );
+    assert_eq!(f.client.keyboard_window(), Some(0));
+
+    // And it takes the pointer and a click again where it lies.
+    f.server
+        .pointer_motion_absolute(0, Point::from((150.0, 100.0)));
+    f.round_trip();
+    click(&mut f);
+    assert_eq!(
+        f.client.pointer_and_buttons(),
+        (Some(1), vec![buttons_before[0] + 2, buttons_before[1] + 2])
+    );
+    assert_eq!(f.client.keyboard_window(), Some(1));
+}
+
+#[test]
+fn a_second_window_shown_before_its_picture_lies_over_the_middle_by_the_size_of_its_picture() {
+    let mut f = fixture();
+    f.client.create_window();
+    f.round_trip();
+    f.client.ack_and_commit_without_a_picture();
+    f.round_trip();
+    f.round_trip();
+    f.client.draw_last_window_of_one_colour((120, 80), WHITE);
+    f.round_trip();
+    f.round_trip();
+    let stack: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(stack.len(), 2);
+    assert_eq!(
+        f.server.space.element_location(&stack[1]).unwrap(),
+        (100, 80).into()
+    );
+    // The pointer, in the middle, is in it.
+    assert_eq!(f.client.pointer_and_buttons().0, Some(1));
+}
+
+/// Asks for an activation token with this serial, then for the first window to come forward
+/// with it. Returns whether the first window came to the top with the keyboard.
+fn activate_with(f: &mut Fixture, serial: Option<u32>) -> bool {
+    f.client.ask_for_an_activation_token(serial);
+    f.round_trip();
+    f.client.activate_first_window();
+    f.round_trip();
+    f.round_trip();
+    let stack: Vec<_> = f.server.space.elements().cloned().collect();
+    let main = f
+        .server
+        .space
+        .elements()
+        .find(|w| crate::comp::fills_the_output(w))
+        .cloned();
+    stack.last().cloned() == main && f.client.keyboard_window() == Some(0)
+}
+
+#[test]
+fn an_activation_is_followed_only_as_the_answer_to_an_input_of_the_application_in_use() {
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    let main = f.server.space.elements().next().cloned().unwrap();
+    let before: Vec<_> = f.server.space.elements().cloned().collect();
+    // Asked for at will: no serial, or a serial that is no key or button event. Nothing
+    // moves; the window is only marked as wanting attention.
+    assert!(!activate_with(&mut f, None));
+    assert!(crate::comp::windows::wants_attention(&main));
+    assert!(!activate_with(&mut f, Some(1)));
+    let after: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(after, before);
+    assert_eq!(f.client.keyboard_window(), Some(1));
+    assert!(f.client.told_active(1));
+    // As the answer to a click in the window with the keyboard: it is followed, and the mark
+    // goes with the keyboard.
+    click(&mut f);
+    let serial = f.client.last_button_serial();
+    assert!(activate_with(&mut f, serial));
+    assert!(f.client.told_active(0));
+    assert!(!crate::comp::windows::wants_attention(&main));
+    // A token is used up by its request: none is kept.
+    assert_eq!(f.server.activation_state.tokens().count(), 0);
+}
+
+#[test]
+fn a_new_size_of_the_output_leaves_the_active_window_as_it_was() {
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    assert!(f.client.told_active(1));
+    let video_info = GstVideoInfo::RAW(
+        gst_video::VideoInfo::builder(gst_video::VideoFormat::Rgba, 640, 360)
+            .fps(gst::Fraction::new(30, 1))
+            .build()
+            .unwrap(),
+    );
+    apply_video_info(&mut f.server, video_info, &RenderTarget::Software, None);
+    f.round_trip();
+    f.round_trip();
+    // Only the window with the keyboard is active (the fault of 2026-11-18: after a new size
+    // every window was told it was active, and Blender took keys in a window with modifiers
+    // it had seen in another).
+    assert_eq!(f.client.keyboard_window(), Some(1));
+    assert!(!f.client.told_active(0));
+    assert!(f.client.told_active(1));
+    // The first window gets the keyboard back with a click: it was told it was inactive
+    // before, and is told it is active now.
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    click(&mut f);
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    assert!(f.client.told_active(0));
+    assert!(!f.client.told_active(1));
+}
+
+#[test]
+fn a_window_without_the_keyboard_that_asks_for_fullscreen_stays_where_it_is_in_the_stack() {
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    let before: Vec<_> = f.server.space.elements().cloned().collect();
+    // The first window, under the second and without the keyboard, asks for fullscreen: it
+    // is told so, but is not put over the window that has the keyboard.
+    f.client.ask_for_fullscreen_of(0, true);
+    f.round_trip();
+    let after: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(after, before);
+    assert_eq!(f.client.keyboard_window(), Some(1));
+}
+
+#[test]
+fn a_window_that_moves_under_the_pointer_is_told_where_the_pointer_lies_in_it() {
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    // The pointer stands at 160,120 of the output, which is 60,40 of the window in the middle.
+    assert_eq!(f.client.last_pointer_position(), Some((60.0, 40.0)));
+    // It goes fullscreen, to the corner: the pointer lies at 160,120 of it now.
+    f.client.ask_for_fullscreen(true);
+    f.round_trip();
+    f.client.draw_last_window_of_one_colour((320, 240), WHITE);
+    f.round_trip();
+    f.round_trip();
+    assert_eq!(f.client.pointer_and_buttons().0, Some(1));
+    assert_eq!(f.client.last_pointer_position(), Some((160.0, 120.0)));
+}
+
+#[test]
+fn a_window_with_a_largest_size_keeps_its_own_size_after_fullscreen() {
+    let mut f = Fixture::new();
+    f.client.create_window_with_largest_size((200, 150));
+    f.round_trip();
+    f.client.setup_window_of_one_colour((200, 150), WHITE);
+    f.round_trip();
+    f.round_trip();
+    assert_eq!(f.client.told_to_last_window().2, false);
+    f.client.ask_for_fullscreen(true);
+    f.round_trip();
+    assert!(f.client.told_to_last_window().2);
+    f.client.ack_and_commit();
+    f.round_trip();
+    f.client.ask_for_fullscreen(false);
+    f.round_trip();
+    let (size, _, fills) = f.client.told_to_last_window();
+    assert_eq!((size, fills), ((0, 0), false));
+}
+
+#[test]
+fn ctrl_shift_tab_does_not_reach_the_compositors_own_key_with_a_us_keymap() {
+    use smithay::backend::input::KeyState;
+    // The compositor has a key of its own on Ctrl+Shift+Tab (it gives the keyboard to the
+    // window on top). With Shift the key is ISO_Left_Tab, not Tab, so the filter does not
+    // take it, and the keyboard stays where it is.
+    let mut f = fixture();
+    open_a_second_window(&mut f, (120, 80));
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    click(&mut f);
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    let key = |f: &mut Fixture, code: u32, state: KeyState| {
+        let keycode = f.server.scancode_to_keycode(code);
+        f.server.keyboard_input(0, keycode, state);
+    };
+    for code in [29, 42, 15] {
+        key(&mut f, code, KeyState::Pressed);
+    }
+    for code in [15, 42, 29] {
+        key(&mut f, code, KeyState::Released);
+    }
+    f.round_trip();
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    assert!(f.client.told_active(0));
+}
