+/// Marks a window without a parent that came while another filled the output: it was not
+/// made as large as the output, and is not made so when it leaves fullscreen.
+pub struct KeepsItsOwnSize;
+
+/// Marks a window that was shown before it had a size (it committed without a picture
+/// first): it is placed again when it has one.
+struct PlacedWithoutASize(std::cell::Cell<bool>);
+
+/// Remembers that `window` is being placed without a size, if it has none.
+pub fn placing(window: &smithay::desktop::Window) {
+    if window.geometry().size.is_empty() {
+        window
+            .user_data()
+            .insert_if_missing(|| PlacedWithoutASize(std::cell::Cell::new(true)));
+    }
+}
+
+/// Whether `window` was placed without a size and has one now: true once.
+pub fn to_be_placed_again(window: &smithay::desktop::Window) -> bool {
+    let Some(mark) = window.user_data().get::<PlacedWithoutASize>() else {
+        return false;
+    };
+    let again = mark.0.get() && !window.geometry().size.is_empty();
+    if again {
+        mark.0.set(false);
+    }
+    again
+}
