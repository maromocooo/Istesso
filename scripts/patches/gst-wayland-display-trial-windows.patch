+impl<C: PartialEq> InputSerials<C> {
+    /// A key or a button event with this serial went to `client` (or to no client) now.
+    pub fn input(&mut self, serial: smithay::utils::Serial, client: Option<C>) {
+        self.input_at(serial, client, std::time::Instant::now());
+    }
+
+    fn input_at(
+        &mut self,
+        serial: smithay::utils::Serial,
+        client: Option<C>,
+        at: std::time::Instant,
+    ) {
+        if self.0.len() == EVENTS_KEPT {
+            self.0.pop_front();
+        }
+        self.0.push_back((serial, client, at));
+    }
+
+    /// Whether `serial` is one of the last key or button events, went to `client`, and is
+    /// recent.
+    pub fn is_recent_for(&self, serial: smithay::utils::Serial, client: &C) -> bool {
+        self.is_recent_for_at(serial, client, std::time::Instant::now())
+    }
+
+    fn is_recent_for_at(
+        &self,
+        serial: smithay::utils::Serial,
+        client: &C,
+        now: std::time::Instant,
+    ) -> bool {
+        self.0.iter().any(|(s, to, at)| {
+            *s == serial
+                && to.as_ref() == Some(client)
+                && now.saturating_duration_since(*at) <= RECENT
+        })
+    }
