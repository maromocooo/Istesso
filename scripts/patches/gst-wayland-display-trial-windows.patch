+#[test]
+fn a_window_of_another_application_goes_below_the_one_in_use_without_the_keyboard_marked() {
+    let mut f = fixture();
+    let told: std::sync::Arc<std::sync::Mutex<Vec<(usize, usize)>>> = Default::default();
+    {
+        let told = told.clone();
+        f.server
+            .set_window_sink(Some(Box::new(move |windows, attention| {
+                told.lock().unwrap().push((windows, attention))
+            })));
+    }
+    let in_use = f.server.space.elements().next().cloned().unwrap();
+    // A second application maps a window while the first has the keyboard.
+    let mut other = f.another_client();
+    other.create_window();
+    f.round_trip_with(&mut other);
+    other.setup_window_of_one_colour((120, 80), WHITE);
+    f.round_trip_with(&mut other);
+    f.round_trip_with(&mut other);
+    let stack: Vec<_> = f.server.space.elements().cloned().collect();
+    assert_eq!(stack.len(), 2);
+    let theirs = stack[0].clone();
+    // It lies below the window in use, so that it catches no click meant for that one,
+    // without the keyboard, never told it is active, and marked; the mark is told with the
+    // windows.
+    assert_eq!(stack[1], in_use);
+    assert_eq!(keyboard_in(&f, &in_use), (true, false));
+    assert!(!other.told_active(0));
+    assert!(f.client.told_active(0));
+    assert!(crate::comp::windows::wants_attention(&theirs));
+    assert_eq!(told.lock().unwrap().last(), Some(&(2, 1)));
+    // A click goes to the window in use.
+    click(&mut f);
+    assert_eq!(f.client.pointer_and_buttons().1, vec![2]);
+    assert_eq!(keyboard_in(&f, &in_use), (true, false));
+    // When the application in use has no window left, the marked window has the keyboard,
+    // and the mark goes.
+    f.client.close_window();
+    f.round_trip();
+    f.round_trip_with(&mut other);
+    assert_eq!(keyboard_in(&f, &theirs), (true, false));
+    assert!(other.told_active(0));
+    assert!(!crate::comp::windows::wants_attention(&theirs));
+    assert_eq!(told.lock().unwrap().last(), Some(&(1, 0)));
+}
