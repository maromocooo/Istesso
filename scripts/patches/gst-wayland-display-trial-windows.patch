diff --git a/wayland-display-core/src/wayland/handlers/xdg_activation.rs b/wayland-display-core/src/wayland/handlers/xdg_activation.rs
new file mode 100644
index 0000000..905fd53
--- /dev/null
+++ b/wayland-display-core/src/wayland/handlers/xdg_activation.rs
@@ -0,0 +1,118 @@
+use smithay::{
+    delegate_xdg_activation,
+    input::Seat,
+    reexports::wayland_server::{Resource, protocol::wl_surface::WlSurface},
+    wayland::{
+        seat::WaylandFocus,
+        xdg_activation::{
+            XdgActivationHandler, XdgActivationState, XdgActivationToken, XdgActivationTokenData,
+        },
+    },
+};
+
+use crate::comp::State;
+
+/// How long a token is good for: an application asks for a window to come forward right
+/// after a person did something in it (a click on a link, a menu item).
+const TOKEN_LIFETIME_S: u64 = 10;
+
+/// How many unused tokens one client may hold.
+const TOKENS_PER_CLIENT: usize = 32;
+
+impl State {
+    /// Lets go of the tokens that are older than their lifetime.
+    fn let_old_tokens_go(&mut self) {
+        self.activation_state
+            .retain_tokens(|_, data| data.timestamp.elapsed().as_secs() < TOKEN_LIFETIME_S);
+    }
+}
+
+impl XdgActivationHandler for State {
+    fn activation_state(&mut self) -> &mut XdgActivationState {
+        &mut self.activation_state
+    }
+
+    /// A token is kept (whether a request with it is followed is decided when it comes),
+    /// unless its client holds as many unused tokens as it may already. A request with a
+    /// token that was not kept, or has been let go, never reaches this handler: Smithay
+    /// drops it.
+    fn token_created(&mut self, _token: XdgActivationToken, data: XdgActivationTokenData) -> bool {
+        self.let_old_tokens_go();
+        let held = self
+            .activation_state
+            .tokens()
+            .filter(|(_, held)| held.client_id == data.client_id)
+            .count();
+        held < TOKENS_PER_CLIENT
+    }
+
+    /// The request is followed (the window comes forward with its dialogs and has the
+    /// keyboard) only when all of this holds; otherwise nothing moves, and the window is only
+    /// marked as wanting attention (unless it has the keyboard already):
+    ///
+    /// * the token is not older than its lifetime, and has not been used;
+    /// * the client that made the token has the keyboard now (one of its windows has it);
+    /// * the window to come forward is that client's own: a token handed to another
+    ///   process (a link opened in a browser started from it) does not move the keyboard;
+    /// * the token names the serial of a recent key or button event on this seat, and that
+    ///   event went to the same client.
+    fn request_activation(
+        &mut self,
+        token: XdgActivationToken,
+        token_data: XdgActivationTokenData,
+        surface: WlSurface,
+    ) {
+        // A token is used once, whatever comes of the request.
+        self.activation_state.remove_token(&token);
+        self.let_old_tokens_go();
+        let shown = self
+            .space
+            .elements()
+            .find(|w| w.wl_surface().is_some_and(|s| *s == surface))
+            .cloned();
+        // A window that is not shown yet is not remembered: the request is dropped. (A window
+        // that comes takes the keyboard when it may anyway.)
+        let Some(window) = shown else {
+            return;
+        };
+        if self.may_activate(&token_data, &surface) {
+            self.activate_window(&window);
+        } else {
+            let has_the_keyboard = self
+                .keyboard_holder
+                .as_ref()
+                .is_some_and(|(holder, _)| *holder == surface);
+            if !has_the_keyboard {
+                self.mark_wants_attention(&window, true);
+            }
+        }
+    }
+}
+
+impl State {
+    /// Whether a request with this token, for this surface, comes from the application a
+    /// person is using, as the answer to something the person did in it (see
+    /// `request_activation` above).
+    fn may_activate(&self, data: &XdgActivationTokenData, surface: &WlSurface) -> bool {
+        if data.timestamp.elapsed().as_secs() >= TOKEN_LIFETIME_S {
+            return false;
+        }
+        let Some(maker) = data.client_id.as_ref() else {
+            return false;
+        };
+        if surface.client().map(|c| c.id()).as_ref() != Some(maker) {
+            return false;
+        }
+        let keyboard = self.keyboard_holder.as_ref().and_then(|(_, c)| c.as_ref());
+        if keyboard != Some(maker) {
+            return false;
+        }
+        let Some((serial, seat)) = &data.serial else {
+            return false;
+        };
+        Seat::<State>::from_resource(seat).is_some_and(|s| s == self.seat)
+            && self.input_serials.is_recent_for(*serial, maker)
+    }
+}
+
+delegate_xdg_activation!(State);
