+++ b/wayland-display-core/src/wayland/handlers/cursor_shape.rs
@@ -0,0 +1,14 @@
+//! Clients that name the shape of their cursor (`wp_cursor_shape_manager_v1`) instead of
+//! handing in an image of it. Smithay does the work and calls `SeatHandler::cursor_image`
+//! with the name, as it does with a client's image. The global is made in
+//! `State::set_cursor_sink`, the first time somebody is told about the cursor, and not before.
+
+use smithay::{delegate_cursor_shape, wayland::tablet_manager::TabletSeatHandler};
+
+use crate::comp::State;
+
+/// The protocol also covers the tools of a drawing tablet, so the delegate asks for this.
+/// There is no tablet here: nothing announces one, and the cursor of one is ignored.
+impl TabletSeatHandler for State {}
+
+delegate_cursor_shape!(State);
