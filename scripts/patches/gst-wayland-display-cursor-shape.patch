diff --git a/wayland-display-core/src/tests/test_cursor_shape.rs b/wayland-display-core/src/tests/test_cursor_shape.rs
new file mode 100644
index 0000000..1a3198b
--- /dev/null
+++ b/wayland-display-core/src/tests/test_cursor_shape.rs
@@ -0,0 +1,127 @@
+//! Integration tests for clients that name the shape of their cursor
+//! (`wp_cursor_shape_manager_v1`). The compositor offers that only from the first time
+//! somebody is told about the cursor (see `State::set_cursor_sink`); whoever is told then
+//! hears the name. A real Wayland client names the shapes.
+
+use crate::comp::cursor::{Cursor, CursorSink};
+use crate::tests::fixture::Fixture;
+use smithay::utils::Point;
+use std::sync::{Arc, Mutex};
+use test_log::test;
+use wayland_protocols::wp::cursor_shape::v1::client::wp_cursor_shape_device_v1::Shape;
+
+type Told = Arc<Mutex<Vec<Cursor>>>;
+
+/// A window under the pointer, and nobody who is told about the cursor.
+fn fixture() -> Fixture {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    f
+}
+
+fn listen(f: &mut Fixture) -> Told {
+    let told = Told::default();
+    let sink: CursorSink = {
+        let told = told.clone();
+        Box::new(move |cursor| told.lock().unwrap().push(cursor.clone()))
+    };
+    f.server.set_cursor_sink(Some(sink));
+    // The client hears of the new global.
+    f.round_trip();
+    told
+}
+
+fn last(told: &Told) -> Cursor {
+    told.lock().unwrap().last().cloned().expect("nothing told")
+}
+
+#[test]
+fn a_shape_a_client_names_is_told_by_its_name() {
+    let mut f = fixture();
+    let told = listen(&mut f);
+    assert!(f.client.can_name_cursor_shapes());
+    for (shape, name) in [
+        (Shape::Text, "text"),
+        (Shape::Pointer, "pointer"),
+        (Shape::NwseResize, "nwse-resize"),
+        (Shape::ColResize, "col-resize"),
+        (Shape::Grabbing, "grabbing"),
+        (Shape::Default, "default"),
+    ] {
+        f.client.set_cursor_shape(shape);
+        f.round_trip();
+        assert_eq!(last(&told), Cursor::Named(name.into()));
+    }
+}
+
+#[test]
+fn the_same_shape_is_not_told_twice_and_an_image_and_a_name_follow_each_other() {
+    let mut f = fixture();
+    let told = listen(&mut f);
+    f.client.set_cursor_shape(Shape::Text);
+    f.round_trip();
+    let after_the_first = told.lock().unwrap().len();
+    // Again, as a toolkit does on every motion.
+    f.client.set_cursor_shape(Shape::Text);
+    f.round_trip();
+    assert_eq!(told.lock().unwrap().len(), after_the_first);
+
+    // The same client hands in an image, hides the cursor, and names a shape again.
+    f.client.set_cursor((16, 16), (2, 3), [0, 0, 255, 255]);
+    f.round_trip();
+    assert!(matches!(last(&told), Cursor::Image(_)));
+    f.client.hide_cursor();
+    f.round_trip();
+    assert_eq!(last(&told), Cursor::Hidden);
+    f.client.set_cursor_shape(Shape::Pointer);
+    f.round_trip();
+    assert_eq!(last(&told), Cursor::Named("pointer".into()));
+}
+
+#[test]
+fn no_client_can_name_a_shape_unless_somebody_is_told_about_the_cursor() {
+    let mut f = fixture();
+    // The cursor is drawn into the frames: the global is not among those the client was
+    // told of, and the compositor has not made it.
+    assert!(!f.client.can_name_cursor_shapes());
+    assert!(f.server.cursor_shape_state.is_none());
+    // Taking away a sink that was never there changes nothing.
+    f.server.set_cursor_sink(None);
+    f.round_trip();
+    assert!(!f.client.can_name_cursor_shapes());
+    assert!(f.server.cursor_shape_state.is_none());
+    // A client's image is still its cursor, in the frames as before.
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    assert!(f.server.create_frame().is_ok());
+}
+
+#[test]
+fn the_global_is_made_once_and_stays_when_nobody_listens_any_more() {
+    let mut f = fixture();
+    let told = listen(&mut f);
+    let global = f.server.cursor_shape_state.as_ref().unwrap().global();
+    f.client.set_cursor_shape(Shape::Text);
+    f.round_trip();
+    assert_eq!(last(&told), Cursor::Named("text".into()));
+    let heard = told.lock().unwrap().len();
+
+    // Nobody listens: the client may go on naming shapes, nobody is told, and the frames are
+    // made with the cursor in them.
+    f.server.set_cursor_sink(None);
+    f.client.set_cursor_shape(Shape::Pointer);
+    f.round_trip();
+    assert_eq!(told.lock().unwrap().len(), heard);
+    assert!(f.server.create_frame().is_ok());
+
+    // Somebody listens again: the same global, and the cursor as it is by now.
+    let again = listen(&mut f);
+    assert_eq!(
+        f.server.cursor_shape_state.as_ref().unwrap().global(),
+        global
+    );
+    assert_eq!(*again.lock().unwrap(), [Cursor::Named("pointer".into())]);
+}
