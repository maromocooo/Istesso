index 0000000..2a80da1
--- /dev/null
+++ b/wayland-display-core/src/comp/clipboard.rs
@@ -0,0 +1,834 @@
+//! Trial only: copy and paste of text between the device a person types on and the client that
+//! has the keyboard (Istesso's ADR 0022). Off unless `ISTESSO_CLIPBOARD_DIR` names the folder of
+//! the session's local sockets (the one that holds `input.sock`, open to its owner only).
+//!
+//! * The agent sends datagrams to `clipboard.sock` there (bound here): `hello` (answered at
+//!   once, so that the agent knows that copy and paste are taken) and the text of a paste,
+//!   before the mark that orders it.
+//! * The marks come on the path of the keys, as the upstream events `ClipboardCopy` and
+//!   `ClipboardPaste`, so that a copy or a paste takes its place among the keys. They carry no
+//!   text.
+//! * Answers go as datagrams to `clipboard-answer.sock` there (bound by the agent).
+//!
+//! A copy presses Control-C (Control-X to cut) for the client that has the keyboard and takes
+//! the selection that client sets next, read with a deadline and never by stopping the loop. A
+//! paste holds the input that follows its mark until its text is there, makes the compositor
+//! the owner of the selection with that text, and presses Control-V. Only the clipboard: the
+//! primary selection is never read or set. The text, its size and the nonces are never logged:
+//! only how many of each answer there were.
+
+use std::collections::VecDeque;
+use std::os::fd::{AsFd, OwnedFd};
+use std::os::unix::net::UnixDatagram;
+use std::path::{Path, PathBuf};
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use smithay::backend::input::KeyState;
+use smithay::reexports::calloop::{
+    Interest, Mode, PostAction, RegistrationToken,
+    generic::Generic,
+    timer::{TimeoutAction, Timer},
+};
+use smithay::reexports::rustix;
+use smithay::reexports::wayland_server::backend::ClientId;
+use smithay::wayland::selection::SelectionSource;
+use smithay::wayland::selection::data_device::{
+    clear_data_device_selection, current_data_device_selection_userdata,
+    request_data_device_client_selection, set_data_device_selection,
+};
+
+use super::{Command, State, client_of_focus};
+
+/// The most bytes (UTF-8) of text a copy or a paste carries (ADR 0022).
+pub const MOST_BYTES: usize = 65536;
+/// How long a copy waits for the selection, from pressing the key to the last byte read.
+pub const COPY_WITHIN: Duration = Duration::from_millis(500);
+/// How long a paste holds the input after it for its text to arrive.
+pub const HOLD_AT_MOST: Duration = Duration::from_millis(200);
+/// How long the text of a paste is kept for its mark.
+const TEXT_KEPT_FOR: Duration = Duration::from_secs(2);
+/// How many texts of pastes are kept at once.
+const TEXTS_KEPT: usize = 4;
+/// How long a client may take to read the selection the compositor offers.
+const SERVE_WITHIN: Duration = Duration::from_secs(2);
+/// The sockets' buffers: a datagram carries up to twice the text (JSON escapes).
+const SOCKET_BUFFER: usize = 256 * 1024;
+const RECEIVE_AT_MOST: usize = 192 * 1024;
+
+const KEY_LEFTCTRL: u32 = 29;
+const KEY_X: u32 = 45;
+const KEY_C: u32 = 46;
+const KEY_V: u32 = 47;
+
+/// The kinds of text a copy takes, in order of preference, and what a paste offers.
+const TEXT_TYPES: [&str; 3] = ["text/plain;charset=utf-8", "UTF8_STRING", "text/plain"];
+const OFFERED_TYPES: [&str; 5] = [
+    "text/plain;charset=utf-8",
+    "UTF8_STRING",
+    "text/plain",
+    "TEXT",
+    "STRING",
+];
+/// What a password manager puts on a selection that is a secret (KDE's convention).
+const SECRET_TYPE: &str = "x-kde-passwordManagerHint";
+
+/// What became of a copy or a paste.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Outcome {
+    Text,
+    Pasted,
+    Nothing,
+    Refused(Why),
+    TooLarge,
+    NotText,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Why {
+    PasswordField,
+    SecretMarker,
+}
+
+impl Outcome {
+    fn word(self) -> &'static str {
+        match self {
+            Outcome::Text => "text",
+            Outcome::Pasted => "pasted",
+            Outcome::Nothing => "none",
+            Outcome::Refused(_) => "refused",
+            Outcome::TooLarge => "too_large",
+            Outcome::NotText => "not_text",
+        }
+    }
+}
+
+/// Whether `bytes` may be carried as text: within the limit, UTF-8, not empty, and without
+/// control characters other than tab, line feed and carriage return.
+pub fn judge(bytes: &[u8]) -> Result<&str, Outcome> {
+    if bytes.len() > MOST_BYTES {
+        return Err(Outcome::TooLarge);
+    }
+    let text = std::str::from_utf8(bytes).map_err(|_| Outcome::NotText)?;
+    let allowed = |c: char| !c.is_control() || matches!(c, '\t' | '\n' | '\r');
+    if text.is_empty() || !text.chars().all(allowed) {
+        return Err(Outcome::NotText);
+    }
+    Ok(text)
+}
+
+/// The selection the compositor owns: the text of the last paste.
+pub type Offered = Arc<String>;
+
+struct PendingCopy {
+    nonce: String,
+    client: Option<ClientId>,
+    deadline: Instant,
+    /// What has been read of the selection, once it is being read.
+    read: Option<Vec<u8>>,
+    reading: Option<RegistrationToken>,
+    number: u64,
+}
+
+struct Hold {
+    nonce: String,
+    number: u64,
+}
+
+/// The input commands that wait while a paste waits for its text.
+pub(crate) fn is_input(command: &Command) -> bool {
+    matches!(
+        command,
+        Command::KeyboardInput(..)
+            | Command::PointerMotion(_)
+            | Command::PointerMotionAbsolute(_)
+            | Command::PointerButton(..)
+            | Command::PointerAxis(..)
+            | Command::TextCommit(_)
+            | Command::TextPreedit(..)
+            | Command::ClipboardCopy { .. }
+            | Command::ClipboardPaste { .. }
+    )
+}
+
+#[derive(Default)]
+pub struct Clipboard {
+    on: bool,
+    answers: Option<PathBuf>,
+    sender: Option<UnixDatagram>,
+    texts: Vec<(String, String, Instant)>,
+    copy: Option<PendingCopy>,
+    hold: Option<Hold>,
+    pub(crate) held: VecDeque<Command>,
+    next: u64,
+    counts: std::collections::BTreeMap<&'static str, u64>,
+}
+
+impl Clipboard {
+    pub fn holding(&self) -> bool {
+        self.hold.is_some()
+    }
+
+    fn number(&mut self) -> u64 {
+        self.next += 1;
+        self.next
+    }
+
+    fn take_text(&mut self, nonce: &str) -> Option<String> {
+        let now = Instant::now();
+        self.texts
+            .retain(|(_, _, at)| now.saturating_duration_since(*at) < TEXT_KEPT_FOR);
+        let place = self.texts.iter().position(|(n, _, _)| n == nonce)?;
+        Some(self.texts.remove(place).1)
+    }
+
+    fn send(&mut self, line: &str) {
+        let (Some(sender), Some(to)) = (&self.sender, &self.answers) else {
+            return;
+        };
+        if sender.send_to(line.as_bytes(), to).is_err() {
+            *self.counts.entry("not delivered").or_default() += 1;
+        }
+    }
+
+    fn answer(&mut self, nonce: &str, outcome: Outcome, text: Option<&str>) {
+        let mut line = format!(
+            r#"{{"kind":"answer","nonce":{},"result":"{}""#,
+            quote(nonce),
+            outcome.word()
+        );
+        if let (Outcome::Text, Some(text)) = (outcome, text) {
+            line.push_str(&format!(r#","text":{}"#, quote(text)));
+        }
+        if let Outcome::Refused(why) = outcome {
+            line.push_str(match why {
+                Why::PasswordField => r#","why":"password_field""#,
+                Why::SecretMarker => r#","why":"secret_marker""#,
+            });
+        }
+        line.push('}');
+        self.send(&line);
+        let count = self.counts.entry(outcome.word()).or_default();
+        *count += 1;
+        // How many, never what (nor how long, nor the nonce).
+        tracing::info!(so_far = *count, "clipboard: answered {}", outcome.word());
+    }
+}
+
+impl State {
+    /// Turns copy and paste on, with the local sockets in `dir` (see the module's text).
+    pub fn enable_clipboard(&mut self, dir: &Path) -> std::io::Result<()> {
+        use std::os::unix::fs::PermissionsExt;
+        let path = dir.join("clipboard.sock");
+        match std::fs::remove_file(&path) {
+            Ok(()) => {}
+            Err(e) if e.kind() == std::io::ErrorKind::NotFound => {}
+            Err(e) => return Err(e),
+        }
+        let socket = UnixDatagram::bind(&path)?;
+        std::fs::set_permissions(&path, std::fs::Permissions::from_mode(0o600))?;
+        socket.set_nonblocking(true)?;
+        let _ = rustix::net::sockopt::set_socket_recv_buffer_size(&socket, SOCKET_BUFFER);
+        let sender = UnixDatagram::unbound()?;
+        sender.set_nonblocking(true)?;
+        let _ = rustix::net::sockopt::set_socket_send_buffer_size(&sender, SOCKET_BUFFER);
+        self.handle
+            .insert_source(
+                Generic::new(socket, Interest::READ, Mode::Level),
+                |_, socket, state| {
+                    let mut buffer = vec![0u8; RECEIVE_AT_MOST];
+                    loop {
+                        match socket.recv(&mut buffer) {
+                            Ok(length) => state.clipboard_datagram(&buffer[..length]),
+                            Err(e) if e.kind() == std::io::ErrorKind::WouldBlock => break,
+                            Err(_) => break,
+                        }
+                    }
+                    Ok(PostAction::Continue)
+                },
+            )
+            .map_err(|e| std::io::Error::other(e.to_string()))?;
+        self.clipboard.on = true;
+        self.clipboard.answers = Some(dir.join("clipboard-answer.sock"));
+        self.clipboard.sender = Some(sender);
+        tracing::info!("clipboard: copy and paste are taken (trial)");
+        Ok(())
+    }
+
+    /// A datagram from the agent on `clipboard.sock`.
+    fn clipboard_datagram(&mut self, bytes: &[u8]) {
+        let Some(fields) = parse_flat(bytes) else {
+            return;
+        };
+        let get = |key: &str| {
+            fields
+                .iter()
+                .find(|(k, _)| k == key)
+                .and_then(|(_, v)| match v {
+                    Value::Text(s) => Some(s.clone()),
+                    _ => None,
+                })
+        };
+        let (Some(kind), Some(nonce)) = (get("kind"), get("nonce")) else {
+            return;
+        };
+        match kind.as_str() {
+            "hello" => self
+                .clipboard
+                .send(&format!(r#"{{"kind":"hello","nonce":{}}}"#, quote(&nonce))),
+            "paste_text" => {
+                let Some(text) = get("text") else { return };
+                let clipboard = &mut self.clipboard;
+                if clipboard.texts.len() >= TEXTS_KEPT {
+                    clipboard.texts.remove(0);
+                }
+                clipboard.texts.push((nonce.clone(), text, Instant::now()));
+                // A paste that holds the input for this text goes on now.
+                if clipboard.hold.as_ref().is_some_and(|h| h.nonce == nonce) {
+                    self.clipboard.hold = None;
+                    self.paste_now(&nonce);
+                    self.release_held();
+                }
+            }
+            _ => {}
+        }
+    }
+
+    /// Takes an input command, or holds it while a paste waits for its text. Commands that are
+    /// not input come back.
+    pub(crate) fn take_input(&mut self, command: Command) -> Option<Command> {
+        if !is_input(&command) {
+            return Some(command);
+        }
+        if self.clipboard.holding() {
+            self.clipboard.held.push_back(command);
+            return None;
+        }
+        self.apply_input(command);
+        None
+    }
+
+    /// Passes on what was held, in order, until a paste in it holds again.
+    fn release_held(&mut self) {
+        while !self.clipboard.holding() {
+            let Some(command) = self.clipboard.held.pop_front() else {
+                break;
+            };
+            self.apply_input(command);
+        }
+    }
+
+    fn apply_input(&mut self, command: Command) {
+        use smithay::backend::input::AxisSource;
+        let time: Duration = self.clock.now().into();
+        match command {
+            Command::KeyboardInput(scancode, key_state) => {
+                let keycode = self.scancode_to_keycode(scancode);
+                self.keyboard_input(time.as_millis() as u32, keycode, key_state);
+            }
+            Command::PointerMotion(position) => {
+                self.pointer_motion(
+                    time.as_millis() as u32,
+                    time.as_nanos() as u64,
+                    position,
+                    position,
+                );
+                super::pointer_moved(self);
+            }
+            Command::PointerMotionAbsolute(position) => {
+                self.pointer_motion_absolute(time.as_millis() as u32, position);
+                super::pointer_moved(self);
+            }
+            Command::PointerButton(btn_code, btn_state) => {
+                self.pointer_button(time.as_millis() as u32, btn_code, btn_state);
+            }
+            Command::PointerAxis(horizontal_amount, vertical_amount) => {
+                self.pointer_axis(
+                    time.as_millis() as u32,
+                    AxisSource::Wheel,
+                    horizontal_amount * 3.0 / 120.0,
+                    vertical_amount * 3.0 / 120.0,
+                    Some(horizontal_amount),
+                    Some(vertical_amount),
+                );
+            }
+            Command::TextCommit(text) => self.commit_text(&text),
+            Command::TextPreedit(text, begin, end) => self.preedit_text(&text, begin, end),
+            Command::ClipboardCopy { nonce, cut } => self.clipboard_copy(nonce, cut),
+            Command::ClipboardPaste { nonce, with_text } => self.clipboard_paste(nonce, with_text),
+            _ => {}
+        }
+    }
+
+    /// Presses `key` with Control for the client that has the keyboard, and lets go of both:
+    /// Control only when it is not held already (a Command key arrives as Control).
+    fn press_with_control(&mut self, key: u32) {
+        let keyboard = self.seat.get_keyboard().unwrap();
+        let held = keyboard.modifier_state().ctrl;
+        let time = Duration::from(self.clock.now()).as_millis() as u32;
+        let control = self.scancode_to_keycode(KEY_LEFTCTRL);
+        let key = self.scancode_to_keycode(key);
+        if !held {
+            self.keyboard_input(time, control, KeyState::Pressed);
+        }
+        self.keyboard_input(time, key, KeyState::Pressed);
+        self.keyboard_input(time, key, KeyState::Released);
+        if !held {
+            self.keyboard_input(time, control, KeyState::Released);
+        }
+    }
+
+    fn focused_client(&self) -> Option<ClientId> {
+        let keyboard = self.seat.get_keyboard().unwrap();
+        client_of_focus(keyboard.current_focus().as_ref())
+    }
+
+    fn clipboard_copy(&mut self, nonce: String, cut: bool) {
+        if !self.clipboard.on {
+            return;
+        }
+        // One copy at a time: one that is still waiting has nothing.
+        if let Some(earlier) = self.clipboard.copy.take() {
+            if let Some(token) = earlier.reading {
+                self.handle.remove(token);
+            }
+            self.clipboard
+                .answer(&earlier.nonce, Outcome::Nothing, None);
+        }
+        let Some(client) = self.focused_client() else {
+            self.clipboard.answer(&nonce, Outcome::Nothing, None);
+            return;
+        };
+        if self.text_inputs.focused_is_secret() {
+            // Nothing is pressed.
+            self.clipboard
+                .answer(&nonce, Outcome::Refused(Why::PasswordField), None);
+            return;
+        }
+        let number = self.clipboard.number();
+        self.clipboard.copy = Some(PendingCopy {
+            nonce,
+            client: Some(client),
+            deadline: Instant::now() + COPY_WITHIN,
+            read: None,
+            reading: None,
+            number,
+        });
+        self.press_with_control(if cut { KEY_X } else { KEY_C });
+        let _ = self
+            .handle
+            .insert_source(Timer::from_duration(COPY_WITHIN), move |_, _, state| {
+                state.copy_over(number, None);
+                TimeoutAction::Drop
+            });
+    }
+
+    /// The copy numbered `number` is over: with what was read (`None`: nothing in time).
+    fn copy_over(&mut self, number: u64, outcome: Option<Result<String, Outcome>>) {
+        if self.clipboard.copy.as_ref().map(|c| c.number) != Some(number) {
+            return;
+        }
+        let copy = self.clipboard.copy.take().unwrap();
+        if let Some(token) = copy.reading {
+            self.handle.remove(token);
+        }
+        match outcome {
+            Some(Ok(text)) => self
+                .clipboard
+                .answer(&copy.nonce, Outcome::Text, Some(&text)),
+            Some(Err(outcome)) => self.clipboard.answer(&copy.nonce, outcome, None),
+            None => self.clipboard.answer(&copy.nonce, Outcome::Nothing, None),
+        }
+    }
+
+    /// A client set the clipboard's selection (Smithay lets only the client with the keyboard).
+    pub(crate) fn clipboard_selection_set(&mut self, source: Option<&SelectionSource>) {
+        let Some(source) = source else { return };
+        let focused = self.focused_client();
+        let Some(copy) = self.clipboard.copy.as_mut() else {
+            return;
+        };
+        if copy.read.is_some() || focused.is_none() || copy.client != focused {
+            return;
+        }
+        let number = copy.number;
+        let types = source.mime_types();
+        if types.iter().any(|t| t == SECRET_TYPE) {
+            self.copy_over(number, Some(Err(Outcome::Refused(Why::SecretMarker))));
+            return;
+        }
+        let Some(kind) = TEXT_TYPES
+            .iter()
+            .find(|t| types.iter().any(|have| have == *t))
+            .map(|t| t.to_string())
+        else {
+            self.copy_over(number, Some(Err(Outcome::Nothing)));
+            return;
+        };
+        copy.read = Some(Vec::new());
+        // The selection is the seat's only after this callback: it is asked for at once after.
+        self.handle
+            .insert_idle(move |state| state.read_copied(number, kind));
+    }
+
+    fn read_copied(&mut self, number: u64, kind: String) {
+        use rustix::fs::{OFlags, fcntl_setfl};
+        use rustix::pipe::{PipeFlags, pipe_with};
+        if self.clipboard.copy.as_ref().map(|c| c.number) != Some(number) {
+            return;
+        }
+        let Ok((reader, writer)) = pipe_with(PipeFlags::CLOEXEC) else {
+            self.copy_over(number, Some(Err(Outcome::Nothing)));
+            return;
+        };
+        // Only this end: the other is the client's.
+        if fcntl_setfl(&reader, OFlags::NONBLOCK).is_err() {
+            self.copy_over(number, Some(Err(Outcome::Nothing)));
+            return;
+        }
+        let seat = self.seat.clone();
+        if request_data_device_client_selection(&seat, kind, writer).is_err() {
+            self.copy_over(number, Some(Err(Outcome::Nothing)));
+            return;
+        }
+        let token = self.handle.insert_source(
+            Generic::new(reader, Interest::READ, Mode::Level),
+            move |_, reader, state| Ok(state.copied_readable(number, reader.as_fd())),
+        );
+        match token {
+            Ok(token) => {
+                if let Some(copy) = self.clipboard.copy.as_mut() {
+                    copy.reading = Some(token);
+                }
+            }
+            Err(_) => self.copy_over(number, Some(Err(Outcome::Nothing))),
+        }
+    }
+
+    fn copied_readable(&mut self, number: u64, reader: std::os::fd::BorrowedFd<'_>) -> PostAction {
+        let mut chunk = [0u8; 16384];
+        loop {
+            let Some(copy) = self.clipboard.copy.as_mut().filter(|c| c.number == number) else {
+                return PostAction::Remove;
+            };
+            if Instant::now() >= copy.deadline {
+                copy.reading = None;
+                self.copy_over(number, None);
+                return PostAction::Remove;
+            }
+            match rustix::io::read(reader, &mut chunk) {
+                Ok(0) => {
+                    copy.reading = None;
+                    let read = copy.read.take().unwrap_or_default();
+                    let outcome = judge(&read).map(str::to_string);
+                    self.copy_over(number, Some(outcome));
+                    return PostAction::Remove;
+                }
+                Ok(n) => {
+                    let read = copy.read.get_or_insert_with(Vec::new);
+                    read.extend_from_slice(&chunk[..n]);
+                    if read.len() > MOST_BYTES {
+                        copy.reading = None;
+                        self.copy_over(number, Some(Err(Outcome::TooLarge)));
+                        return PostAction::Remove;
+                    }
+                }
+                Err(rustix::io::Errno::AGAIN) => return PostAction::Continue,
+                Err(rustix::io::Errno::INTR) => {}
+                Err(_) => {
+                    copy.reading = None;
+                    self.copy_over(number, Some(Err(Outcome::Nothing)));
+                    return PostAction::Remove;
+                }
+            }
+        }
+    }
+
+    fn clipboard_paste(&mut self, nonce: String, with_text: bool) {
+        if !self.clipboard.on {
+            return;
+        }
+        if !with_text {
+            // The text of an earlier paste is not pasted again: only what the client has.
+            let seat = self.seat.clone();
+            let ours = current_data_device_selection_userdata(&seat).is_some();
+            if ours {
+                clear_data_device_selection(&self.dh, &seat);
+            }
+            if self.focused_client().is_none() {
+                self.clipboard.answer(&nonce, Outcome::Nothing, None);
+                return;
+            }
+            self.press_with_control(KEY_V);
+            self.clipboard.answer(&nonce, Outcome::Pasted, None);
+            return;
+        }
+        if self.clipboard.texts.iter().any(|(n, _, _)| *n == nonce) {
+            self.paste_now(&nonce);
+            return;
+        }
+        // The text is on its way: what comes after waits for it.
+        let number = self.clipboard.number();
+        self.clipboard.hold = Some(Hold {
+            nonce: nonce.clone(),
+            number,
+        });
+        let _ =
+            self.handle
+                .insert_source(Timer::from_duration(HOLD_AT_MOST), move |_, _, state| {
+                    if state
+                        .clipboard
+                        .hold
+                        .as_ref()
+                        .is_some_and(|h| h.number == number)
+                    {
+                        state.clipboard.hold = None;
+                        state.clipboard.answer(&nonce, Outcome::Nothing, None);
+                        state.release_held();
+                    }
+                    TimeoutAction::Drop
+                });
+    }
+
+    fn paste_now(&mut self, nonce: &str) {
+        let Some(text) = self.clipboard.take_text(nonce) else {
+            self.clipboard.answer(nonce, Outcome::Nothing, None);
+            return;
+        };
+        if let Err(outcome) = judge(text.as_bytes()) {
+            self.clipboard.answer(nonce, outcome, None);
+            return;
+        }
+        if self.focused_client().is_none() {
+            self.clipboard.answer(nonce, Outcome::Nothing, None);
+            return;
+        }
+        let seat = self.seat.clone();
+        set_data_device_selection(
+            &self.dh,
+            &seat,
+            OFFERED_TYPES.iter().map(|t| t.to_string()).collect(),
+            Some(Arc::new(text)),
+        );
+        self.press_with_control(KEY_V);
+        self.clipboard.answer(nonce, Outcome::Pasted, None);
+    }
+
+    /// A client reads the selection the compositor owns: the text is written without waiting
+    /// for the client, and given up after [`SERVE_WITHIN`].
+    pub(crate) fn serve_selection(&mut self, fd: OwnedFd, text: &Offered) {
+        use rustix::fs::{OFlags, fcntl_setfl};
+        if fcntl_setfl(&fd, OFlags::NONBLOCK).is_err() {
+            return;
+        }
+        let text = text.clone();
+        let mut written = 0usize;
+        let started = Instant::now();
+        let token = self.handle.insert_source(
+            Generic::new(fd, Interest::WRITE, Mode::Level),
+            move |_, fd, _| {
+                loop {
+                    if written >= text.len() || started.elapsed() >= SERVE_WITHIN {
+                        return Ok(PostAction::Remove);
+                    }
+                    match rustix::io::write(fd.as_fd(), &text.as_bytes()[written..]) {
+                        Ok(n) => written += n,
+                        Err(rustix::io::Errno::AGAIN) => return Ok(PostAction::Continue),
+                        Err(rustix::io::Errno::INTR) => {}
+                        Err(_) => return Ok(PostAction::Remove),
+                    }
+                }
+            },
+        );
+        if let Ok(token) = token {
+            let _ = self.handle.insert_source(
+                Timer::from_duration(SERVE_WITHIN),
+                move |_, _, state| {
+                    state.handle.remove(token);
+                    TimeoutAction::Drop
+                },
+            );
+        }
+    }
+}
+
+/// A JSON string, quoted and escaped.
+pub fn quote(text: &str) -> String {
+    let mut out = String::with_capacity(text.len() + 2);
+    out.push('"');
+    for c in text.chars() {
+        match c {
+            '"' => out.push_str("\\\""),
+            '\\' => out.push_str("\\\\"),
+            '\n' => out.push_str("\\n"),
+            '\r' => out.push_str("\\r"),
+            '\t' => out.push_str("\\t"),
+            c if (c as u32) < 0x20 || c == '\u{7f}' => {
+                out.push_str(&format!("\\u{:04x}", c as u32))
+            }
+            c => out.push(c),
+        }
+    }
+    out.push('"');
+    out
+}
+
+#[derive(Debug, Clone, PartialEq)]
+pub enum Value {
+    Text(String),
+    Bool(bool),
+    Other,
+}
+
+/// Reads one flat JSON object (strings, booleans; numbers and null are read and passed over;
+/// nested objects and arrays are not taken). `None` for anything else.
+pub fn parse_flat(bytes: &[u8]) -> Option<Vec<(String, Value)>> {
+    let text = std::str::from_utf8(bytes).ok()?;
+    let mut chars = text.chars().peekable();
+    let mut fields = Vec::new();
+    fn space(chars: &mut std::iter::Peekable<std::str::Chars<'_>>) {
+        while chars.peek().is_some_and(|c| c.is_ascii_whitespace()) {
+            chars.next();
+        }
+    }
+    fn string(chars: &mut std::iter::Peekable<std::str::Chars<'_>>) -> Option<String> {
+        if chars.next()? != '"' {
+            return None;
+        }
+        let mut out = String::new();
+        loop {
+            match chars.next()? {
+                '"' => return Some(out),
+                '\\' => match chars.next()? {
+                    '"' => out.push('"'),
+                    '\\' => out.push('\\'),
+                    '/' => out.push('/'),
+                    'b' => out.push('\u{8}'),
+                    'f' => out.push('\u{c}'),
+                    'n' => out.push('\n'),
+                    'r' => out.push('\r'),
+                    't' => out.push('\t'),
+                    'u' => {
+                        let hex = |chars: &mut std::iter::Peekable<std::str::Chars<'_>>| {
+                            let digits: String = (0..4).filter_map(|_| chars.next()).collect();
+                            (digits.len() == 4)
+                                .then(|| u32::from_str_radix(&digits, 16).ok())
+                                .flatten()
+                        };
+                        let first = hex(chars)?;
+                        let c = if (0xD800..0xDC00).contains(&first) {
+                            if chars.next()? != '\\' || chars.next()? != 'u' {
+                                return None;
+                            }
+                            let second = hex(chars)?;
+                            if !(0xDC00..0xE000).contains(&second) {
+                                return None;
+                            }
+                            char::from_u32(0x10000 + ((first - 0xD800) << 10) + (second - 0xDC00))?
+                        } else {
+                            char::from_u32(first)?
+                        };
+                        out.push(c);
+                    }
+                    _ => return None,
+                },
+                c if (c as u32) < 0x20 => return None,
+                c => out.push(c),
+            }
+        }
+    }
+    space(&mut chars);
+    if chars.next()? != '{' {
+        return None;
+    }
+    space(&mut chars);
+    if chars.peek() == Some(&'}') {
+        chars.next();
+    } else {
+        loop {
+            space(&mut chars);
+            let key = string(&mut chars)?;
+            space(&mut chars);
+            if chars.next()? != ':' {
+                return None;
+            }
+            space(&mut chars);
+            let value = match *chars.peek()? {
+                '"' => Value::Text(string(&mut chars)?),
+                't' | 'f' | 'n' => {
+                    let word: String =
+                        std::iter::from_fn(|| chars.next_if(|c| c.is_ascii_alphabetic())).collect();
+                    match word.as_str() {
+                        "true" => Value::Bool(true),
+                        "false" => Value::Bool(false),
+                        "null" => Value::Other,
+                        _ => return None,
+                    }
+                }
+                c if c == '-' || c.is_ascii_digit() => {
+                    let _: String = std::iter::from_fn(|| {
+                        chars.next_if(|c| c.is_ascii_digit() || "+-.eE".contains(*c))
+                    })
+                    .collect();
+                    Value::Other
+                }
+                _ => return None,
+            };
+            fields.push((key, value));
+            space(&mut chars);
+            match chars.next()? {
+                ',' => continue,
+                '}' => break,
+                _ => return None,
+            }
+        }
+    }
+    space(&mut chars);
+    chars.next().is_none().then_some(fields)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn what_may_be_carried() {
+        assert_eq!(judge(b"two\tlines\r\nof text"), Ok("two\tlines\r\nof text"));
+        assert_eq!(judge("日本語".as_bytes()), Ok("日本語"));
+        assert_eq!(judge(b""), Err(Outcome::NotText));
+        assert_eq!(judge(b"a\x00b"), Err(Outcome::NotText));
+        assert_eq!(judge(b"a\x1bb"), Err(Outcome::NotText));
+        assert_eq!(judge("a\u{85}b".as_bytes()), Err(Outcome::NotText));
+        assert_eq!(judge(&[0xff, 0xfe]), Err(Outcome::NotText));
+        assert!(judge(&vec![b'a'; MOST_BYTES]).is_ok());
+        assert_eq!(judge(&vec![b'a'; MOST_BYTES + 1]), Err(Outcome::TooLarge));
+    }
+
+    #[test]
+    fn json_goes_there_and_back() {
+        let text = "a \"quoted\" \\ line\nwith\ttab, \u{1} and 日本 😀";
+        let line = format!(
+            r#"{{"kind":"paste_text","nonce":"ab12","text":{}}}"#,
+            quote(text)
+        );
+        let fields = parse_flat(line.as_bytes()).unwrap();
+        assert_eq!(fields[0], ("kind".into(), Value::Text("paste_text".into())));
+        assert_eq!(fields[2], ("text".into(), Value::Text(text.into())));
+        let surrogates =
+            parse_flat(br#"{"t":"\ud83d\ude00","b":true,"n":-1.5e3,"z":null}"#).unwrap();
+        assert_eq!(surrogates[0].1, Value::Text("😀".into()));
+        assert_eq!(surrogates[1].1, Value::Bool(true));
+        assert_eq!(surrogates[2].1, Value::Other);
+        for bad in [
+            &b"{"[..],
+            b"[]",
+            br#"{"a":}"#,
+            br#"{"a":"b"} x"#,
+            br#"{"a":{"b":1}}"#,
+            b"\xff",
+        ] {
+            assert_eq!(parse_flat(bad), None);
+        }
+        assert_eq!(parse_flat(b" { } "), Some(Vec::new()));
+    }
+}
