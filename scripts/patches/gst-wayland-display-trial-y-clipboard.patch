new file mode 100644
index 0000000..f248213
--- /dev/null
+++ b/wayland-display-core/src/tests/test_trial_clipboard.rs
@@ -0,0 +1,314 @@
+//! Trial only (Istesso's ADR 0022): copy and paste with the device a person types on. A real
+//! Wayland client has the keyboard; the agent's side is played by sockets of the test's own.
+
+use crate::Command;
+use crate::comp::clipboard::{Value, parse_flat, quote};
+use crate::tests::fixture::Fixture;
+use smithay::backend::input::{ButtonState, KeyState};
+use smithay::utils::Point;
+use std::io::Read;
+use std::os::unix::net::UnixDatagram;
+use std::time::{Duration, Instant};
+use test_log::test;
+
+const CONTROL: u32 = 29;
+const KEY_A: u32 = 30;
+const KEY_C: u32 = 46;
+const KEY_V: u32 = 47;
+const KEY_X: u32 = 45;
+
+/// A compositor with copy and paste on, a window of the client that has the keyboard, and the
+/// agent's ends: where answers come, and where text is sent.
+struct Agent {
+    f: Fixture,
+    answers: UnixDatagram,
+    to: std::path::PathBuf,
+    _dir: tempfile::TempDir,
+}
+
+fn agent() -> Agent {
+    let dir = tempfile::tempdir().unwrap();
+    let answers = UnixDatagram::bind(dir.path().join("clipboard-answer.sock")).unwrap();
+    answers.set_nonblocking(true).unwrap();
+    let mut f = Fixture::new();
+    f.server.enable_clipboard(dir.path()).unwrap();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    f.server.pointer_button(0, 0x110, ButtonState::Released);
+    f.round_trip();
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    f.client.watch_selection();
+    f.round_trip();
+    f.client.take_keys();
+    Agent {
+        f,
+        answers,
+        to: dir.path().join("clipboard.sock"),
+        _dir: dir,
+    }
+}
+
+impl Agent {
+    fn send(&self, line: &str) {
+        UnixDatagram::unbound()
+            .unwrap()
+            .send_to(line.as_bytes(), &self.to)
+            .unwrap();
+    }
+
+    /// Turns the loop until an answer comes, for at most `within`.
+    fn answer(&mut self, within: Duration) -> Option<Vec<(String, Value)>> {
+        let until = Instant::now() + within;
+        let mut buffer = vec![0u8; 256 * 1024];
+        while Instant::now() < until {
+            self.f.update_server();
+            self.f.update_client();
+            if let Ok(n) = self.answers.recv(&mut buffer) {
+                return parse_flat(&buffer[..n]);
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        None
+    }
+
+    fn input(&mut self, command: Command) {
+        assert!(self.f.server.take_input(command).is_none());
+    }
+
+    fn turn(&mut self, times: usize) {
+        for _ in 0..times {
+            self.f.update_server();
+            self.f.update_client();
+            std::thread::sleep(Duration::from_millis(5));
+        }
+    }
+}
+
+fn field<'a>(answer: &'a [(String, Value)], key: &str) -> Option<&'a Value> {
+    answer.iter().find(|(k, _)| k == key).map(|(_, v)| v)
+}
+
+fn text(s: &str) -> Value {
+    Value::Text(s.to_string())
+}
+
+fn copy(nonce: &str, cut: bool) -> Command {
+    Command::ClipboardCopy {
+        nonce: nonce.into(),
+        cut,
+    }
+}
+
+fn paste(nonce: &str, with_text: bool) -> Command {
+    Command::ClipboardPaste {
+        nonce: nonce.into(),
+        with_text,
+    }
+}
+
+/// Control and `key`, pressed and let go, and nothing else.
+fn pressed_with_control(key: u32) -> Vec<(u32, bool)> {
+    vec![(CONTROL, true), (key, true), (key, false), (CONTROL, false)]
+}
+
+#[test]
+fn hello_is_answered_with_its_nonce() {
+    let mut a = agent();
+    a.send(r#"{"kind":"hello","nonce":"00ff"}"#);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "kind"), Some(&text("hello")));
+    assert_eq!(field(&answer, "nonce"), Some(&text("00ff")));
+}
+
+#[test]
+fn a_copy_presses_control_c_and_answers_with_the_selection_the_client_sets() {
+    let mut a = agent();
+    a.input(copy("n1", false));
+    a.turn(3);
+    assert_eq!(a.f.client.take_keys(), pressed_with_control(KEY_C));
+    let copied = "a line\nand 日本語\twith a tab";
+    a.f.client
+        .set_selection(copied, &["text/plain;charset=utf-8", "text/html"]);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "nonce"), Some(&text("n1")));
+    assert_eq!(field(&answer, "result"), Some(&text("text")));
+    assert_eq!(field(&answer, "text"), Some(&text(copied)));
+}
+
+#[test]
+fn a_cut_presses_control_x_and_control_held_already_is_not_pressed_again() {
+    let mut a = agent();
+    // The Command key arrives as Control and is held.
+    a.input(Command::KeyboardInput(CONTROL, KeyState::Pressed));
+    a.input(copy("n2", true));
+    a.turn(3);
+    assert_eq!(
+        a.f.client.take_keys(),
+        vec![(CONTROL, true), (KEY_X, true), (KEY_X, false)]
+    );
+    a.f.client.set_selection("cut", &["UTF8_STRING"]);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "text"), Some(&text("cut")));
+}
+
+#[test]
+fn a_selection_set_before_the_copy_is_not_taken() {
+    let mut a = agent();
+    a.f.client.set_selection("old", &["text/plain"]);
+    a.turn(3);
+    a.input(copy("n3", false));
+    let answer = a.answer(Duration::from_secs(2)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("none")));
+}
+
+#[test]
+fn a_copy_from_a_client_that_took_the_keyboard_meanwhile_is_not_taken() {
+    let mut a = agent();
+    let mut other = a.f.another_application();
+    a.input(copy("n4", false));
+    a.turn(2);
+    // Another application's window comes and takes the keyboard; it sets the selection.
+    other.create_window();
+    a.f.round_trip_with(&mut other);
+    other.setup_window(320, 240);
+    a.f.round_trip_with(&mut other);
+    a.f.round_trip_with(&mut other);
+    a.f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    a.f.server.pointer_button(0, 0x110, ButtonState::Released);
+    a.f.round_trip_with(&mut other);
+    other.watch_selection();
+    other.set_selection("theirs", &["text/plain"]);
+    a.f.round_trip_with(&mut other);
+    let answer = a.answer(Duration::from_secs(2)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("none")));
+}
+
+#[test]
+fn a_copy_from_a_password_field_is_refused_without_a_key() {
+    let mut a = agent();
+    a.f.client.enable_password_field();
+    a.f.round_trip();
+    a.input(copy("n5", false));
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("refused")));
+    assert_eq!(field(&answer, "why"), Some(&text("password_field")));
+    a.turn(3);
+    assert_eq!(a.f.client.take_keys(), Vec::new());
+}
+
+#[test]
+fn a_selection_marked_secret_is_refused_unread() {
+    let mut a = agent();
+    a.input(copy("n6", false));
+    a.turn(2);
+    a.f.client
+        .set_selection("hunter2", &["text/plain", "x-kde-passwordManagerHint"]);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("refused")));
+    assert_eq!(field(&answer, "why"), Some(&text("secret_marker")));
+    assert_eq!(field(&answer, "text"), None);
+}
+
+#[test]
+fn a_copy_over_the_limit_or_not_text_is_not_carried() {
+    let mut a = agent();
+    a.input(copy("n7", false));
+    a.turn(2);
+    a.f.client
+        .set_selection(&"a".repeat(65537), &["text/plain"]);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("too_large")));
+
+    a.input(copy("n8", false));
+    a.turn(2);
+    a.f.client.set_selection("bell\u{7}", &["text/plain"]);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("not_text")));
+}
+
+#[test]
+fn a_paste_makes_the_text_the_selection_then_presses_control_v() {
+    let mut a = agent();
+    let pasted = "pasted \"text\"\nline two";
+    a.send(&format!(
+        r#"{{"kind":"paste_text","nonce":"p1","text":{}}}"#,
+        quote(pasted)
+    ));
+    a.turn(3);
+    a.input(paste("p1", true));
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("pasted")));
+    a.turn(3);
+    assert_eq!(a.f.client.take_keys(), pressed_with_control(KEY_V));
+    let kinds = a.f.client.selection_kinds().unwrap();
+    assert!(kinds.contains(&"text/plain;charset=utf-8".to_string()));
+    let mut reader = a.f.client.receive_selection("text/plain;charset=utf-8");
+    a.turn(5);
+    let mut read = String::new();
+    reader.read_to_string(&mut read).unwrap();
+    assert_eq!(read, pasted);
+}
+
+#[test]
+fn keys_after_a_paste_wait_for_its_text_and_come_after_control_v() {
+    let mut a = agent();
+    a.input(paste("p2", true));
+    a.input(Command::KeyboardInput(KEY_A, KeyState::Pressed));
+    a.input(Command::KeyboardInput(KEY_A, KeyState::Released));
+    a.turn(3);
+    assert_eq!(a.f.client.take_keys(), Vec::new());
+    a.send(r#"{"kind":"paste_text","nonce":"p2","text":"x"}"#);
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("pasted")));
+    a.turn(3);
+    let mut keys = pressed_with_control(KEY_V);
+    keys.extend([(KEY_A, true), (KEY_A, false)]);
+    assert_eq!(a.f.client.take_keys(), keys);
+}
+
+#[test]
+fn a_paste_whose_text_does_not_come_lets_the_keys_go_on() {
+    let mut a = agent();
+    a.input(paste("p3", true));
+    a.input(Command::KeyboardInput(KEY_A, KeyState::Pressed));
+    a.input(Command::KeyboardInput(KEY_A, KeyState::Released));
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("none")));
+    a.turn(3);
+    assert_eq!(a.f.client.take_keys(), vec![(KEY_A, true), (KEY_A, false)]);
+}
+
+#[test]
+fn a_paste_without_text_withdraws_the_earlier_text_then_presses_control_v() {
+    let mut a = agent();
+    a.send(r#"{"kind":"paste_text","nonce":"p4","text":"earlier"}"#);
+    a.turn(3);
+    a.input(paste("p4", true));
+    a.answer(Duration::from_secs(1)).unwrap();
+    a.turn(3);
+    assert!(a.f.client.selection_kinds().is_some());
+    a.f.client.take_keys();
+    a.input(paste("p5", false));
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("pasted")));
+    a.turn(3);
+    assert_eq!(a.f.client.selection_kinds(), None);
+    assert_eq!(a.f.client.take_keys(), pressed_with_control(KEY_V));
+}
+
+#[test]
+fn a_paste_over_the_limit_is_not_pasted() {
+    let mut a = agent();
+    a.send(&format!(
+        r#"{{"kind":"paste_text","nonce":"p6","text":{}}}"#,
+        quote(&"b".repeat(65537))
+    ));
+    a.turn(3);
+    a.input(paste("p6", true));
+    let answer = a.answer(Duration::from_secs(1)).unwrap();
+    assert_eq!(field(&answer, "result"), Some(&text("too_large")));
+    a.turn(3);
+    assert_eq!(a.f.client.take_keys(), Vec::new());
+}
