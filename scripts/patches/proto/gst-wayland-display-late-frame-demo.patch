+/// Demonstration only (the late frame): with `ISTESSO_LATE_FRAME_DEMO=N` in the environment
+/// the renderer gets extra work before every frame, N times filling a buffer of its own that
+/// nothing shows. The picture is drawn after that work. What is copied out of the output
+/// buffer before the renderer has come that far is the picture of the frame before.
+fn demo_renderer_load(renderer: &mut GlesRenderer) -> Result<(), GlesError> {
+    use smithay::backend::allocator::Fourcc;
+    use smithay::backend::renderer::gles::GlesRenderbuffer;
+    use smithay::backend::renderer::{Bind, Frame, Offscreen};
+    use smithay::utils::{Rectangle, Transform};
+    use std::cell::RefCell;
+    use std::sync::OnceLock;
+
+    const SIDE: i32 = 4096;
+    static FILLS: OnceLock<u32> = OnceLock::new();
+    thread_local! {
+        static SCRATCH: RefCell<Option<GlesRenderbuffer>> = const { RefCell::new(None) };
+    }
+    let fills = *FILLS.get_or_init(|| {
+        std::env::var("ISTESSO_LATE_FRAME_DEMO")
+            .ok()
+            .and_then(|fills| fills.parse().ok())
+            .unwrap_or(0)
+    });
+    if fills == 0 {
+        return Ok(());
+    }
+    SCRATCH.with(|scratch| {
+        let mut scratch = scratch.borrow_mut();
+        if scratch.is_none() {
+            let buffer: GlesRenderbuffer =
+                renderer.create_buffer(Fourcc::Abgr8888, (SIDE, SIDE).into())?;
+            *scratch = Some(buffer);
+        }
+        let mut target = renderer.bind(scratch.as_mut().unwrap())?;
+        let mut frame = renderer.render(&mut target, (SIDE, SIDE).into(), Transform::Normal)?;
+        for fill in 0..fills {
+            let shade = (fill % 2) as f32;
+            frame.clear(
+                [shade, shade, shade, 1.0].into(),
+                &[Rectangle::from_size((SIDE, SIDE).into())],
+            )?;
+        }
+        // Not waited for: the work is to be in the renderer's queue when the picture is drawn.
+        frame.finish().map(|_| ())
+    })
+}
