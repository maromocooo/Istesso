+/// Posts `wayland.second-window` on the attached element's bus. Its `present` flag
+/// says whether the output shows a window. When present, `title`, pixel `width` and
+/// `height`, and `key` describe that window.
+fn second_window_sink(
+    element: glib::WeakRef<super::WaylandDisplaySrc>,
+) -> waylanddisplaycore::SecondWindowSink {
+    Box::new(move |window| {
+        let Some(element) = element.upgrade() else {
+            return;
+        };
+        let mut structure = Structure::builder("wayland.second-window")
+            .field("present", window.is_some());
+        if let Some(window) = window {
+            structure = structure
+                .field("title", window.title.as_str())
+                .field("width", window.width)
+                .field("height", window.height)
+                .field("key", window.key);
+        }
+        let message = Application::builder(structure.build()).src(&element).build();
+        if element.post_message(message).is_err() {
+            gst::warning!(CAT, "Failed to post the second window to the bus");
+        }
+    })
+}
