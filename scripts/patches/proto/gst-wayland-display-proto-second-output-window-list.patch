+#[test]
+fn the_second_window_is_reported_on_map_change_and_close() {
+    let mut f = fixture(false);
+    let (tx, reports) = channel();
+    f.server
+        .set_second_window_sink(Some(Box::new(move |info| tx.send(info).unwrap())));
+    let (tx, counts) = channel();
+    f.server
+        .set_window_sink(Some(Box::new(move |n| tx.send(n).unwrap())));
+    assert_eq!(reports.try_recv(), Ok(None));
+    assert_eq!(counts.try_recv(), Ok(0));
+
+    f.create_window(320, 240);
+    assert_eq!(reports.try_recv(), Err(TryRecvError::Empty));
+    assert_eq!(counts.try_recv(), Ok(1));
+
+    f.client.create_window();
+    f.round_trip();
+    assert_eq!(reports.try_recv(), Err(TryRecvError::Empty));
+    assert_eq!(counts.try_recv(), Ok(2));
+    f.client.setup_window(160, 120);
+    f.round_trip();
+    let mut expected = SecondWindowInfo {
+        title: "Hello World!".to_owned(),
+        width: 320,
+        height: 240,
+        key: false,
+    };
+    assert_eq!(reports.try_recv(), Ok(Some(expected.clone())));
+
+    f.client.commit_window_at(1);
+    f.round_trip();
+    assert_eq!(reports.try_recv(), Err(TryRecvError::Empty));
+    f.client.set_window_title_at(1, "Another title");
+    f.round_trip();
+    f.client.commit_window_at(0);
+    f.round_trip();
+    assert_eq!(reports.try_recv(), Err(TryRecvError::Empty));
+    f.client.commit_window_at(1);
+    f.round_trip();
+    expected.title = "Another title".to_owned();
+    assert_eq!(reports.try_recv(), Ok(Some(expected)));
+    assert_eq!(counts.try_recv(), Err(TryRecvError::Empty));
+
+    f.client.close_window();
+    f.round_trip();
+    assert_eq!(reports.try_recv(), Ok(None));
+    assert_eq!(reports.try_recv(), Err(TryRecvError::Empty));
+    assert_eq!(counts.try_recv(), Ok(1));
+    assert_eq!(counts.try_recv(), Err(TryRecvError::Empty));
+}
