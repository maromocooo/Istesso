+/// The mapped window on the second output, as advertised to the viewer.
+#[derive(Clone, PartialEq, Eq)]
+pub struct SecondWindowInfo {
+    pub title: String,
+    pub width: u32,
+    pub height: u32,
+    pub key: bool,
+}
+
+impl std::fmt::Debug for SecondWindowInfo {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("SecondWindowInfo")
+            .field("width", &self.width)
+            .field("height", &self.height)
+            .field("key", &self.key)
+            .finish_non_exhaustive()
+    }
+}
+
+/// Receives the current window on the compositor thread, or `None` for an empty output.
+pub type SecondWindowSink = Box<dyn Fn(Option<SecondWindowInfo>) + Send>;
+
+impl State {
+    pub(crate) fn set_second_window_sink(&mut self, sink: Option<SecondWindowSink>) {
+        self.second_window_sink = sink;
+        self.last_second_window = None;
+        self.tell_second_window(true);
+    }
+
+    pub(crate) fn tell_second_window(&mut self, initial: bool) {
+        let Some(sink) = &self.second_window_sink else {
+            return;
+        };
+        let mapped = self.second.as_ref().and_then(|second| {
+            let window = second.window.as_ref()?;
+            // Assigned at configure time, advertised only once it has a picture.
+            self.space.element_location(window)?;
+            Some((
+                window.toplevel()?.wl_surface(),
+                second.output.current_mode()?.size,
+            ))
+        });
+        let Some((surface, size)) = mapped else {
+            if self.last_second_window.take().is_some() || initial {
+                sink(None);
+            }
+            return;
+        };
+
+        // Most commits only change pixels. Compare the title in place on those frames.
+        let changed = with_states(surface, |states| {
+            let attrs = states
+                .data_map
+                .get::<XdgToplevelSurfaceData>()
+                .unwrap()
+                .lock()
+                .unwrap();
+            let title = attrs.title.as_deref().unwrap_or_default();
+            let (width, height) = (size.w as u32, size.h as u32);
+            let key = false; // Step 3 (input) sets this.
+            if self.last_second_window.as_ref().is_some_and(|last| {
+                last.title == title
+                    && last.width == width
+                    && last.height == height
+                    && last.key == key
+            }) {
+                return None;
+            }
+            Some(SecondWindowInfo {
+                title: title.to_owned(),
+                width,
+                height,
+                key,
+            })
+        });
+        if let Some(info) = changed {
+            self.last_second_window = Some(info.clone());
+            sink(Some(info));
+        }
+    }
+}
