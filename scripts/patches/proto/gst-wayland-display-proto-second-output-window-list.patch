+#[test]
+fn a_late_listener_gets_the_mapped_window_and_then_its_new_mode_size() {
+    let mut f = fixture(true);
+    let (tx, reports) = channel();
+    f.server
+        .set_second_window_sink(Some(Box::new(move |info| tx.send(info).unwrap())));
+    let mut expected = SecondWindowInfo {
+        title: "Hello World!".to_owned(),
+        width: 320,
+        height: 240,
+        key: false,
+    };
+    assert_eq!(reports.try_recv(), Ok(Some(expected.clone())));
+
+    let output = &f.server.second.as_ref().unwrap().output;
+    let mut mode = output.current_mode().unwrap();
+    mode.size = (640, 480).into();
+    output.change_current_state(Some(mode), None, None, None);
+    f.client.commit_window_at(1);
+    f.round_trip();
+    expected.width = 640;
+    expected.height = 480;
+    assert_eq!(reports.try_recv(), Ok(Some(expected)));
+    f.client.commit_window_at(1);
+    f.round_trip();
+    assert_eq!(reports.try_recv(), Err(TryRecvError::Empty));
+}
