@@ -0,0 +1,188 @@
+//! Drive the same second-output handlers as the attached element, with a real Wayland client.
+
+use super::fixture::Fixture;
+use crate::comp::{schedule_waiting_frame, second, send_frame_callbacks};
+use crate::utils::RenderTarget;
+use crate::utils::video_info::GstVideoInfo;
+use gst::Fraction;
+use gst_video::{VideoFormat, VideoInfo};
+use smithay::backend::SwapBuffersError;
+use std::sync::atomic::Ordering;
+use std::sync::mpsc::{Receiver, TryRecvError, sync_channel};
+use std::time::{Duration, Instant};
+use test_log::test;
+
+const FPS: i32 = 20;
+const FRAME: Duration = Duration::from_millis(50);
+
+type Frame = Receiver<Result<gst::Buffer, SwapBuffersError>>;
+
+fn fixture(with_windows: bool) -> Fixture {
+    let mut f = Fixture::new();
+    // The element sends its switch at attach time, before set_caps makes the output.
+    second::set_render_on_commit(&mut f.server, true);
+    let info = VideoInfo::builder(VideoFormat::Rgba, 320, 240)
+        .fps(Fraction::new(FPS, 1))
+        .build()
+        .unwrap();
+    second::apply_video_info(
+        &mut f.server,
+        GstVideoInfo::RAW(info),
+        &RenderTarget::Software,
+        None,
+    );
+    f.server.pacing.set_frame_rate(FPS as u64, 1);
+    f.server.pacing.set_enabled(true);
+    if with_windows {
+        f.create_window(320, 240);
+        f.create_window(320, 240);
+        assert!(f.server.second.as_ref().unwrap().window.is_some());
+    }
+    f
+}
+
+fn ask(f: &mut Fixture) -> Frame {
+    // The receiver and the compositor run on this same thread.
+    let (tx, rx) = sync_channel(1);
+    second::frame_asked(&mut f.server, tx);
+    rx
+}
+
+fn wait_until(
+    f: &mut Fixture,
+    timeout: Duration,
+    mut ready: impl FnMut(&Fixture) -> bool,
+) -> Instant {
+    let deadline = Instant::now() + timeout;
+    loop {
+        if ready(f) {
+            return Instant::now();
+        }
+        assert!(
+            Instant::now() < deadline,
+            "timed out waiting for the compositor"
+        );
+        f.update_client();
+        f.update_server();
+        std::thread::sleep(Duration::from_millis(1));
+    }
+}
+
+fn received(f: &mut Fixture, frame: &Frame) -> Instant {
+    wait_until(f, FRAME * 5, |_| match frame.try_recv() {
+        Ok(result) => {
+            result.expect("second output failed to render");
+            true
+        }
+        Err(TryRecvError::Empty) => false,
+        Err(TryRecvError::Disconnected) => panic!("second output dropped the request"),
+    })
+}
+
+fn next_frame(f: &mut Fixture) {
+    let frame = ask(f);
+    received(f, &frame);
+}
+
+fn expect_idle_frame(f: &mut Fixture) {
+    // Rendering ends before the test thread gets to poll the receiver.
+    let last = f.server.second.as_ref().unwrap().last_render.unwrap();
+    let frame = ask(f);
+    let apart = received(f, &frame).duration_since(last);
+    assert!(
+        apart >= FRAME * 2 - Duration::from_millis(1) && apart < FRAME * 3,
+        "idle frame after {apart:?}"
+    );
+}
+
+#[test]
+fn a_second_commit_releases_a_frame_and_the_next_idle_frame_keeps_its_deadline() {
+    let mut f = fixture(true);
+    next_frame(&mut f);
+    let frame = ask(&mut f);
+    std::thread::sleep(FRAME / 2);
+    f.update_server();
+    assert!(matches!(frame.try_recv(), Err(TryRecvError::Empty)));
+
+    let committed = Instant::now();
+    f.client.commit_window_at(1);
+    assert!(received(&mut f, &frame).duration_since(committed) < FRAME / 2);
+    // The superseded timer for the committed frame will fire during this request.
+    expect_idle_frame(&mut f);
+}
+
+fn ask_first(f: &mut Fixture) {
+    let now = Instant::now();
+    f.server.pacing.frame_started(now);
+    let wait = f.server.pacing.frame_asked(now, Some(now));
+    f.server.waiting_frame = Some(Box::new(|state, now| {
+        state.pacing.frame_started(now);
+    }));
+    schedule_waiting_frame(&mut f.server, wait);
+}
+
+#[test]
+fn each_commit_releases_only_its_own_outputs_frame() {
+    let mut f = fixture(true);
+    next_frame(&mut f);
+    let second = ask(&mut f);
+    ask_first(&mut f);
+    f.client.commit_window_at(0);
+    wait_until(&mut f, FRAME / 2, |f| f.server.waiting_frame.is_none());
+    assert!(matches!(second.try_recv(), Err(TryRecvError::Empty)));
+
+    ask_first(&mut f);
+    let committed = Instant::now();
+    f.client.commit_window_at(1);
+    assert!(received(&mut f, &second).duration_since(committed) < FRAME / 2);
+    assert!(f.server.waiting_frame.is_some());
+}
+
+#[test]
+fn the_second_window_waits_for_its_own_draw_callback() {
+    let mut f = fixture(true);
+    // Just after a callback, the next commit must wait for this output's tell timer.
+    let first = f.client.commit_window_and_wait_to_be_told_at(1);
+    wait_until(&mut f, FRAME * 2, |_| first.done.load(Ordering::Relaxed));
+    let next = f.client.commit_window_and_wait_to_be_told_at(1);
+    let committed = f.client.send_sync();
+    wait_until(&mut f, FRAME / 2, |_| {
+        committed.done.load(Ordering::Relaxed)
+    });
+
+    send_frame_callbacks(&f.server);
+    f.server.dh.flush_clients().unwrap();
+    f.update_client();
+    assert!(
+        !next.done.load(Ordering::Relaxed),
+        "the first output told the second window"
+    );
+    wait_until(&mut f, FRAME * 2, |_| next.done.load(Ordering::Relaxed));
+}
+
+#[test]
+fn switching_to_the_beat_releases_the_waiter_and_uses_one_interval() {
+    let mut f = fixture(true);
+    next_frame(&mut f);
+    let waiting = ask(&mut f);
+    let switched = Instant::now();
+    second::set_render_on_commit(&mut f.server, false);
+    assert!(received(&mut f, &waiting).duration_since(switched) < FRAME / 2);
+
+    std::thread::sleep(FRAME);
+    let asked = Instant::now();
+    next_frame(&mut f);
+    assert!(
+        asked.elapsed() < FRAME / 2,
+        "a frame was held past its beat"
+    );
+}
+
+#[test]
+fn an_empty_second_output_keeps_streaming() {
+    let mut f = fixture(false);
+    assert!(f.server.second.as_ref().unwrap().window.is_none());
+    next_frame(&mut f);
+    expect_idle_frame(&mut f);
+    expect_idle_frame(&mut f);
+}
