diff --git a/wayland-display-core/src/comp/second.rs b/wayland-display-core/src/comp/second.rs
new file mode 100644
index 0000000..f5fa3e1
--- /dev/null
+++ b/wayland-display-core/src/comp/second.rs
@@ -0,0 +1,252 @@
+//! Prototype (Istesso, "new windows" on the Linux host, a one-day look): a second output that
+//! shows the second window, on a stream of its own.
+//!
+//! Only what it takes to answer one question: does the first window's picture come later when a
+//! second window is rendered and encoded at the same time, by the same compositor thread and
+//! GL context? So:
+//!
+//! * A second element of this plugin in the same process (property `output=1`) attaches to the
+//!   compositor of the first and asks for frames of output 1 here.
+//! * Output 1 lies far to the right of the first output in the space ([`SECOND_AT`]), so the
+//!   first output's picture never holds anything of it.
+//! * The first window without a parent that comes while the first output already shows a
+//!   window goes to output 1, sized to it, and does not take the keyboard. Later windows go
+//!   where they went before.
+//! * Output 1 is rendered on the beat of its frame rate (not on commit), and what its window
+//!   commits does not make the first output render or tell its clients anything.
+//! * Nothing else: no pointer, no popups, no dialogs, no resize, no second window that goes and
+//!   comes back.
+
+use std::sync::mpsc::SyncSender;
+#[cfg(feature = "cuda")]
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use gst_video::VideoInfo;
+use smithay::backend::SwapBuffersError;
+use smithay::backend::drm::DrmNode;
+use smithay::backend::renderer::damage::{Error as DTRError, OutputDamageTracker};
+use smithay::desktop::Window;
+use smithay::output::{Mode as OutputMode, Output, PhysicalProperties, Subpixel};
+use smithay::reexports::calloop::timer::{TimeoutAction, Timer};
+use smithay::reexports::wayland_server::protocol::wl_surface::WlSurface;
+use smithay::utils::{Logical, Point, Size};
+use smithay::wayland::compositor::get_parent;
+use smithay::wayland::seat::WaylandFocus;
+
+use super::State;
+use crate::utils::RenderTarget;
+use crate::utils::allocator::{GsBufferType, GsDmaBuf, GsGlesbuffer};
+#[cfg(feature = "cuda")]
+use crate::utils::allocator::{GsCUDABuf, cuda::CUDABufferPool};
+use crate::utils::video_info::GstVideoInfo;
+
+/// Where output 1 begins in the space: far to the right of any first output.
+pub(crate) const SECOND_AT: i32 = 1 << 14;
+
+pub(crate) struct SecondOutput {
+    pub(crate) output: Output,
+    pub(crate) dtr: OutputDamageTracker,
+    pub(crate) buffer: GsBufferType,
+    pub(crate) interval: Duration,
+    pub(crate) last_render: Option<Instant>,
+    /// The window it shows, from its first configure on.
+    pub(crate) window: Option<Window>,
+    pub(crate) frames: u64,
+}
+
+impl SecondOutput {
+    pub(crate) fn size(&self) -> Size<i32, Logical> {
+        self.output
+            .current_mode()
+            .map(|mode| mode.size.to_logical(1))
+            .unwrap_or_default()
+    }
+
+    pub(crate) fn location(&self) -> Point<i32, Logical> {
+        (SECOND_AT, 0).into()
+    }
+
+    /// Whether `surface`, or the surface it belongs to, is the window of this output.
+    pub(crate) fn shows(&self, surface: &WlSurface) -> bool {
+        let Some(window) = self.window.as_ref() else {
+            return false;
+        };
+        let mut root = surface.clone();
+        while let Some(parent) = get_parent(&root) {
+            root = parent;
+        }
+        window.wl_surface().is_some_and(|s| *s == root)
+    }
+
+    pub(crate) fn is(&self, window: &Window) -> bool {
+        self.window.as_ref() == Some(window)
+    }
+}
+
+pub(crate) fn apply_video_info(
+    state: &mut State,
+    video_info: GstVideoInfo,
+    render_target: &RenderTarget,
+    render_node: Option<DrmNode>,
+) {
+    if state.second.is_some() {
+        tracing::warn!("The second output is negotiated once only in this prototype.");
+        return;
+    }
+    let base_info: VideoInfo = video_info.clone().into();
+    let size: Size<i32, smithay::utils::Physical> =
+        (base_info.width() as i32, base_info.height() as i32).into();
+    let framerate = base_info.fps();
+    let interval = Duration::from_secs_f64(
+        framerate.denom().max(1) as f64 / framerate.numer().max(1) as f64,
+    );
+    let output = Output::new(
+        "HEADLESS-2".into(),
+        PhysicalProperties {
+            make: "Virtual".into(),
+            model: "Wolf".into(),
+            size: (0, 0).into(),
+            subpixel: Subpixel::Unknown,
+        },
+    );
+    output.create_global::<State>(&state.dh);
+    let mode = OutputMode {
+        size,
+        refresh: (1000.0 / interval.as_secs_f64()).round() as i32,
+    };
+    output.change_current_state(Some(mode), None, None, None);
+    output.set_preferred(mode);
+    state.space.map_output(&output, (SECOND_AT, 0));
+    let dtr = OutputDamageTracker::from_output(&output);
+
+    let buffer = match render_target {
+        RenderTarget::Hardware(_) => match video_info {
+            GstVideoInfo::RAW(base_info) => GsBufferType::RAW(
+                GsGlesbuffer::new(&mut state.renderer, base_info)
+                    .expect("Failed to create GsGlesbuffer"),
+            ),
+            GstVideoInfo::DMA(base_info) => GsBufferType::DMA(
+                GsDmaBuf::new(render_node.unwrap(), base_info).expect("Failed to create GsDmaBuf"),
+            ),
+            #[cfg(feature = "cuda")]
+            GstVideoInfo::CUDA(base_info) => {
+                let egl_display = state
+                    .renderer
+                    .egl_context()
+                    .display()
+                    .get_display_handle()
+                    .handle;
+                GsBufferType::CUDA(
+                    GsCUDABuf::new(
+                        render_node.unwrap(),
+                        base_info.cuda_context,
+                        base_info.video_info,
+                        Arc::new(Mutex::new(None)),
+                        &egl_display,
+                    )
+                    .expect("Failed to create GsCUDABuf"),
+                )
+            }
+        },
+        RenderTarget::Software => GsBufferType::RAW(
+            GsGlesbuffer::new(&mut state.renderer, base_info.clone())
+                .expect("Failed to create GsGlesbuffer"),
+        ),
+    };
+    tracing::info!(
+        width = size.w,
+        height = size.h,
+        "Second output ready (prototype)."
+    );
+    state.second = Some(SecondOutput {
+        output,
+        dtr,
+        buffer,
+        interval,
+        last_render: None,
+        window: None,
+        frames: 0,
+    });
+}
+
+#[cfg(feature = "cuda")]
+pub(crate) fn update_cuda_pool(
+    state: &mut State,
+    output: usize,
+    pool: Arc<Mutex<Option<CUDABufferPool>>>,
+) {
+    if output != 1 {
+        return;
+    }
+    if let Some(SecondOutput {
+        buffer: GsBufferType::CUDA(cuda_buf),
+        ..
+    }) = state.second.as_mut()
+    {
+        cuda_buf.buffer_pool = pool;
+    }
+}
+
+/// The second element asks for a frame: it is rendered one frame interval after the last one,
+/// or now if that has passed.
+pub(crate) fn frame_asked(
+    state: &mut State,
+    sender: SyncSender<Result<gst::Buffer, SwapBuffersError>>,
+) {
+    let Some(second) = state.second.as_ref() else {
+        let _ = sender.send(Err(SwapBuffersError::ContextLost(
+            "the second output has no video info".into(),
+        )));
+        return;
+    };
+    let wait = second
+        .last_render
+        .map(|last| second.interval.saturating_sub(last.elapsed()))
+        .unwrap_or(Duration::ZERO);
+    if wait.is_zero() {
+        render(state, sender);
+    } else if let Err(err) =
+        state
+            .handle
+            .insert_source(Timer::from_duration(wait), move |_, _, state| {
+                render(state, sender.clone());
+                TimeoutAction::Drop
+            })
+    {
+        tracing::error!(?err, "Event loop error.");
+        state.should_quit = true;
+    }
+}
+
+fn render(state: &mut State, sender: SyncSender<Result<gst::Buffer, SwapBuffersError>>) {
+    match state.create_second_frame() {
+        Ok((buffer, result)) => {
+            result
+                .sync
+                .wait()
+                .expect("Error during render_result.sync");
+            let _ = sender.send(Ok(buffer));
+            let now = state.clock.now();
+            if let Some(second) = state.second.as_mut() {
+                second.last_render = Some(Instant::now());
+                second.frames += 1;
+                if let Some(window) = second.window.as_ref() {
+                    let output = second.output.clone();
+                    window.send_frame(&output, now, Some(Duration::ZERO), |_, _| {
+                        Some(output.clone())
+                    });
+                }
+            }
+        }
+        Err(err) => {
+            tracing::error!(?err, "Rendering the second output failed.");
+            let _ = sender.send(Err(match err {
+                DTRError::OutputNoMode(_) => {
+                    SwapBuffersError::ContextLost("the second output has no mode".into())
+                }
+                DTRError::Rendering(err) => err.into(),
+            }));
+        }
+    }
+}
