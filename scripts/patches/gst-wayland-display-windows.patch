+        self.state.windows.last().is_some_and(|w| w.close_requested)
+    }
+
+    /// Closes the last window, as a client does that was asked to and has nothing to lose.
+    pub fn close_window(&mut self) {
+        if let Some(window) = self.state.windows.pop() {
+            window.viewport.destroy();
+            window.xdg_toplevel.destroy();
+            window.xdg_surface.destroy();
+            window.surface.destroy();
+        }
+    }
+
