diff --git a/wayland-display-core/src/comp/windows.rs b/wayland-display-core/src/comp/windows.rs
new file mode 100644
index 0000000..f99a2cb
--- /dev/null
+++ b/wayland-display-core/src/comp/windows.rs
@@ -0,0 +1,78 @@
+//! The application's windows, as far as whoever runs the compositor has to know about them.
+//!
+//! The compositor shows what its clients draw and otherwise leaves them alone. Two things an
+//! owner of a session needs all the same, and both are here:
+//!
+//! * to ask the clients to close their windows, the way a window manager's close button
+//!   does (`xdg_toplevel.close`). A client that has nothing to lose ends; one that has asks
+//!   its user first, and stays. Nothing is ever closed by force here.
+//! * to be told how many windows there are ([`WindowReport`]), so that it knows when the first
+//!   has come and when the last has gone, which is when an application is over whatever its
+//!   processes do.
+//!
+//! "Windows" are toplevels: popups and the cursor do not count.
+
+/// Receives the number of windows whenever it changes. Called on the compositor's thread.
+pub type WindowSink = Box<dyn Fn(usize) + Send>;
+
+/// Tells a sink how many windows there are, and only when that is not what it was told last.
+#[derive(Default)]
+pub struct WindowReport {
+    sink: Option<WindowSink>,
+    last: Option<usize>,
+}
+
+impl WindowReport {
+    /// A new sink is told the number as it is; `None` tells nobody.
+    pub fn set_sink(&mut self, sink: Option<WindowSink>) {
+        self.sink = sink;
+        self.last = None;
+    }
+
+    pub fn listening(&self) -> bool {
+        self.sink.is_some()
+    }
+
+    /// Tells the sink the number of windows, unless that is what it was told last.
+    pub fn tell(&mut self, windows: usize) {
+        let Some(sink) = &self.sink else {
+            return;
+        };
+        if self.last != Some(windows) {
+            sink(windows);
+            self.last = Some(windows);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, Mutex};
+
+    #[test]
+    fn a_sink_is_told_a_change_once_and_a_new_sink_is_told_what_is() {
+        let told = Arc::new(Mutex::new(Vec::new()));
+        let sink = |told: &Arc<Mutex<Vec<usize>>>| -> WindowSink {
+            let told = told.clone();
+            Box::new(move |windows| told.lock().unwrap().push(windows))
+        };
+        let mut report = WindowReport::default();
+        report.tell(1);
+        assert!(!report.listening());
+
+        report.set_sink(Some(sink(&told)));
+        for windows in [0, 0, 1, 1, 2, 1, 0, 0] {
+            report.tell(windows);
+        }
+        assert_eq!(*told.lock().unwrap(), [0, 1, 2, 1, 0]);
+
+        let other = Arc::new(Mutex::new(Vec::new()));
+        report.set_sink(Some(sink(&other)));
+        report.tell(0);
+        assert_eq!(*other.lock().unwrap(), [0]);
+        report.set_sink(None);
+        report.tell(3);
+        assert_eq!(other.lock().unwrap().len(), 1);
+    }
+}
