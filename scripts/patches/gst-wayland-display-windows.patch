@@ -0,0 +1,100 @@
+//! Integration tests for asking windows to close and for telling how many there are (see
+//! `comp::windows`). A real Wayland client has the window, so that a failure here says that
+//! the request no longer reaches clients, or that their windows are no longer counted.
+
+use crate::comp::windows::WindowSink;
+use crate::tests::fixture::Fixture;
+use std::sync::{Arc, Mutex};
+use test_log::test;
+
+type Told = Arc<Mutex<Vec<usize>>>;
+
+fn listen(f: &mut Fixture) -> Told {
+    let told = Told::default();
+    let sink: WindowSink = {
+        let told = told.clone();
+        Box::new(move |windows| told.lock().unwrap().push(windows))
+    };
+    f.server.set_window_sink(Some(sink));
+    told
+}
+
+#[test]
+fn a_client_that_is_asked_to_close_and_does_leaves_no_window() {
+    let mut f = Fixture::new();
+    let told = listen(&mut f);
+    // Nothing yet: a new listener is told so.
+    assert_eq!(*told.lock().unwrap(), [0]);
+
+    f.create_window(320, 240);
+    assert_eq!(*told.lock().unwrap(), [0, 1]);
+    assert!(!f.client.asked_to_close());
+
+    assert_eq!(f.server.close_windows(), 1);
+    f.round_trip();
+    assert!(f.client.asked_to_close());
+    // The window is still there: it was asked, not closed.
+    assert_eq!(*told.lock().unwrap(), [0, 1]);
+
+    // The client has nothing to lose and closes its window.
+    f.client.close_window();
+    f.round_trip();
+    assert_eq!(*told.lock().unwrap(), [0, 1, 0]);
+    assert_eq!(f.server.space.elements().count(), 0);
+}
+
+#[test]
+fn a_client_that_is_asked_to_close_and_does_not_keeps_its_window() {
+    let mut f = Fixture::new();
+    let told = listen(&mut f);
+    f.create_window(320, 240);
+
+    f.server.close_windows();
+    f.round_trip();
+    assert!(f.client.asked_to_close());
+    // The client ignores it, as one does that waits for its user's answer. Nothing is done
+    // by force, however often it is asked.
+    f.server.close_windows();
+    f.round_trip();
+    f.round_trip();
+    assert_eq!(*told.lock().unwrap(), [0, 1]);
+    assert_eq!(f.server.space.elements().count(), 1);
+    // And it can still be drawn into.
+    f.client.commit_window();
+    f.round_trip();
+    assert_eq!(f.server.space.elements().count(), 1);
+}
+
+#[test]
+fn every_window_is_counted_and_asked() {
+    let mut f = Fixture::new();
+    let told = listen(&mut f);
+    f.create_window(320, 240);
+    f.create_window(160, 120);
+    assert_eq!(*told.lock().unwrap(), [0, 1, 2]);
+    assert_eq!(f.server.close_windows(), 2);
+    f.round_trip();
+
+    // One goes, one stays: the application is not over.
+    f.client.close_window();
+    f.round_trip();
+    assert_eq!(*told.lock().unwrap(), [0, 1, 2, 1]);
+    f.client.close_window();
+    f.round_trip();
+    assert_eq!(*told.lock().unwrap(), [0, 1, 2, 1, 0]);
+}
+
+#[test]
+fn nobody_is_told_and_nothing_is_asked_unless_somebody_wants_it() {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.round_trip();
+    assert!(!f.client.asked_to_close());
+    // Somebody who starts to listen later is told how many windows there are by then.
+    let told = listen(&mut f);
+    assert_eq!(*told.lock().unwrap(), [1]);
+    f.server.set_window_sink(None);
+    f.client.close_window();
+    f.round_trip();
+    assert_eq!(*told.lock().unwrap(), [1]);
+}
