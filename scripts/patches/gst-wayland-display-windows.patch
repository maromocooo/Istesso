+/// Posts the number of windows (toplevels) the clients have as an application message on the
+/// element's bus: the structure `wayland.windows` with a `count`. 0 says that the last window
+/// has gone.
+fn window_sink(element: glib::WeakRef<super::WaylandDisplaySrc>) -> waylanddisplaycore::WindowSink {
+    Box::new(move |windows| {
+        let Some(element) = element.upgrade() else {
+            return;
+        };
+        let structure = Structure::builder("wayland.windows")
+            .field("count", windows as u32)
+            .build();
+        let message = Application::builder(structure).src(&element).build();
+        if let Err(err) = element.post_message(message) {
+            gst::warning!(
+                CAT,
+                "Failed to post the number of windows to the bus: {}",
+                err
+            );
+        }
+    })
+}
