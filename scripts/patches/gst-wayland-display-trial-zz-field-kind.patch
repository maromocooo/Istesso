new file mode 100644
index 0000000..4996add
--- /dev/null
+++ b/wayland-display-core/src/tests/test_trial_field_kind.rs
@@ -0,0 +1,172 @@
+//! Trial only (Istesso's ADR 0015, "文字の入力の欄"): the kind of the field with the keyboard is
+//! known only once its client has said a content type. Until then the field is taken for a
+//! secret one: a client may say it late, or only when asked (Chrome 145, seen on the host).
+
+use crate::tests::fixture::Fixture;
+use smithay::backend::input::ButtonState;
+use smithay::utils::Point;
+use std::time::Duration;
+use test_log::test;
+use wayland_protocols::wp::text_input::zv3::client::zwp_text_input_v3::ContentPurpose;
+
+/// A compositor with a window of the client that has the keyboard.
+fn typed_into() -> Fixture {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    f.server.pointer_button(0, 0x110, ButtonState::Released);
+    f.round_trip();
+    assert_eq!(f.client.keyboard_window(), Some(0));
+    f
+}
+
+/// Lets the compositor's waits run out (each is 40 ms).
+fn wait(f: &mut Fixture) {
+    for _ in 0..12 {
+        std::thread::sleep(Duration::from_millis(5));
+        f.update_server();
+        f.update_client();
+    }
+}
+
+#[test]
+fn a_field_that_says_its_type_with_enable_is_never_asked() {
+    let mut f = typed_into();
+    let input = f.client.text_input();
+    input.enable();
+    f.client.say_content_type(&input, ContentPurpose::Normal);
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.server.text_input_field_for_tests(), (1, false));
+    assert_eq!(f.client.text_input_events(), (0, 0));
+
+    input.disable();
+    input.commit();
+    input.enable();
+    f.client.say_content_type(&input, ContentPurpose::Password);
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.server.text_input_field_for_tests(), (2, false));
+    wait(&mut f);
+    assert_eq!(f.client.text_input_events(), (0, 0));
+}
+
+#[test]
+fn a_field_enabled_without_a_type_is_asked_and_is_secret_until_it_says_one() {
+    let mut f = typed_into();
+    let input = f.client.text_input();
+    input.enable();
+    input.commit();
+    f.round_trip();
+    // Its commit was acknowledged (one `done`, nothing else), and until it answers the field is
+    // a secret one (which takes no composing text: the test below).
+    assert_eq!(f.client.text_input_events(), (1, 0));
+    assert_eq!(f.server.text_input_field_for_tests(), (2, true));
+
+    // It answers with its content type, as Chrome does after a click: a normal field.
+    f.client.say_content_type(&input, ContentPurpose::Normal);
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.server.text_input_field_for_tests(), (1, false));
+    f.server.preedit_text("かな", 6, 6);
+    f.round_trip();
+    // The composing text went (its `done` is the second).
+    assert_eq!(f.client.text_input_events(), (2, 0));
+}
+
+#[test]
+fn a_field_that_answers_without_a_type_is_told_it_left_and_entered_and_asked_again() {
+    let mut f = typed_into();
+    let input = f.client.text_input();
+    // The client is one that says content types.
+    input.enable();
+    f.client.say_content_type(&input, ContentPurpose::Normal);
+    input.commit();
+    f.round_trip();
+    let first = f.server.text_input_identity_for_tests();
+
+    // Another field, as Chrome moves to it by Tab: disabled, enabled, nothing said.
+    input.disable();
+    input.commit();
+    input.enable();
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.client.text_input_events(), (1, 0));
+    let second = f.server.text_input_identity_for_tests();
+    assert_ne!(first, second, "another enabling is another field");
+    // It answers the acknowledgement with the cursor's rectangle alone.
+    input.set_cursor_rectangle(10, 20, 0, 30);
+    input.commit();
+    f.round_trip();
+    // So it was told that it left and entered again (the first enter was at the start).
+    assert_eq!(f.client.text_input_events(), (1, 1));
+    assert_eq!(f.server.text_input_field_for_tests(), (3, false));
+    // It enables itself again and is acknowledged again; now it says what the field is.
+    input.disable();
+    input.commit();
+    input.enable();
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.client.text_input_events(), (2, 1));
+    assert_eq!(f.server.text_input_field_for_tests(), (2, true));
+    assert_eq!(
+        f.server.text_input_identity_for_tests(),
+        second,
+        "the answer to this side's leave and enter is the same field"
+    );
+    f.client.say_content_type(&input, ContentPurpose::Password);
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.server.text_input_field_for_tests(), (2, false));
+}
+
+#[test]
+fn a_client_that_says_types_and_says_none_now_stays_secret() {
+    let mut f = typed_into();
+    let input = f.client.text_input();
+    input.enable();
+    f.client.say_content_type(&input, ContentPurpose::Normal);
+    input.commit();
+    input.disable();
+    input.commit();
+    input.enable();
+    input.commit();
+    f.round_trip();
+    // It does not answer: after the wait it is told it left and entered again.
+    wait(&mut f);
+    assert_eq!(f.client.text_input_events(), (1, 1));
+    input.enable();
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.client.text_input_events(), (2, 1));
+    // It does not answer again: everything was tried, and the field stays a secret one.
+    wait(&mut f);
+    assert_eq!(f.client.text_input_events(), (2, 1));
+    assert_eq!(f.server.text_input_field_for_tests(), (2, false));
+    f.server.preedit_text("かな", 6, 6);
+    f.round_trip();
+    assert_eq!(f.client.text_input_events(), (2, 1));
+}
+
+#[test]
+fn a_client_that_never_says_a_type_gets_a_normal_field_once_everything_was_tried() {
+    let mut f = typed_into();
+    let input = f.client.text_input();
+    input.enable();
+    input.commit();
+    f.round_trip();
+    assert_eq!(f.server.text_input_field_for_tests(), (2, true));
+    wait(&mut f);
+    assert_eq!(f.client.text_input_events(), (1, 1));
+    input.enable();
+    input.commit();
+    f.round_trip();
+    wait(&mut f);
+    // The protocol's default: a normal field, which takes composing text.
+    assert_eq!(f.server.text_input_field_for_tests(), (1, false));
+    f.server.preedit_text("かな", 6, 6);
+    f.round_trip();
+    assert_eq!(f.client.text_input_events(), (3, 1));
+}
