+    /// Finds out the kind of the field with the keyboard when its client enabled its text input
+    /// and has not said a content type (`answered`: it has just committed; otherwise a wait
+    /// ran out). Seen on the host with Chrome 145: it sends only `enable` and `commit` when the
+    /// focus moves to a field, and holds the rest back (content type, cursor rectangle,
+    /// surrounding text) until this side has acknowledged that commit; and after a move by Tab
+    /// it then often says the rectangle alone, the content type only after its text input was
+    /// told that it left and entered again. So:
+    ///
+    /// 1. its commit is acknowledged (`done` with nothing before it, which changes nothing);
+    /// 2. if it answers without a content type, or not within KIND_WAIT, its text input is
+    ///    told that it left the surface and entered it again, once (the keyboard is not
+    ///    touched: the page sees neither a blur nor a focus, seen), and the commit by which it
+    ///    enables itself again is acknowledged as in 1;
+    /// 3. if it still has not said one, it is left at that: the field stays a secret one for
+    ///    the device, unless the client has never said a content type at all (then it is a
+    ///    normal field, the protocol's default).
+    ///
+    /// A client that says the content type with `enable` (GTK 3 and 4, seen) is never asked.
+    pub(crate) fn text_input_kind_step(&mut self, answered: bool) {
+        let Some(focus) = self.text_inputs.focus.clone().filter(|s| s.is_alive()) else {
+            return;
+        };
+        let Some(i) = self
+            .text_inputs
+            .instances
+            .iter_mut()
+            .find(|i| i.finding_out() && i.entered.as_ref() == Some(&focus))
+        else {
+            return;
+        };
+        if i.asked == 0 {
+            i.asked = 1;
+            i.object.done(i.commits);
+        } else if !i.reentered {
+            let _ = answered;
