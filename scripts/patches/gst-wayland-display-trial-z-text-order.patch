+/// How long text waits behind a key, or a key behind text, for the client to say it has taken
+/// the one before in (its text input's next commit). Then it goes on anyway.
+const ORDER_WAIT: std::time::Duration = std::time::Duration::from_millis(100);
+
+/// Trial: keeps keys and text in the order they came, for a client whose text input is
+/// enabled. Key events and text input events travel on different objects, and a toolkit may
+/// take them in in another order (GTK 4.14 did, seen on the host: text overtook keys). So after
+/// a key press, text waits until the client commits its text input's state (or ORDER_WAIT); after
+/// text, keys and buttons wait the same way. Keys after keys and text after text never wait.
+#[derive(Default)]
+pub struct TextOrder {
+    /// What was sent last that is not taken in yet.
+    pub(crate) waiting: Option<Wait>,
+    /// Waits that ran out with something held behind them, in a row, by client and kind
+    /// (text, key): a client that does not say it took a kind in (Chrome after keys, seen) is
+    /// not held for after three, so that a backlog does not grow by 100 ms an item. It is
+    /// still watched (a probe that holds nothing): its next answer starts the count again.
+    missed: std::collections::HashMap<(ClientId, bool), u32>,
+    generation: u64,
+}
+
+/// One wait: for text (true) or a key; since when; for which client; whether it only watches
+/// for the answer (holds nothing); whether something was held behind it.
+pub(crate) struct Wait {
+    text: bool,
+    since: std::time::Instant,
+    client: Option<ClientId>,
+    probe: bool,
+    pub(crate) held: bool,
+}
+
+/// Keys that may move the focus: Tab, Return, the arrows, Home, End, Page Up and Down.
+fn moves_focus(scancode: u32) -> bool {
+    matches!(scancode, 15 | 28 | 96 | 102..=109)
+}
+
+/// Keys that do not type or edit: Escape, F1 to F12, Print, Scroll Lock, Pause.
+fn types(scancode: u32) -> bool {
+    !is_modifier(scancode) && !matches!(scancode, 1 | 59..=68 | 87 | 88 | 99 | 70 | 119)
+}
+
+fn is_modifier(scancode: u32) -> bool {
+    matches!(scancode, 29 | 42 | 54 | 56 | 58 | 97 | 100 | 125 | 126)
+}
+
+impl State {
+    /// Whether `command` has to wait (see [`TextOrder`]).
+    pub(crate) fn order_blocks(&self, command: &crate::Command) -> bool {
+        use crate::Command;
+        use smithay::backend::input::KeyState;
+        let Some(wait) = &self.text_order.waiting else {
+            return false;
+        };
+        if wait.probe || wait.since.elapsed() >= ORDER_WAIT {
+            return false;
+        }
+        let text_sent = wait.text;
+        match command {
+            Command::TextCommit(_) | Command::TextPreedit(..) => !text_sent,
+            // Presses of keys that type (not modifiers, not releases: a late release could
+            // make the client repeat the key) and button presses and releases.
+            Command::KeyboardInput(code, KeyState::Pressed) => text_sent && !is_modifier(*code),
+            Command::PointerButton(..) => text_sent,
+            _ => false,
+        }
+    }
+
+    /// Whether Control, Alt or Super is held.
+    fn chording(&self) -> bool {
+        let held = self.seat.get_keyboard().unwrap().modifier_state();
+        held.ctrl || held.alt || held.logo
+    }
+
+    /// Notes what is about to be sent, when the client with the keyboard has an enabled text
+    /// input: a key press (not a modifier) or text.
+    pub(crate) fn note_sent(&mut self, command: &crate::Command) {
+        use crate::Command;
+        use smithay::backend::input::{ButtonState, KeyState};
+        // A click or a key that may move the focus: the field is told again a little later,
+        // even when it did not change, so that the device knows its notice is newer than the
+        // move (it sends plain keys outside a field only then; ADR 0007).
+        let moves = match command {
+            Command::PointerButton(_, ButtonState::Pressed) => true,
+            Command::KeyboardInput(code, KeyState::Pressed) => !types(*code) || moves_focus(*code) || self.chording(),
+            _ => false,
+        };
+        if moves {
+            self.retell_field_soon();
+        }
+        if !matches!(self.text_inputs.field().0, 1 | 2) {
+            self.text_order.waiting = None;
+            return;
+        }
+        let text = match command {
+            Command::TextCommit(_) | Command::TextPreedit(..) => true,
+            // Only keys that type or edit: Escape, the function keys and keys with Control, Alt
+            // or Super change no text, get no answer, and have nothing to keep in order with.
+            Command::KeyboardInput(code, KeyState::Pressed) if types(*code) && !self.chording() => false,
+            _ => return,
+        };
+        let client = self.text_inputs.focus_client();
+        // A client that did not answer three times with something held: only watched.
+        let probe = client
+            .as_ref()
+            .is_some_and(|c| self.text_order.missed.get(&(c.clone(), text)).copied().unwrap_or(0) >= 3);
+        self.text_order.waiting = Some(Wait {
+            text,
+            since: std::time::Instant::now(),
+            client,
+            probe,
+            held: false,
+        });
+        self.text_order.generation += 1;
+        let generation = self.text_order.generation;
+        use smithay::reexports::calloop::timer::{TimeoutAction, Timer};
+        let _ = self.handle.insert_source(Timer::from_duration(ORDER_WAIT), move |_, _, state| {
+            if state.text_order.generation == generation {
+                if let Some(wait) = state.text_order.waiting.take() {
+                    // A miss only when it kept something waiting (a key that changes nothing,
+                    // Escape or Control+S, gets no answer and is no miss).
+                    if let (false, true, Some(client)) = (wait.probe, wait.held, wait.client) {
+                        *state.text_order.missed.entry((client, wait.text)).or_insert(0) += 1;
+                    }
+                    state.release_held();
+                }
+            }
+            TimeoutAction::Drop
+        });
+    }
+}
