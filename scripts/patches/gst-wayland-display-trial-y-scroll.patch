diff --git a/wayland-display-core/src/tests/test_trial_scroll.rs b/wayland-display-core/src/tests/test_trial_scroll.rs
new file mode 100644
index 0000000..74def00
--- /dev/null
+++ b/wayland-display-core/src/tests/test_trial_scroll.rs
@@ -0,0 +1,301 @@
+//! Integration tests for the trial's scrolls (`PointerScroll`): a wheel is told as a wheel with
+//! its notches, fingers as fingers with their pixels and a stop when the gesture is over, and
+//! the sender's inertia as more of the same scroll. A real Wayland client is told.
+
+use crate::comp::scroll::{IDLE_STOP, LOST_STOP, Momentum, ScrollFrom, ScrollInput, ScrollStage};
+use crate::tests::client::MouseEvents;
+use crate::tests::fixture::Fixture;
+use smithay::utils::Point;
+use test_log::test;
+use wayland_client::WEnum;
+use wayland_client::protocol::wl_pointer;
+
+/// A window that fills the output, with the pointer in its middle, and nothing told yet.
+fn fixture() -> Fixture {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    f.client.get_client_events().clear();
+    f
+}
+
+fn axis_name(axis: &WEnum<wl_pointer::Axis>) -> &'static str {
+    match axis {
+        WEnum::Value(wl_pointer::Axis::HorizontalScroll) => "h",
+        WEnum::Value(wl_pointer::Axis::VerticalScroll) => "v",
+        _ => "?",
+    }
+}
+
+/// What the client was told about scrolling since the last time, in words, and forgets it.
+fn told(f: &mut Fixture) -> Vec<String> {
+    f.round_trip();
+    let said = f
+        .client
+        .get_client_events()
+        .drain(..)
+        .filter_map(|event| match event {
+            MouseEvents::Pointer(wl_pointer::Event::AxisSource { axis_source }) => {
+                Some(match axis_source {
+                    WEnum::Value(wl_pointer::AxisSource::Wheel) => "wheel".to_string(),
+                    WEnum::Value(wl_pointer::AxisSource::Finger) => "finger".to_string(),
+                    other => format!("source {other:?}"),
+                })
+            }
+            MouseEvents::Pointer(wl_pointer::Event::Axis { axis, value, .. }) => {
+                Some(format!("{} {value}", axis_name(&axis)))
+            }
+            MouseEvents::Pointer(wl_pointer::Event::AxisValue120 { axis, value120 }) => {
+                Some(format!("{} notches {value120}", axis_name(&axis)))
+            }
+            MouseEvents::Pointer(wl_pointer::Event::AxisStop { axis, .. }) => {
+                Some(format!("stop {}", axis_name(&axis)))
+            }
+            MouseEvents::Pointer(wl_pointer::Event::Frame) => Some("frame".to_string()),
+            _ => None,
+        })
+        .collect();
+    said
+}
+
+fn wheel(h: i32, v: i32) -> ScrollInput {
+    ScrollInput {
+        from: ScrollFrom::Wheel,
+        x: 0.0,
+        y: 0.0,
+        v120: (h, v),
+        phase: ScrollStage::None,
+        momentum: ScrollStage::None,
+        momentum_follows: false,
+    }
+}
+
+fn fingers(x: f64, y: f64, phase: ScrollStage) -> ScrollInput {
+    ScrollInput {
+        from: ScrollFrom::Finger,
+        x,
+        y,
+        v120: (0, 0),
+        phase,
+        momentum: ScrollStage::None,
+        momentum_follows: false,
+    }
+}
+
+/// The fingers have left; `follows`: the sender says its inertia follows.
+fn ended(follows: bool) -> ScrollInput {
+    ScrollInput {
+        momentum_follows: follows,
+        ..fingers(0.0, 0.0, ScrollStage::Ended)
+    }
+}
+
+fn inertia(y: f64, momentum: ScrollStage) -> ScrollInput {
+    ScrollInput {
+        momentum,
+        ..fingers(0.0, y, ScrollStage::None)
+    }
+}
+
+#[test]
+fn a_wheel_is_told_as_a_wheel_with_its_notches() {
+    let mut f = fixture();
+    f.server.pointer_scroll(1, wheel(0, 120));
+    assert_eq!(told(&mut f), ["wheel", "v notches 120", "v 10", "frame"]);
+    // Parts of a notch, and to the left.
+    f.server.pointer_scroll(2, wheel(-60, 0));
+    assert_eq!(told(&mut f), ["wheel", "h notches -60", "h -5", "frame"]);
+    // No notch: nothing.
+    f.server.pointer_scroll(3, wheel(0, 0));
+    assert!(told(&mut f).is_empty());
+}
+
+#[test]
+fn fingers_are_told_as_fingers_and_the_inertia_of_the_sender_as_more_of_them() {
+    let mut f = fixture();
+    f.server
+        .pointer_scroll(1, fingers(0.0, 0.0, ScrollStage::Began));
+    assert!(told(&mut f).is_empty());
+    f.server
+        .pointer_scroll(2, fingers(0.0, 5.5, ScrollStage::Changed));
+    f.server
+        .pointer_scroll(3, fingers(-1.25, 3.0, ScrollStage::Changed));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger", "v 5.5", "frame", "finger", "h -1.25", "v 3", "frame"
+        ]
+    );
+    // The fingers leave, and the sender says that its inertia follows: no stop in between,
+    // however long the inertia takes to come (within the wait for a lost end).
+    f.server.pointer_scroll(4, ended(true));
+    std::thread::sleep(LOST_STOP / 2);
+    assert!(told(&mut f).is_empty());
+    f.server
+        .pointer_scroll(5, inertia(24.0, ScrollStage::Began));
+    f.server
+        .pointer_scroll(6, inertia(6.0, ScrollStage::Changed));
+    assert_eq!(
+        told(&mut f),
+        ["finger", "v 24", "frame", "finger", "v 6", "frame"]
+    );
+    f.server.pointer_scroll(7, inertia(0.0, ScrollStage::Ended));
+    assert_eq!(told(&mut f), ["finger", "stop h", "stop v", "frame"]);
+    // Nothing more after it.
+    std::thread::sleep(LOST_STOP + LOST_STOP / 4);
+    assert!(told(&mut f).is_empty());
+}
+
+#[test]
+fn without_inertia_the_stop_comes_as_the_fingers_leave() {
+    let mut f = fixture();
+    f.server
+        .pointer_scroll(1, fingers(0.0, 0.0, ScrollStage::Began));
+    f.server
+        .pointer_scroll(2, fingers(0.0, 8.0, ScrollStage::Changed));
+    f.server.pointer_scroll(3, ended(false));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger", "v 8", "frame", "finger", "stop h", "stop v", "frame"
+        ]
+    );
+    // A gesture cancelled by the system stops at once.
+    f.server
+        .pointer_scroll(4, fingers(0.0, 2.0, ScrollStage::Began));
+    f.server
+        .pointer_scroll(5, fingers(0.0, 0.0, ScrollStage::Cancelled));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger", "v 2", "frame", "finger", "stop h", "stop v", "frame"
+        ]
+    );
+}
+
+#[test]
+fn a_finger_scroll_whose_end_is_lost_stops_a_moment_after_its_last_value() {
+    let mut f = fixture();
+    // The end never comes (the viewer's picture was being reconnected, say).
+    f.server
+        .pointer_scroll(1, fingers(0.0, 8.0, ScrollStage::Changed));
+    std::thread::sleep(LOST_STOP / 2);
+    f.server
+        .pointer_scroll(2, fingers(0.0, 4.0, ScrollStage::Changed));
+    std::thread::sleep(LOST_STOP / 2);
+    assert_eq!(
+        told(&mut f),
+        ["finger", "v 8", "frame", "finger", "v 4", "frame"]
+    );
+    std::thread::sleep(LOST_STOP / 2 + LOST_STOP / 4);
+    assert_eq!(told(&mut f), ["finger", "stop h", "stop v", "frame"]);
+    // Nor when the inertia was said to follow and never came, or stopped coming.
+    f.server
+        .pointer_scroll(3, fingers(0.0, 8.0, ScrollStage::Changed));
+    f.server.pointer_scroll(4, ended(true));
+    f.server
+        .pointer_scroll(5, inertia(6.0, ScrollStage::Changed));
+    assert_eq!(
+        told(&mut f),
+        ["finger", "v 8", "frame", "finger", "v 6", "frame"]
+    );
+    std::thread::sleep(LOST_STOP + LOST_STOP / 4);
+    assert_eq!(told(&mut f), ["finger", "stop h", "stop v", "frame"]);
+}
