diff --git a/wayland-display-core/src/comp/scroll.rs b/wayland-display-core/src/comp/scroll.rs
new file mode 100644
index 0000000..25120e6
--- /dev/null
+++ b/wayland-display-core/src/comp/scroll.rs
@@ -0,0 +1,250 @@
+//! Trial only (the patch gst-wayland-display-trial-y-scroll): scrolls that say what scrolled and
+//! where the gesture is, from the custom upstream event `PointerScroll` (Istesso's ADR 0007,
+//! "スクロールの種類と段階").
+//!
+//! - A wheel is told as a wheel: `axis_value120` with the notches as they came (120 to a
+//!   notch), and an axis value of [`WHEEL_STEP`] to a notch, as GNOME's own compositor tells a
+//!   wheel of the desk.
+//! - Fingers are told as fingers (`axis_source.finger`), the pixels (the picture's, divided by
+//!   the output's scale: the application's logical pixels) as the axis value, and an
+//!   `axis_stop` when the gesture is over, which is when an application may go on scrolling by
+//!   itself (inertia).
+//! - The inertia the sender's own system adds after the fingers have left (macOS does) is passed
+//!   on as more of the same finger scroll, and the stop comes when it ends. Whether inertia
+//!   follows is said by the sender with the end of the gesture (`momentum-follows`): the sender
+//!   waits for its system's inertia itself, so that no jitter of the network decides it. With
+//!   `ISTESSO_SCROLL_MOMENTUM=app` the sender's inertia is dropped and the stop comes as the
+//!   fingers leave: the application makes its own, as with a touchpad of the desk.
+//! - Fingers whose sender gives no stages: the stop comes when nothing has come for
+//!   [`IDLE_STOP`].
+//! - Whatever the stages, a finger scroll whose end never comes (lost on the way: the sender's
+//!   picture was being reconnected, its input was) stops [`LOST_STOP`] after its last value.
+//!
+//! The old `MouseAxis` is not changed.
+
+use crate::comp::State;
+use smithay::backend::input::{Axis, AxisSource};
+use smithay::input::pointer::AxisFrame;
+use smithay::reexports::calloop::RegistrationToken;
+use smithay::reexports::calloop::timer::{TimeoutAction, Timer};
+use std::time::Duration;
+
+/// The axis value of one notch of a wheel.
+pub const WHEEL_STEP: f64 = 10.0;
+/// How long after the last value of a finger scroll its end may take to come, before the stop is
+/// told anyway.
+pub const LOST_STOP: Duration = Duration::from_millis(400);
+/// How long after the last scroll of fingers without stages the gesture counts as over.
+pub const IDLE_STOP: Duration = Duration::from_millis(100);
+
+/// What scrolled.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ScrollFrom {
+    Wheel,
+    Finger,
+}
+
+/// Where a gesture, or the inertia after it, is.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum ScrollStage {
+    None,
+    Began,
+    Changed,
+    Ended,
+    Cancelled,
+}
+
+impl ScrollStage {
+    /// The stage a `PointerScroll` names; one this does not know moves and ends nothing.
+    pub fn named(name: &str) -> ScrollStage {
+        match name {
+            "none" | "" => ScrollStage::None,
+            "began" => ScrollStage::Began,
+            "ended" => ScrollStage::Ended,
+            "cancelled" => ScrollStage::Cancelled,
+            _ => ScrollStage::Changed,
+        }
+    }
+}
+
+/// One scroll of the `PointerScroll` event.
+#[derive(Debug, Clone, Copy, PartialEq)]
+pub struct ScrollInput {
+    pub from: ScrollFrom,
+    /// Fingers: pixels to the right and down.
+    pub x: f64,
+    pub y: f64,
+    /// A wheel: 120ths of a notch to the right and down.
+    pub v120: (i32, i32),
+    pub phase: ScrollStage,
+    pub momentum: ScrollStage,
+    /// With the end of the gesture: the sender's inertia follows.
+    pub momentum_follows: bool,
+}
+
+/// What is done with the inertia of the sender.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Momentum {
+    /// Passed on, as more of the finger scroll (the default).
+    Sender,
+    /// Dropped: the application makes its own.
+    App,
+}
+
+impl Momentum {
+    fn from_environment() -> Momentum {
+        match std::env::var("ISTESSO_SCROLL_MOMENTUM").as_deref() {
+            Ok("app") => Momentum::App,
+            _ => Momentum::Sender,
+        }
+    }
+}
+
+/// The compositor's part of the finger scroll that is going on.
+#[derive(Debug, Default)]
+pub struct Scrolling {
+    /// Values of fingers have been told that no stop has followed yet.
+    open: bool,
+    /// The timer that will tell the stop.
+    stop_timer: Option<RegistrationToken>,
+    /// Read from the environment at the first scroll; tests set it.
+    pub(crate) momentum: Option<Momentum>,
+}
+
+impl State {
+    /// One scroll of the `PointerScroll` event.
+    pub fn pointer_scroll(&mut self, time: u32, input: ScrollInput) {
+        let momentum = *self.scrolling.momentum.get_or_insert_with(|| {
+            let momentum = Momentum::from_environment();
+            tracing::info!(
+                ?momentum,
+                "trial scroll: wheels as wheels, fingers as fingers"
+            );
+            momentum
+        });
+        match input.from {
+            ScrollFrom::Wheel => {
+                // A wheel ends a finger scroll that is still open.
+                self.finish_finger_scroll(time);
+                let (h, v) = input.v120;
+                if h == 0 && v == 0 {
+                    return;
+                }
+                let mut frame = AxisFrame::new(time).source(AxisSource::Wheel);
+                for (axis, notches) in [(Axis::Horizontal, h), (Axis::Vertical, v)] {
+                    if notches != 0 {
+                        frame = frame
+                            .value(axis, notches as f64 / 120.0 * WHEEL_STEP)
+                            .v120(axis, notches);
+                    }
+                }
+                self.tell_axis(frame);
+            }
+            ScrollFrom::Finger if input.momentum != ScrollStage::None => {
+                if momentum == Momentum::App {
+                    return;
+                }
+                self.finger_values(time, input.x, input.y);
+                if matches!(input.momentum, ScrollStage::Ended | ScrollStage::Cancelled) {
+                    self.finish_finger_scroll(time);
+                } else {
+                    self.stop_scroll_in(LOST_STOP);
+                }
+            }
+            ScrollFrom::Finger => match input.phase {
+                ScrollStage::Began => {
+                    // A new gesture: the one before is over.
+                    self.finish_finger_scroll(time);
+                    self.finger_values(time, input.x, input.y);
+                    self.stop_scroll_in(LOST_STOP);
+                }
+                ScrollStage::Changed => {
+                    self.finger_values(time, input.x, input.y);
+                    self.stop_scroll_in(LOST_STOP);
+                }
+                ScrollStage::Ended => {
+                    self.finger_values(time, input.x, input.y);
+                    // The sender says whether its inertia follows (it waits for it itself,
+                    // where there is no jitter of the network).
+                    if input.momentum_follows && momentum == Momentum::Sender {
+                        self.stop_scroll_in(LOST_STOP);
+                    } else {
+                        self.finish_finger_scroll(time);
+                    }
+                }
+                ScrollStage::Cancelled => {
+                    self.finger_values(time, input.x, input.y);
+                    self.finish_finger_scroll(time);
+                }
+                ScrollStage::None => {
+                    self.finger_values(time, input.x, input.y);
+                    self.stop_scroll_in(IDLE_STOP);
+                }
+            },
+        }
+    }
+
+    fn finger_values(&mut self, time: u32, x: f64, y: f64) {
+        if x == 0.0 && y == 0.0 {
+            return;
+        }
+        // The sender's pixels are the picture's; an application counts in the output's logical
+        // pixels, of which there are fewer when the output is scaled up.
+        let scale = self
+            .output
+            .as_ref()
+            .map(|output| output.current_scale().fractional_scale())
+            .filter(|scale| *scale > 0.0)
+            .unwrap_or(1.0);
+        let (x, y) = (x / scale, y / scale);
+        let mut frame = AxisFrame::new(time).source(AxisSource::Finger);
+        for (axis, value) in [(Axis::Horizontal, x), (Axis::Vertical, y)] {
+            if value != 0.0 {
+                frame = frame.value(axis, value);
+            }
+        }
+        self.tell_axis(frame);
+        self.scrolling.open = true;
+    }
+
+    /// Tells the stop of the finger scroll that is open, if one is.
+    pub(crate) fn finish_finger_scroll(&mut self, time: u32) {
+        self.cancel_scroll_stop();
+        if !std::mem::take(&mut self.scrolling.open) {
+            return;
+        }
+        let frame = AxisFrame::new(time)
+            .source(AxisSource::Finger)
+            .stop(Axis::Horizontal)
+            .stop(Axis::Vertical);
+        self.tell_axis(frame);
+    }
+
+    fn stop_scroll_in(&mut self, wait: Duration) {
+        self.cancel_scroll_stop();
+        if !self.scrolling.open {
+            return;
+        }
+        self.scrolling.stop_timer = self
+            .handle
+            .insert_source(Timer::from_duration(wait), |_, _, state| {
+                state.scrolling.stop_timer = None;
+                let time: Duration = state.clock.now().into();
+                state.finish_finger_scroll(time.as_millis() as u32);
+                TimeoutAction::Drop
+            })
+            .ok();
+    }
+
+    fn cancel_scroll_stop(&mut self) {
+        if let Some(token) = self.scrolling.stop_timer.take() {
+            self.handle.remove(token);
+        }
+    }
+
+    fn tell_axis(&mut self, frame: AxisFrame) {
+        let pointer = self.seat.get_pointer().unwrap();
+        pointer.axis(self, frame);
+        pointer.frame(self);
+    }
+}
