+#[test]
+fn fingers_without_stages_stop_when_nothing_more_comes() {
+    let mut f = fixture();
+    f.server
+        .pointer_scroll(1, fingers(0.0, 3.0, ScrollStage::None));
+    std::thread::sleep(IDLE_STOP / 2);
+    f.server
+        .pointer_scroll(2, fingers(0.0, 3.0, ScrollStage::None));
+    std::thread::sleep(IDLE_STOP / 2);
+    assert_eq!(
+        told(&mut f),
+        ["finger", "v 3", "frame", "finger", "v 3", "frame"]
+    );
+    std::thread::sleep(IDLE_STOP);
+    assert_eq!(told(&mut f), ["finger", "stop h", "stop v", "frame"]);
+}
