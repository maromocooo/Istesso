+#[test]
+fn when_the_application_makes_its_own_inertia_the_senders_is_dropped() {
+    let mut f = fixture();
+    f.server.scrolling.momentum = Some(Momentum::App);
+    f.server
+        .pointer_scroll(1, fingers(0.0, 8.0, ScrollStage::Changed));
+    f.server.pointer_scroll(2, ended(true));
+    f.server
+        .pointer_scroll(3, inertia(24.0, ScrollStage::Began));
+    f.server.pointer_scroll(4, inertia(0.0, ScrollStage::Ended));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger", "v 8", "frame", "finger", "stop h", "stop v", "frame"
+        ]
+    );
+}
