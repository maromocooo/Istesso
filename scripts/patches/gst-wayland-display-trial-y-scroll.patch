+#[test]
+fn a_new_gesture_or_a_wheel_ends_the_finger_scroll_that_is_open() {
+    let mut f = fixture();
+    f.server
+        .pointer_scroll(1, fingers(0.0, 8.0, ScrollStage::Changed));
+    f.server.pointer_scroll(2, ended(true));
+    f.server
+        .pointer_scroll(3, fingers(0.0, 4.0, ScrollStage::Began));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger", "v 8", "frame", "finger", "stop h", "stop v", "frame", "finger", "v 4",
+            "frame"
+        ]
+    );
+    f.server.pointer_scroll(4, wheel(0, 120));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger",
+            "stop h",
+            "stop v",
+            "frame",
+            "wheel",
+            "v notches 120",
+            "v 10",
+            "frame"
+        ]
+    );
+    // The stop that was waiting does not come again.
+    std::thread::sleep(LOST_STOP + LOST_STOP / 4);
+    assert!(told(&mut f).is_empty());
+}
