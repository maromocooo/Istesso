+#[test]
+fn fingers_move_the_same_distance_on_an_output_scaled_up() {
+    let mut f = fixture();
+    let output = f.server.output.clone().unwrap();
+    output.change_current_state(None, None, Some(smithay::output::Scale::Integer(2)), None);
+    f.server
+        .pointer_scroll(1, fingers(0.0, 8.0, ScrollStage::Changed));
+    // Eight pixels of the picture are four logical pixels of the application.
+    assert_eq!(told(&mut f), ["finger", "v 4", "frame"]);
+    // A wheel's notches are not scaled.
+    f.server.pointer_scroll(2, wheel(0, 120));
+    assert_eq!(
+        told(&mut f),
+        [
+            "finger",
+            "stop h",
+            "stop v",
+            "frame",
+            "wheel",
+            "v notches 120",
+            "v 10",
+            "frame"
+        ]
+    );
+}
