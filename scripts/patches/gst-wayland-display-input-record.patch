index 0000000..83e7b72
--- /dev/null
+++ b/wayland-display-core/src/comp/input_record.rs
@@ -0,0 +1,237 @@
+//! A record of the input the compositor was given, and of the modifier state it then holds,
+//! for finding a fault by looking. Off unless the environment names a file:
+//!
+//!     ISTESSO_COMPOSITOR_INPUT_RECORD=/path/to/file
+//!
+//! One JSON line for each key, button and scroll, added to the file. A modifier key is named;
+//! which key any other key was is never written down: such a line says "key" and nothing more,
+//! so that what is typed cannot be read back. No pointer position is written down.
+//!
+//!     {"t_ns":…,"kind":"modifier","name":"shift_l","state":"down","depressed":1,"latched":0,"locked":0,"held":["shift"],"focus":true}
+//!     {"t_ns":…,"kind":"key","name":"key","state":"down","depressed":1,"latched":0,"locked":0,"held":["shift"],"focus":true}
+//!
+//! "depressed", "latched" and "locked" are the numbers a `wl_keyboard.modifiers` event carries,
+//! after the line's own key; "focus" says whether a window has the keyboard, which is when a key
+//! is passed on at all.
+
+use std::fs::{File, OpenOptions};
+use std::io::Write;
+use std::os::unix::fs::OpenOptionsExt;
+use std::sync::{Mutex, OnceLock};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+/// The keys that are named, by Linux's number for them (linux/input-event-codes.h). Every
+/// other key is "key".
+const MODIFIERS: [(u32, &str); 10] = [
+    (42, "shift_l"),
+    (54, "shift_r"),
+    (29, "ctrl_l"),
+    (97, "ctrl_r"),
+    (56, "alt_l"),
+    (100, "alt_r"),
+    (125, "super_l"),
+    (126, "super_r"),
+    (58, "caps_lock"),
+    (69, "num_lock"),
+];
+
+const HEADER: &str = "{\"kind\":\"header\",\"record\":\"compositor\",\"version\":1,\"note\":\"keys other than modifiers are never identified: such a line says key and not which; no pointer position is recorded\"}";
+
+/// The keyboard's modifier state at the moment of a line, in plain values.
+pub(crate) struct Mods {
+    pub depressed: u32,
+    pub latched: u32,
+    pub locked: u32,
+    pub shift: bool,
+    pub ctrl: bool,
+    pub alt: bool,
+    pub logo: bool,
+    pub caps_lock: bool,
+    pub num_lock: bool,
+    /// A window has the keyboard.
+    pub focus: bool,
+}
+
+fn key_name(code: u32) -> &'static str {
+    MODIFIERS
+        .iter()
+        .find(|(modifier, _)| *modifier == code)
+        .map_or("key", |(_, name)| name)
+}
+
+fn button_name(code: u32) -> &'static str {
+    match code {
+        0x110 => "left",
+        0x111 => "right",
+        0x112 => "middle",
+        0x113 => "side",
+        0x114 => "extra",
+        _ => "other",
+    }
+}
+
+fn state_name(pressed: bool) -> &'static str {
+    if pressed { "down" } else { "up" }
+}
+
+fn mods_fields(mods: &Mods) -> String {
+    let held: Vec<&str> = [
+        (mods.shift, "\"shift\""),
+        (mods.ctrl, "\"ctrl\""),
+        (mods.alt, "\"alt\""),
+        (mods.logo, "\"super\""),
+        (mods.caps_lock, "\"caps_lock\""),
+        (mods.num_lock, "\"num_lock\""),
+    ]
+    .iter()
+    .filter(|(on, _)| *on)
+    .map(|(_, name)| *name)
+    .collect();
+    format!(
+        "\"depressed\":{},\"latched\":{},\"locked\":{},\"held\":[{}],\"focus\":{}",
+        mods.depressed,
+        mods.latched,
+        mods.locked,
+        held.join(","),
+        mods.focus
+    )
+}
+
+fn key_line(t_ns: u128, code: u32, pressed: bool, mods: &Mods) -> String {
+    let name = key_name(code);
+    let kind = if name == "key" { "key" } else { "modifier" };
+    format!(
+        "{{\"t_ns\":{t_ns},\"kind\":\"{kind}\",\"name\":\"{name}\",\"state\":\"{}\",{}}}",
+        state_name(pressed),
+        mods_fields(mods)
+    )
+}
+
+fn button_line(t_ns: u128, code: u32, pressed: bool, mods: &Mods) -> String {
+    format!(
+        "{{\"t_ns\":{t_ns},\"kind\":\"button\",\"name\":\"{}\",\"state\":\"{}\",{}}}",
+        button_name(code),
+        state_name(pressed),
+        mods_fields(mods)
+    )
+}
+
+fn scroll_line(t_ns: u128, dx: f64, dy: f64, mods: &Mods) -> String {
+    let amount = |value: f64| if value.is_finite() { value } else { 0.0 };
+    let name = match (dx != 0.0, dy != 0.0) {
+        (true, true) => "both",
+        (true, false) => "horizontal",
+        _ => "vertical",
+    };
+    format!(
+        "{{\"t_ns\":{t_ns},\"kind\":\"scroll\",\"name\":\"{name}\",\"dx\":{:.3},\"dy\":{:.3},{}}}",
+        amount(dx),
+        amount(dy),
+        mods_fields(mods)
+    )
+}
+
+/// The file, opened the first time it is asked for. `None` when the environment names none or
+/// it cannot be opened: then nothing is written and nothing is said.
+fn file() -> Option<&'static Mutex<File>> {
+    static FILE: OnceLock<Option<Mutex<File>>> = OnceLock::new();
+    FILE.get_or_init(|| {
+        let path = std::env::var_os("ISTESSO_COMPOSITOR_INPUT_RECORD")?;
+        let mut file = OpenOptions::new()
+            .create(true)
+            .append(true)
+            .mode(0o600) // its owner's only
+            .open(path)
+            .ok()?;
+        writeln!(file, "{HEADER}").ok()?;
+        Some(Mutex::new(file))
+    })
+    .as_ref()
+}
+
+fn now_ns() -> u128 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map_or(0, |since| since.as_nanos())
+}
+
+fn write(line: String) {
+    let Some(file) = file() else { return };
+    let Ok(mut file) = file.lock() else { return };
+    let _ = writeln!(file, "{line}");
+}
+
+/// Whether a record is being written. The callers ask first, so that nothing is put together
+/// for a record that is off.
+pub(crate) fn on() -> bool {
+    file().is_some()
+}
+
+pub(crate) fn key(code: u32, pressed: bool, mods: &Mods) {
+    write(key_line(now_ns(), code, pressed, mods));
+}
+
+pub(crate) fn button(code: u32, pressed: bool, mods: &Mods) {
+    write(button_line(now_ns(), code, pressed, mods));
+}
+
+pub(crate) fn scroll(dx: f64, dy: f64, mods: &Mods) {
+    write(scroll_line(now_ns(), dx, dy, mods));
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn mods(depressed: u32, shift: bool) -> Mods {
+        Mods {
+            depressed,
+            latched: 0,
+            locked: 0,
+            shift,
+            ctrl: false,
+            alt: false,
+            logo: false,
+            caps_lock: false,
+            num_lock: false,
+            focus: true,
+        }
+    }
+
+    #[test]
+    fn the_named_keys_are_the_ten_modifiers_and_no_other() {
+        let named: Vec<u32> = (0..768).filter(|code| key_name(*code) != "key").collect();
+        assert_eq!(named, vec![29, 42, 54, 56, 58, 69, 97, 100, 125, 126]);
+        assert_eq!(key_name(42), "shift_l");
+        assert_eq!(key_name(100), "alt_r");
+    }
+
+    #[test]
+    fn a_line_is_the_same_whichever_key_it_was() {
+        let expected = key_line(7, 30, true, &mods(1, true));
+        assert_eq!(
+            expected,
+            "{\"t_ns\":7,\"kind\":\"key\",\"name\":\"key\",\"state\":\"down\",\"depressed\":1,\"latched\":0,\"locked\":0,\"held\":[\"shift\"],\"focus\":true}"
+        );
+        for code in (0..768).filter(|code| key_name(*code) == "key") {
+            assert_eq!(key_line(7, code, true, &mods(1, true)), expected);
+        }
+    }
+
+    #[test]
+    fn a_modifier_a_button_and_a_scroll() {
+        assert_eq!(
+            key_line(1, 42, true, &mods(1, true)),
+            "{\"t_ns\":1,\"kind\":\"modifier\",\"name\":\"shift_l\",\"state\":\"down\",\"depressed\":1,\"latched\":0,\"locked\":0,\"held\":[\"shift\"],\"focus\":true}"
+        );
+        assert_eq!(
+            button_line(2, 0x110, false, &mods(0, false)),
+            "{\"t_ns\":2,\"kind\":\"button\",\"name\":\"left\",\"state\":\"up\",\"depressed\":0,\"latched\":0,\"locked\":0,\"held\":[],\"focus\":true}"
+        );
+        assert_eq!(
+            scroll_line(3, 0.0, -15.0, &mods(1, true)),
+            "{\"t_ns\":3,\"kind\":\"scroll\",\"name\":\"vertical\",\"dx\":0.000,\"dy\":-15.000,\"depressed\":1,\"latched\":0,\"locked\":0,\"held\":[\"shift\"],\"focus\":true}"
+        );
+        assert!(scroll_line(4, f64::NAN, 1.0, &mods(0, false)).contains("\"dx\":0.000"));
+    }
+}
