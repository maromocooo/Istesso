new file mode 100644
index 0000000..0ded101
--- /dev/null
+++ b/wayland-display-core/src/tests/test_cursor.rs
@@ -0,0 +1,173 @@
+//! Integration tests for the cursor that is told to a sink instead of drawn into the frames
+//! (see `comp::cursor`). A real Wayland client sets the cursor, so that a failure here says
+//! that what clients do no longer reaches the sink.
+
+use crate::comp::cursor::{Cursor, CursorSink};
+use crate::tests::fixture::Fixture;
+use smithay::utils::Point;
+use std::sync::{Arc, Mutex};
+use test_log::test;
+
+type Told = Arc<Mutex<Vec<Cursor>>>;
+
+/// A window under the pointer, and somebody who is told about the cursor.
+fn fixture() -> (Fixture, Told) {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    let told = listen(&mut f);
+    (f, told)
+}
+
+fn listen(f: &mut Fixture) -> Told {
+    let told = Told::default();
+    let sink: CursorSink = {
+        let told = told.clone();
+        Box::new(move |cursor| told.lock().unwrap().push(cursor.clone()))
+    };
+    f.server.set_cursor_sink(Some(sink));
+    told
+}
+
+fn last(told: &Told) -> Cursor {
+    told.lock().unwrap().last().cloned().expect("nothing told")
+}
+
+/// The part of a frame around the middle of the picture, where the tests keep the pointer.
+fn middle_of_a_frame(f: &mut Fixture) -> Vec<u8> {
+    let (frame, _) = f.server.create_frame().expect("no frame");
+    let frame = frame.map_readable().expect("frame cannot be read");
+    let (width, bytes) = (320, frame.as_slice());
+    assert_eq!(bytes.len(), 320 * 240 * 4);
+    (120..184)
+        .flat_map(|row| bytes[(row * width + 160) * 4..(row * width + 224) * 4].to_vec())
+        .collect()
+}
+
+#[test]
+fn a_new_listener_is_told_the_cursor_as_it_is() {
+    let (_f, told) = fixture();
+    // No client has set a cursor: it is the one a pointer starts with, and there is no
+    // image of it to pass on.
+    assert_eq!(*told.lock().unwrap(), [Cursor::Named("default".into())]);
+}
+
+#[test]
+fn a_cursor_a_client_sets_is_told_with_its_image_and_hot_spot() {
+    let (mut f, told) = fixture();
+    // Blue 10, green 20, red 30, alpha 40, as the client's memory holds it.
+    f.client.set_cursor((24, 16), (3, 5), [10, 20, 30, 40]);
+    f.round_trip();
+    let Cursor::Image(image) = last(&told) else {
+        panic!("not an image: {:?}", last(&told));
+    };
+    assert_eq!((image.width, image.height, image.scale), (24, 16, 1));
+    assert_eq!((image.hotspot_x, image.hotspot_y), (3, 5));
+    assert_eq!(image.rgba.len(), 24 * 16 * 4);
+    assert!(image.rgba.chunks(4).all(|pixel| pixel == [30, 20, 10, 40]));
+}
+
+#[test]
+fn a_new_image_is_told_and_the_same_cursor_is_not_told_twice() {
+    let (mut f, told) = fixture();
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    let after_the_first = told.lock().unwrap().len();
+    assert!(matches!(last(&told), Cursor::Image(_)));
+
+    // The same picture again, as an application does that sets its cursor on every motion.
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    assert_eq!(told.lock().unwrap().len(), after_the_first);
+
+    // Another picture on the same surface: the text cursor instead of the arrow.
+    f.client.set_cursor((16, 16), (8, 8), [255, 0, 0, 255]);
+    f.round_trip();
+    let Cursor::Image(image) = last(&told) else {
+        panic!("not an image: {:?}", last(&told));
+    };
+    assert_eq!((image.hotspot_x, image.hotspot_y), (8, 8));
+    assert_eq!(&image.rgba[..4], [0, 0, 255, 255]);
+    assert!(told.lock().unwrap().len() > after_the_first);
+}
+
+#[test]
+fn a_cursor_a_client_hides_is_told_as_hidden() {
+    let (mut f, told) = fixture();
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    f.client.hide_cursor();
+    f.round_trip();
+    assert_eq!(last(&told), Cursor::Hidden);
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    assert!(matches!(last(&told), Cursor::Image(_)));
+}
+
+#[test]
+fn an_image_that_is_too_large_or_has_its_hot_spot_outside_is_told_without_an_image() {
+    let (mut f, told) = fixture();
+    f.client.set_cursor((300, 300), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    assert_eq!(last(&told), Cursor::Named("default".into()));
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    assert!(matches!(last(&told), Cursor::Image(_)));
+    f.client.set_cursor((16, 16), (16, 3), [0, 0, 255, 255]);
+    f.round_trip();
+    assert_eq!(last(&told), Cursor::Named("default".into()));
+}
+
+#[test]
+fn nobody_is_told_unless_somebody_asked() {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    f.client.set_cursor((16, 16), (0, 0), [0, 0, 255, 255]);
+    f.round_trip();
+    // Somebody who starts to listen later is told what the cursor is by then.
+    let told = listen(&mut f);
+    assert_eq!(told.lock().unwrap().len(), 1);
+    assert!(matches!(last(&told), Cursor::Image(_)));
+    // And is told nothing more once it has stopped listening.
+    f.server.set_cursor_sink(None);
+    f.client.hide_cursor();
+    f.round_trip();
+    assert_eq!(told.lock().unwrap().len(), 1);
+}
+
+#[test]
+fn the_cursor_is_in_the_frames_only_while_nobody_is_told_about_it() {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    // A cursor that cannot be overlooked: opaque white, with its corner on the pointer.
+    f.client.set_cursor((32, 32), (0, 0), [255, 255, 255, 255]);
+    f.round_trip();
+
+    let with_the_cursor = middle_of_a_frame(&mut f);
+    assert!(with_the_cursor[..4] == [255, 255, 255, 255]);
+
+    let _told = listen(&mut f);
+    let without = middle_of_a_frame(&mut f);
+    assert_ne!(with_the_cursor, without);
+    assert!(without[..4] != [255, 255, 255, 255]);
+    // Where the pointer is no longer matters to the picture.
+    f.server
+        .pointer_motion_absolute(0, Point::from((170.0, 130.0)));
+    f.round_trip();
+    assert_eq!(middle_of_a_frame(&mut f), without);
+
+    // Nobody listens any more: the cursor is back in the frames, where the pointer is now.
+    f.server.set_cursor_sink(None);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    assert_eq!(middle_of_a_frame(&mut f), with_the_cursor);
+}
