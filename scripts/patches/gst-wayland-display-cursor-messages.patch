@@ -0,0 +1,379 @@
+//! The cursor, told to whoever shows the picture instead of drawn into it.
+//!
+//! A picture that travels takes time to arrive, and a cursor that is part of it trails the
+//! hand by that time. Whoever shows the picture knows where its own pointer is at once, and
+//! can draw the cursor there itself, if it is told what the cursor looks like. With a sink
+//! set ([`CursorReport::set_sink`]) the compositor leaves the cursor out of its frames and
+//! tells the sink whenever the cursor changes: that a client has hidden it, that it has an
+//! image (size, hot spot, pixels), or that it is one the compositor has no image of. With no
+//! sink, which is how it starts, the cursor is drawn into the frames as before.
+//!
+//! The image comes from a client, and is treated as something a stranger handed in: it is
+//! read only when the buffer is as long as its own description says it has to be, and only up
+//! to [`MAX_SIDE`] pixels a side. Anything else is told as a cursor without an image.
+
+use smithay::backend::renderer::utils::with_renderer_surface_state;
+use smithay::input::pointer::{CursorImageStatus, CursorImageSurfaceData};
+use smithay::reexports::wayland_server::Resource;
+use smithay::reexports::wayland_server::protocol::{wl_shm, wl_surface::WlSurface};
+use smithay::wayland::compositor::{SurfaceAttributes, with_states};
+use smithay::wayland::shm::with_buffer_contents;
+
+/// Most pixels a cursor's image may have along one side. Themes go up to 256.
+pub const MAX_SIDE: i32 = 256;
+/// Most buffer pixels to one pixel of the surface.
+const MAX_SCALE: i32 = 8;
+
+/// What the pointer's cursor is.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum Cursor {
+    /// The client under the pointer has hidden it.
+    Hidden,
+    /// A cursor there is no image of: the one a pointer has before a client sets its own
+    /// ("default"), or an image that could not be read. Whoever shows the picture uses a
+    /// cursor of its own.
+    Named(String),
+    Image(CursorImage),
+}
+
+/// A cursor's image, as a client drew it.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct CursorImage {
+    /// Size in pixels of the image.
+    pub width: u32,
+    pub height: u32,
+    /// The pixel of the image that lies on the pointer's position, in pixels of the image.
+    pub hotspot_x: u32,
+    pub hotspot_y: u32,
+    /// Pixels of the image to one pixel of the picture.
+    pub scale: u32,
+    /// Four bytes a pixel, red, green, blue, alpha, the colours multiplied by alpha, rows
+    /// from the top, no padding.
+    pub rgba: Vec<u8>,
+}
+
+/// Receives the cursor whenever it changes. Called on the compositor's thread.
+pub type CursorSink = Box<dyn Fn(&Cursor) + Send>;
+
+/// Tells a sink about the cursor, and only when it is not what the sink was told last.
+#[derive(Default)]
+pub struct CursorReport {
+    sink: Option<CursorSink>,
+    last: Option<Cursor>,
+}
+
+impl CursorReport {
+    /// With a sink, the cursor is left out of the frames and told to the sink; with `None` it
+    /// is drawn into the frames again. A new sink is told the cursor as it is.
+    pub fn set_sink(&mut self, sink: Option<CursorSink>) {
+        self.sink = sink;
+        self.last = None;
+    }
+
+    /// Whether the cursor is told to a sink, and so not part of the frames.
+    pub fn outside_picture(&self) -> bool {
+        self.sink.is_some()
+    }
+
+    /// Tells the sink what the cursor is, unless that is what it was told last.
+    pub fn tell(&mut self, cursor: Cursor) {
+        let Some(sink) = &self.sink else {
+            return;
+        };
+        if self.last.as_ref() != Some(&cursor) {
+            sink(&cursor);
+            self.last = Some(cursor);
+        }
+    }
+}
+
+/// What a seat's cursor is, for a sink.
+pub fn describe(status: &CursorImageStatus) -> Cursor {
+    match status {
+        CursorImageStatus::Hidden => Cursor::Hidden,
+        CursorImageStatus::Named(icon) => Cursor::Named(icon.name().to_string()),
+        CursorImageStatus::Surface(surface) => {
+            from_surface(surface).unwrap_or_else(|| Cursor::Named("default".into()))
+        }
+    }
+}
+
+/// The image a client has attached to its cursor surface. `None` when there is none yet, or
+/// none that can be read: a buffer on the GPU, a format other than the two every client has,
+/// or numbers that do not fit together.
+fn from_surface(surface: &WlSurface) -> Option<Cursor> {
+    if !surface.is_alive() {
+        return None;
+    }
+    let (hotspot, scale) = with_states(surface, |states| {
+        let hotspot = states
+            .data_map
+            .get::<CursorImageSurfaceData>()
+            .map(|data| data.lock().unwrap().hotspot)
+            .unwrap_or_default();
+        let scale = states
+            .cached_state
+            .get::<SurfaceAttributes>()
+            .current()
+            .buffer_scale;
+        (hotspot, scale)
+    });
+    let buffer = with_renderer_surface_state(surface, |state| state.buffer().cloned())??;
+    with_buffer_contents(&buffer, |pool, len, data| {
+        // SAFETY: the pool is mapped, `len` bytes long, for as long as this closure runs.
+        let pool = unsafe { std::slice::from_raw_parts(pool, len) };
+        image_from_pixels(
+            pool,
+            Layout {
+                offset: data.offset,
+                width: data.width,
+                height: data.height,
+                stride: data.stride,
+                alpha: match data.format {
+                    wl_shm::Format::Argb8888 => Some(true),
+                    wl_shm::Format::Xrgb8888 => Some(false),
+                    _ => None,
+                },
+            },
+            (hotspot.x, hotspot.y),
+            scale,
+        )
+    })
+    .ok()?
+    .map(Cursor::Image)
+}
+
+/// How a client says its pixels lie in its memory: none of it is to be believed unchecked.
+#[derive(Debug, Clone, Copy)]
+pub(crate) struct Layout {
+    pub offset: i32,
+    pub width: i32,
+    pub height: i32,
+    pub stride: i32,
+    /// Whether the fourth byte of a pixel is its alpha (`Some(true)`), is to be ignored
+    /// (`Some(false)`), or the pixels are in a format this does not read (`None`).
+    pub alpha: Option<bool>,
+}
+
+/// Reads a cursor's image out of a client's memory. The pixels are four bytes each, blue,
+/// green, red and alpha or padding (the two formats every Wayland client can use). `hotspot`
+/// is in pixels of the surface, `scale` the buffer's pixels to one of the surface's.
+pub(crate) fn image_from_pixels(
+    pool: &[u8],
+    layout: Layout,
+    hotspot: (i32, i32),
+    scale: i32,
+) -> Option<CursorImage> {
+    let alpha = layout.alpha?;
+    if !(1..=MAX_SIDE).contains(&layout.width) || !(1..=MAX_SIDE).contains(&layout.height) {
+        return None;
+    }
+    if !(1..=MAX_SCALE).contains(&scale) || layout.offset < 0 {
+        return None;
+    }
+    let (width, height) = (layout.width as usize, layout.height as usize);
+    let (offset, stride) = (layout.offset as usize, usize::try_from(layout.stride).ok()?);
+    if stride < width * 4 {
+        return None;
+    }
+    // The last row need not be a whole stride long.
+    let end = offset
+        .checked_add(stride.checked_mul(height - 1)?)?
+        .checked_add(width * 4)?;
+    if end > pool.len() {
+        return None;
+    }
+    // The hot spot lies inside the image.
+    let hotspot_x = u32::try_from(hotspot.0.checked_mul(scale)?).ok()?;
+    let hotspot_y = u32::try_from(hotspot.1.checked_mul(scale)?).ok()?;
+    if hotspot_x >= layout.width as u32 || hotspot_y >= layout.height as u32 {
+        return None;
+    }
+    let mut rgba = Vec::with_capacity(width * height * 4);
+    for row in 0..height {
+        let begin = offset + row * stride;
+        for pixel in pool[begin..begin + width * 4].chunks_exact(4) {
+            rgba.extend_from_slice(&[
+                pixel[2],
+                pixel[1],
+                pixel[0],
+                if alpha { pixel[3] } else { 255 },
+            ]);
+        }
+    }
+    Some(CursorImage {
+        width: layout.width as u32,
+        height: layout.height as u32,
+        hotspot_x,
+        hotspot_y,
+        scale: scale as u32,
+        rgba,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::{Arc, Mutex};
+
+    fn layout(width: i32, height: i32) -> Layout {
+        Layout {
+            offset: 0,
+            width,
+            height,
+            stride: width.saturating_mul(4),
+            alpha: Some(true),
+        }
+    }
+
+    #[test]
+    fn pixels_are_read_row_by_row_and_turned_from_bgra_to_rgba() {
+        // Two rows of two pixels, behind eight bytes of something else, each row followed by
+        // four bytes of padding.
+        let mut pool = vec![0xEE; 8];
+        pool.extend_from_slice(&[1, 2, 3, 4, 5, 6, 7, 8, 0xEE, 0xEE, 0xEE, 0xEE]);
+        pool.extend_from_slice(&[9, 10, 11, 12, 13, 14, 15, 16]);
+        let image = image_from_pixels(
+            &pool,
+            Layout {
+                offset: 8,
+                width: 2,
+                height: 2,
+                stride: 12,
+                alpha: Some(true),
+            },
+            (1, 0),
+            1,
+        )
+        .unwrap();
+        assert_eq!((image.width, image.height, image.scale), (2, 2, 1));
+        assert_eq!((image.hotspot_x, image.hotspot_y), (1, 0));
+        assert_eq!(
+            image.rgba,
+            [3, 2, 1, 4, 7, 6, 5, 8, 11, 10, 9, 12, 15, 14, 13, 16]
+        );
+    }
+
+    #[test]
+    fn a_format_without_alpha_is_opaque() {
+        let pool = [1, 2, 3, 0];
+        let image = image_from_pixels(
+            &pool,
+            Layout {
+                alpha: Some(false),
+                ..layout(1, 1)
+            },
+            (0, 0),
+            1,
+        )
+        .unwrap();
+        assert_eq!(image.rgba, [3, 2, 1, 255]);
+    }
+
+    #[test]
+    fn the_hot_spot_is_given_in_pixels_of_the_image() {
+        let pool = vec![0; 64 * 64 * 4];
+        let image = image_from_pixels(&pool, layout(64, 64), (5, 7), 2).unwrap();
+        assert_eq!((image.hotspot_x, image.hotspot_y, image.scale), (10, 14, 2));
+    }
+
+    #[test]
+    fn an_image_that_does_not_fit_its_own_description_is_not_read() {
+        let pool = vec![0; 16 * 16 * 4];
+        assert!(image_from_pixels(&pool, layout(16, 16), (0, 0), 1).is_some());
+        // One byte short of what the description needs.
+        assert!(image_from_pixels(&pool[..pool.len() - 1], layout(16, 16), (0, 0), 1).is_none());
+        // Begins so late that it runs over the end, or before the beginning.
+        for offset in [4, -4, i32::MAX] {
+            let moved = Layout {
+                offset,
+                ..layout(16, 16)
+            };
+            assert!(image_from_pixels(&pool, moved, (0, 0), 1).is_none());
+        }
+        // Rows shorter than their pixels, and rows so long that the image runs over the end.
+        for stride in [16 * 4 - 1, 16 * 4 + 4, 0, -64, i32::MAX] {
+            let rows = Layout {
+                stride,
+                ..layout(16, 16)
+            };
+            assert!(image_from_pixels(&pool, rows, (0, 0), 1).is_none());
+        }
+    }
+
+    #[test]
+    fn an_image_of_no_size_or_of_too_large_a_size_is_not_read() {
+        let pool = vec![0; 257 * 257 * 4];
+        assert!(image_from_pixels(&pool, layout(256, 256), (0, 0), 1).is_some());
+        for (width, height) in [
+            (0, 16),
+            (16, 0),
+            (-1, 16),
+            (257, 16),
+            (16, 257),
+            (i32::MAX, 2),
+        ] {
+            assert!(
+                image_from_pixels(&pool, layout(width, height), (0, 0), 1).is_none(),
+                "{width}x{height}"
+            );
+        }
+    }
+
+    #[test]
+    fn a_hot_spot_outside_the_image_a_strange_scale_or_format_are_not_accepted() {
+        let pool = vec![0; 16 * 16 * 4];
+        for hotspot in [(16, 0), (0, 16), (-1, 0), (0, -1), (i32::MAX, 0)] {
+            assert!(image_from_pixels(&pool, layout(16, 16), hotspot, 1).is_none());
+        }
+        // Inside the surface, outside the image once the scale is applied.
+        assert!(image_from_pixels(&pool, layout(16, 16), (8, 8), 2).is_none());
+        for scale in [0, -1, 9] {
+            assert!(image_from_pixels(&pool, layout(16, 16), (0, 0), scale).is_none());
+        }
+        let unknown = Layout {
+            alpha: None,
+            ..layout(16, 16)
+        };
+        assert!(image_from_pixels(&pool, unknown, (0, 0), 1).is_none());
+    }
+
+    #[test]
+    fn a_sink_is_told_a_change_once_and_a_new_sink_is_told_what_is() {
+        let told = Arc::new(Mutex::new(Vec::new()));
+        let sink = |told: &Arc<Mutex<Vec<Cursor>>>| -> CursorSink {
+            let told = told.clone();
+            Box::new(move |cursor| told.lock().unwrap().push(cursor.clone()))
+        };
+        let mut report = CursorReport::default();
+        // Nobody to tell: the cursor stays in the picture.
+        report.tell(Cursor::Hidden);
+        assert!(!report.outside_picture());
+
+        report.set_sink(Some(sink(&told)));
+        assert!(report.outside_picture());
+        report.tell(Cursor::Named("default".into()));
+        report.tell(Cursor::Named("default".into()));
+        report.tell(Cursor::Hidden);
+        report.tell(Cursor::Hidden);
+        report.tell(Cursor::Named("default".into()));
+        assert_eq!(
+            *told.lock().unwrap(),
+            [
+                Cursor::Named("default".into()),
+                Cursor::Hidden,
+                Cursor::Named("default".into())
+            ]
+        );
+        // Another sink has not heard any of it.
+        let other = Arc::new(Mutex::new(Vec::new()));
+        report.set_sink(Some(sink(&other)));
+        report.tell(Cursor::Named("default".into()));
+        assert_eq!(*other.lock().unwrap(), [Cursor::Named("default".into())]);
+
+        report.set_sink(None);
+        report.tell(Cursor::Hidden);
+        assert!(!report.outside_picture());
+        assert_eq!(other.lock().unwrap().len(), 1);
+    }
+}
