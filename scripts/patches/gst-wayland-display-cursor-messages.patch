+/// Posts what the cursor is as an application message on the element's bus, as the element
+/// posts its environment (`wayland.src`). The structure `wayland.cursor` has a `kind`:
+/// "hidden"; "named", with a `name`, for a cursor there is no image of; or "image", with
+/// `width`, `height`, `hotspot-x`, `hotspot-y` (pixels of the image), `scale` (pixels of the
+/// image to one of the picture) and `image`, a buffer of four bytes a pixel: red, green,
+/// blue, alpha, the colours multiplied by alpha.
+fn cursor_sink(element: glib::WeakRef<super::WaylandDisplaySrc>) -> waylanddisplaycore::CursorSink {
+    use waylanddisplaycore::Cursor;
+    Box::new(move |cursor| {
+        let Some(element) = element.upgrade() else {
+            return;
+        };
+        let structure = Structure::builder("wayland.cursor");
+        let structure = match cursor {
+            Cursor::Hidden => structure.field("kind", "hidden"),
+            Cursor::Named(name) => structure
+                .field("kind", "named")
+                .field("name", name.as_str()),
+            Cursor::Image(image) => structure
+                .field("kind", "image")
+                .field("width", image.width)
+                .field("height", image.height)
+                .field("hotspot-x", image.hotspot_x)
+                .field("hotspot-y", image.hotspot_y)
+                .field("scale", image.scale)
+                .field("image", gst::Buffer::from_slice(image.rgba.clone())),
+        };
+        let message = Application::builder(structure.build())
+            .src(&element)
+            .build();
+        if let Err(err) = element.post_message(message) {
+            gst::warning!(CAT, "Failed to post the cursor to the bus: {}", err);
+        }
+    })
+}
