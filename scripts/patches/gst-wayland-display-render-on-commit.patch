+/// Renders the frame the element is waiting for after `wait`, or as soon after that as the
+/// frame rate allows: in no one second do more frames go out than the frame rate says.
+///
+/// Called when the element asks for a frame and when an application commits. Whatever was
+/// scheduled before for the same frame no longer counts.
+pub(crate) fn schedule_waiting_frame(state: &mut State, wait: Duration) {
+    let now = Instant::now();
+    let room = match state.recent_frames.front() {
+        Some(oldest) if state.recent_frames.len() >= state.frames_per_second => {
+            (*oldest + Duration::from_secs(1)).saturating_duration_since(now)
+        }
+        _ => Duration::ZERO,
+    };
+    let wait = wait.max(room);
+    state.frame_request = state.frame_request.wrapping_add(1);
+    let request = state.frame_request;
+    let render = move |state: &mut State, now: Instant| {
+        if state.frame_request == request {
+            if let Some(render) = state.waiting_frame.take() {
+                render(state, now);
+            }
+        }
+    };
+    if wait.is_zero() {
+        // Once what is being handled right now (a commit, say) has been taken in.
+        state.handle.insert_idle(move |state| render(state, Instant::now()));
+    } else if let Err(err) = state.handle.insert_source(Timer::from_duration(wait), move |now, _, data| {
+        render(data, now);
+        TimeoutAction::Drop
+    }) {
+        tracing::error!(?err, "Event loop error.");
+        state.should_quit = true;
+    }
+}
