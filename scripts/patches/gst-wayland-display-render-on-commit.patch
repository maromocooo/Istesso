@@ -0,0 +1,164 @@
+//! Integration tests for the "render on commit" mode (see `comp::pacing`).
+//!
+//! The element's side is played by the tests: they put a frame into `waiting_frame`, as the
+//! `Command::Buffer` handler in `comp::init` does, and note when it starts. A real Wayland
+//! client commits, so that a failure here says that commits no longer reach the pacing.
+
+use crate::comp::{State, schedule_waiting_frame, send_frame_callbacks};
+use crate::tests::fixture::Fixture;
+use std::cell::RefCell;
+use std::rc::Rc;
+use std::sync::atomic::Ordering;
+use std::time::{Duration, Instant};
+use test_log::test;
+
+/// Twenty frames a second: slow enough for a busy machine to keep up with.
+const PER_SECOND: usize = 20;
+const FRAME: Duration = Duration::from_millis(50);
+
+type Starts = Rc<RefCell<Vec<Instant>>>;
+
+/// Asks for a frame the way the element does. The frame notes when it starts, and tells the
+/// clients to draw when it goes out although nothing has changed, as a rendered frame does.
+fn ask_for_a_frame(f: &mut Fixture, starts: &Starts) {
+    let last = starts.borrow().last().copied();
+    let wait = f.server.pacing.frame_asked(Instant::now(), last);
+    let starts = starts.clone();
+    f.server.waiting_frame = Some(Box::new(move |state: &mut State, _| {
+        let now = Instant::now();
+        starts.borrow_mut().push(now);
+        if !state.pacing.frame_started(now) && state.pacing.tell_with_idle_frame(now) {
+            send_frame_callbacks(state);
+        }
+    }));
+    schedule_waiting_frame(&mut f.server, wait);
+}
+
+/// Lets both sides work for `time`. With `again`, a new frame is asked for whenever the last
+/// one has started, as an element does that is never short of buffers.
+fn run(f: &mut Fixture, time: Duration, starts: &Starts, again: bool) {
+    let until = Instant::now() + time;
+    while Instant::now() < until {
+        f.update_server();
+        f.update_client();
+        if again && f.server.waiting_frame.is_none() {
+            ask_for_a_frame(f, starts);
+        }
+        std::thread::sleep(Duration::from_millis(1));
+    }
+}
+
+fn fixture(render_on_commit: bool) -> (Fixture, Starts) {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server.pacing.set_frame_rate(PER_SECOND as u64, 1);
+    f.server.pacing.set_enabled(render_on_commit);
+    (f, Starts::default())
+}
+
+#[test]
+fn a_commit_lets_the_waiting_frame_out() {
+    let (mut f, starts) = fixture(true);
+    ask_for_a_frame(&mut f, &starts);
+    run(&mut f, Duration::from_millis(10), &starts, false);
+    assert_eq!(starts.borrow().len(), 1, "the first frame goes out at once");
+
+    // Nothing changes: the next frame waits.
+    ask_for_a_frame(&mut f, &starts);
+    run(&mut f, FRAME, &starts, false);
+    assert_eq!(
+        starts.borrow().len(),
+        1,
+        "a frame went out although nothing had changed"
+    );
+
+    let committed = Instant::now();
+    f.client.commit_window();
+    run(&mut f, FRAME / 2, &starts, false);
+    let starts = starts.borrow();
+    assert_eq!(starts.len(), 2, "the commit did not let the frame out");
+    let waited = starts[1].duration_since(committed);
+    assert!(
+        waited < FRAME / 2,
+        "the frame went out {waited:?} after the commit"
+    );
+}
+
+#[test]
+fn without_a_commit_the_frame_goes_out_after_two_frame_intervals() {
+    let (mut f, starts) = fixture(true);
+    ask_for_a_frame(&mut f, &starts);
+    run(&mut f, Duration::from_millis(10), &starts, false);
+    ask_for_a_frame(&mut f, &starts);
+    run(&mut f, FRAME * 3, &starts, false);
+    let starts = starts.borrow();
+    assert_eq!(starts.len(), 2, "the stream stopped");
+    let apart = starts[1].duration_since(starts[0]);
+    assert!(
+        apart >= FRAME * 2 - Duration::from_millis(1) && apart < FRAME * 3,
+        "the second frame went out {apart:?} after the first"
+    );
+}
+
+#[test]
+fn with_the_mode_off_a_commit_does_not_touch_a_frame() {
+    let (mut f, starts) = fixture(false);
+    // Nothing puts a frame here while the mode is off. If something did, a commit would have
+    // to leave it alone.
+    let noted = starts.clone();
+    f.server.waiting_frame = Some(Box::new(move |_: &mut State, now| {
+        noted.borrow_mut().push(now);
+    }));
+    f.client.commit_window();
+    run(&mut f, FRAME, &starts, false);
+    assert!(starts.borrow().is_empty());
+    assert!(f.server.waiting_frame.is_some());
+}
+
+/// A client that draws whenever it is told to, and at once: most applications. Its frames
+/// must not come in a rush followed by a pause: they keep the distance of the frame rate,
+/// because the client is told once a frame interval.
+#[test]
+fn a_client_that_draws_when_told_gets_evenly_spaced_frames() {
+    let (mut f, starts) = fixture(true);
+    ask_for_a_frame(&mut f, &starts);
+    let mut told = f.client.commit_window_and_wait_to_be_told();
+    let until = Instant::now() + Duration::from_millis(1600);
+    while Instant::now() < until {
+        run(&mut f, Duration::from_millis(1), &starts, true);
+        if told.done.load(Ordering::Relaxed) {
+            told = f.client.commit_window_and_wait_to_be_told();
+        }
+    }
+
+    let starts = starts.borrow();
+    let apart: Vec<Duration> = starts
+        .windows(2)
+        .map(|pair| pair[1].duration_since(pair[0]))
+        .collect();
+    assert!(
+        starts.len() >= PER_SECOND && starts.len() <= PER_SECOND * 16 / 10 + 2,
+        "{} frames in 1.6 seconds at {PER_SECOND} frames a second: {apart:?}",
+        starts.len()
+    );
+    // The first two pictures after a quiet spell go out as they come. After a second one
+    // frame gives way for that (see `comp::pacing`); it is not counted here.
+    let uneven = apart
+        .iter()
+        .skip(2)
+        .filter(|&&apart| {
+            apart < FRAME - Duration::from_millis(5) || apart > FRAME + Duration::from_millis(15)
+        })
+        .count();
+    assert!(uneven <= 2, "{uneven} frames out of step: {apart:?}");
+    for (index, &start) in starts.iter().enumerate() {
+        let within = starts[index..]
+            .iter()
+            .take_while(|later| later.duration_since(start) < Duration::from_secs(1))
+            .count();
+        assert!(
+            within <= PER_SECOND,
+            "{within} frames started within one second"
+        );
+    }
+}
