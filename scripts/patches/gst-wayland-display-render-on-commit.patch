+/// Lets the frame the element is waiting for start rendering after `wait`, or as soon after
+/// that as the frame rate allows (see [`pacing`]). Whatever was scheduled before for the same
+/// frame no longer counts.
+pub(crate) fn schedule_waiting_frame(state: &mut State, wait: Duration) {
+    let wait = wait.max(state.pacing.room(Instant::now()));
+    state.frame_request = state.frame_request.wrapping_add(1);
+    let request = state.frame_request;
+    let render = move |state: &mut State, now: Instant| {
+        if state.frame_request == request {
+            if let Some(render) = state.waiting_frame.take() {
+                render(state, now);
+            }
+        }
+    };
+    if wait.is_zero() {
+        // Once what is being handled right now (a commit, say) has been taken in.
+        state
+            .handle
+            .insert_idle(move |state| render(state, Instant::now()));
+    } else if let Err(err) =
+        state
+            .handle
+            .insert_source(Timer::from_duration(wait), move |now, _, state| {
+                render(state, now);
+                TimeoutAction::Drop
+            })
+    {
+        tracing::error!(?err, "Event loop error.");
+        state.should_quit = true;
+    }
+}
+
+/// Something that is part of the picture has changed: a client has committed, or the pointer
+/// has moved. In the "render on commit" mode a frame that is waiting goes out now, or as soon
+/// as the frame rate allows.
+pub(crate) fn picture_changed(state: &mut State) {
+    if state.pacing.changed() && state.waiting_frame.is_some() {
+        schedule_waiting_frame(state, Duration::ZERO);
+    }
+}
+
+/// A client has committed. In the "render on commit" mode its picture goes out, and the
+/// clients are told to draw their next frame on a beat of their own (see [`pacing`]): now, or
+/// when a frame interval has passed since they were last told.
+pub(crate) fn client_committed(state: &mut State) {
+    picture_changed(state);
+    if !state.pacing.enabled() {
+        return;
+    }
+    match state.pacing.tell(Instant::now()) {
+        pacing::Tell::Now => send_frame_callbacks(state),
+        pacing::Tell::Later(wait) => {
+            if let Err(err) =
+                state
+                    .handle
+                    .insert_source(Timer::from_duration(wait), |_, _, state| {
+                        state.pacing.told(Instant::now());
+                        send_frame_callbacks(state);
+                        TimeoutAction::Drop
+                    })
+            {
+                tracing::error!(?err, "Event loop error.");
+                state.should_quit = true;
+            }
+        }
+        pacing::Tell::Waiting => {}
+    }
+}
+
+/// Tells the clients that it is time to draw their next frame.
+pub(crate) fn send_frame_callbacks(state: &State) {
+    let Some(output) = state.output.as_ref() else {
