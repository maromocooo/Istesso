@@ -0,0 +1,655 @@
+//! When frames start rendering, and when clients are told to draw, in the "render on commit"
+//! mode.
+//!
+//! Without the mode a frame goes out on the beat of the frame rate, whatever the clients do:
+//! what a client draws waits for the next beat, half a frame interval on average, and a whole
+//! one for a client that draws when it is told to, because it is told right after a beat.
+//!
+//! With the mode a frame goes out as soon as the picture has changed (a client has committed,
+//! the pointer has moved). The frame rate is kept in two ways:
+//!
+//! - In no one second do more frames start than the frame rate says, whatever came before.
+//! - Clients are told to draw their next frame (`wl_surface.frame`) on a beat of their own:
+//!   when they have committed, but not more often than once a frame interval. A client that
+//!   draws whenever it is told to therefore commits once per interval, and each of its
+//!   pictures goes out when it arrives. If such a client were told at every frame instead,
+//!   it would draw as fast as it can, and all the frames of a second would be gone in the
+//!   first part of it.
+
+use std::collections::VecDeque;
+use std::time::{Duration, Instant};
+
+/// How many frame intervals a frame is held back while nothing changes. After that it goes
+/// out as it is, so that the stream does not stop.
+const IDLE_FRAME_INTERVALS: u32 = 2;
+
+/// A frame that the one-second rule would hold back for longer than this gives way to the
+/// next picture instead (see [`FramePacing::room`]).
+const GIVE_WAY_AFTER: Duration = Duration::from_millis(1);
+
+const SECOND: Duration = Duration::from_secs(1);
+
+/// What to do about telling the clients to draw their next frame.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub(crate) enum Tell {
+    /// Tell them now.
+    Now,
+    /// Tell them after this long, and say so with [`FramePacing::told`].
+    Later(Duration),
+    /// They will be told: a timer for it is running.
+    Waiting,
+}
+
+#[derive(Debug)]
+pub(crate) struct FramePacing {
+    enabled: bool,
+    /// Whether the picture has changed since the last frame started rendering.
+    changed: bool,
+    /// How many frames may start rendering in any one second: the frame rate, rounded up.
+    per_second: usize,
+    /// The time from one frame to the next at the frame rate.
+    frame_interval: Duration,
+    /// When the frames of the last second started rendering.
+    recent: VecDeque<Instant>,
+    /// When the clients may be told to draw again, and whether a timer is running for it.
+    tell_from: Option<Instant>,
+    tell_timer: bool,
+    /// How many frames have started rendering, and the most in any one second, for the log.
+    started: u64,
+    most_in_a_second: usize,
+    reported: Option<Instant>,
+}
+
+impl Default for FramePacing {
+    fn default() -> Self {
+        FramePacing {
+            enabled: false,
+            changed: false,
+            per_second: 60,
+            frame_interval: SECOND / 60,
+            recent: VecDeque::new(),
+            tell_from: None,
+            tell_timer: false,
+            started: 0,
+            most_in_a_second: 0,
+            reported: None,
+        }
+    }
+}
+
+impl FramePacing {
+    pub(crate) fn enabled(&self) -> bool {
+        self.enabled
+    }
+
+    pub(crate) fn set_enabled(&mut self, enabled: bool) {
+        if self.enabled != enabled {
+            *self = FramePacing {
+                enabled,
+                per_second: self.per_second,
+                frame_interval: self.frame_interval,
+                // A timer that is running still reports back.
+                tell_timer: self.tell_timer,
+                ..Default::default()
+            };
+        }
+    }
+
+    /// The frame rate of the stream: the time from one frame to the next, and how many frames
+    /// a second may hold. Both rounded up, so that a second never holds one frame too many.
+    pub(crate) fn set_frame_rate(&mut self, numer: u64, denom: u64) {
+        if numer == 0 || denom == 0 {
+            return;
+        }
+        self.frame_interval = Duration::from_nanos((1_000_000_000 * denom).div_ceil(numer));
+        self.per_second = numer.div_ceil(denom) as usize;
+    }
+
+    /// The picture has changed: a client has committed, or the pointer has moved. True when a
+    /// frame that is waiting should be looked at again.
+    pub(crate) fn changed(&mut self) -> bool {
+        self.changed = true;
+        self.enabled
+    }
+
+    /// The element asks for a frame at `now`. Says how long the frame waits before it starts
+    /// rendering: not at all when the picture has changed since the last frame, otherwise
+    /// until the stream would stall; in both cases not less than [`Self::room`].
+    pub(crate) fn frame_asked(&mut self, now: Instant, last_render: Option<Instant>) -> Duration {
+        let idle = match last_render {
+            Some(last) if !self.changed => (self.frame_interval * IDLE_FRAME_INTERVALS)
+                .saturating_sub(now.saturating_duration_since(last)),
+            _ => Duration::ZERO,
+        };
+        idle.max(self.room(now))
+    }
+
+    /// How long until another frame may start.
+    ///
+    /// Not before the frame that started as many frames ago as a second may hold is a second
+    /// old. Where that is more than a moment away, the frame waits one frame interval longer
+    /// still: a client that goes on drawing has committed again by then, this is asked again,
+    /// and the newer picture goes out in place of the one held back. Without that the frame
+    /// held back and the next one would follow each other closely, and a second later the
+    /// same would happen again, and so on every second.
+    pub(crate) fn room(&self, now: Instant) -> Duration {
+        if !self.enabled {
+            return Duration::ZERO;
+        }
+        let Some(earlier) = self.recent.len().checked_sub(self.per_second) else {
+            return Duration::ZERO;
+        };
+        let wait = (self.recent[earlier] + SECOND).saturating_duration_since(now);
+        if wait > GIVE_WAY_AFTER {
+            wait + self.frame_interval
+        } else {
+            wait
+        }
+    }
+
+    /// A frame starts rendering at `now`. Says whether the picture has changed since the last
+    /// one: if not, this frame only keeps the stream going.
+    pub(crate) fn frame_started(&mut self, now: Instant) -> bool {
+        if !self.enabled {
+            return true;
+        }
+        let changed = std::mem::take(&mut self.changed);
+        while self
+            .recent
+            .front()
+            .is_some_and(|&start| now.saturating_duration_since(start) >= SECOND)
+        {
+            self.recent.pop_front();
+        }
+        self.recent.push_back(now);
+        self.started += 1;
+        self.most_in_a_second = self.most_in_a_second.max(self.recent.len());
+
+        let reported = *self.reported.get_or_insert(now);
+        if now.saturating_duration_since(reported) >= SECOND {
+            self.reported = Some(now);
+            tracing::debug!(
+                last_second = self.recent.len(),
+                most_in_a_second = self.most_in_a_second,
+                "Frames started rendering."
+            );
+        }
+        changed
+    }
+
+    /// A client has committed at `now` and may be waiting to be told to draw its next frame.
+    pub(crate) fn tell(&mut self, now: Instant) -> Tell {
+        if self.tell_timer {
+            return Tell::Waiting;
+        }
+        match self.tell_from {
+            Some(from) if now < from => {
+                self.tell_timer = true;
+                Tell::Later(from - now)
+            }
+            _ => {
+                self.tell_from = Some(now + self.frame_interval);
+                Tell::Now
+            }
+        }
+    }
+
+    /// The timer of [`Tell::Later`] has run at `now`, and the clients are being told.
+    pub(crate) fn told(&mut self, now: Instant) {
+        self.tell_timer = false;
+        self.tell_from = Some(now + self.frame_interval);
+    }
+
+    /// A frame goes out at `now` although nothing has changed. Says whether to tell the
+    /// clients with it: a client that was not told when it committed (there was no output
+    /// yet, say) would otherwise wait for ever, and so would the stream for its next picture.
+    pub(crate) fn tell_with_idle_frame(&mut self, now: Instant) -> bool {
+        if self.tell_timer {
+            return false;
+        }
+        self.tell_from = Some(now + self.frame_interval);
+        true
+    }
+
+    /// Says in the log how many frames started rendering and how many of them at most in any
+    /// one second: the figure to hold against the frame rate. Once, when the stream ends.
+    pub(crate) fn report(&self) {
+        if self.enabled && self.started > 0 {
+            tracing::info!(
+                frames = self.started,
+                most_in_a_second = self.most_in_a_second,
+                "Frames started rendering on commit."
+            );
+        }
+    }
+
+    /// The most frames that started rendering in any one second so far.
+    #[cfg(test)]
+    pub(crate) fn most_in_a_second(&self) -> usize {
+        self.most_in_a_second
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pacing(per_second: u64) -> FramePacing {
+        let mut pacing = FramePacing::default();
+        pacing.set_enabled(true);
+        pacing.set_frame_rate(per_second, 1);
+        pacing
+    }
+
+    #[test]
+    fn is_off_unless_asked_for() {
+        let mut pacing = FramePacing::default();
+        assert!(!pacing.enabled());
+        // A change does not make a waiting frame go out, and nothing is held back or counted.
+        assert!(!pacing.changed());
+        let now = Instant::now();
+        for _ in 0..200 {
+            pacing.frame_started(now);
+        }
+        assert_eq!(pacing.room(now), Duration::ZERO);
+        assert_eq!(pacing.most_in_a_second(), 0);
+    }
+
+    #[test]
+    fn the_frame_rate_is_rounded_up() {
+        let mut pacing = pacing(85);
+        assert_eq!(pacing.frame_interval, Duration::from_nanos(11_764_706));
+        assert_eq!(pacing.per_second, 85);
+        pacing.set_frame_rate(60_000, 1001);
+        assert_eq!(pacing.frame_interval, Duration::from_nanos(16_683_334));
+        assert_eq!(pacing.per_second, 60);
+        // A frame rate nobody has said yet leaves things as they are.
+        pacing.set_frame_rate(0, 1);
+        assert_eq!(pacing.per_second, 60);
+    }
+
+    #[test]
+    fn a_changed_picture_goes_out_at_once() {
+        let mut pacing = pacing(85);
+        let start = Instant::now();
+        assert_eq!(pacing.frame_asked(start, None), Duration::ZERO);
+        assert!(!pacing.frame_started(start));
+        assert!(pacing.changed());
+        let now = start + Duration::from_millis(1);
+        assert_eq!(pacing.frame_asked(now, Some(start)), Duration::ZERO);
+        assert!(pacing.frame_started(now));
+    }
+
+    #[test]
+    fn without_a_change_a_frame_goes_out_after_two_intervals() {
+        let mut pacing = pacing(85);
+        let frame = pacing.frame_interval;
+        let start = Instant::now();
+        assert_eq!(pacing.frame_asked(start, None), Duration::ZERO);
+        pacing.frame_started(start);
+        let now = start + Duration::from_millis(3);
+        assert_eq!(
+            pacing.frame_asked(now, Some(start)),
+            frame * 2 - Duration::from_millis(3)
+        );
+        // Long after the last frame there is nothing left to wait for.
+        let late = start + Duration::from_millis(500);
+        assert_eq!(pacing.frame_asked(late, Some(start)), Duration::ZERO);
+    }
+
+    #[test]
+    fn a_change_counts_for_one_frame_only() {
+        let mut pacing = pacing(85);
+        let frame = pacing.frame_interval;
+        let start = Instant::now();
+        pacing.changed();
+        assert_eq!(pacing.frame_asked(start, None), Duration::ZERO);
+        pacing.frame_started(start);
+        // Nothing has changed since: the next frame waits as long as it does when idle.
+        assert_eq!(pacing.frame_asked(start + frame, Some(start)), frame);
+    }
+
+    #[test]
+    fn clients_are_told_once_a_frame_interval_at_most() {
+        let mut pacing = pacing(85);
+        let frame = pacing.frame_interval;
+        let start = Instant::now();
+        assert_eq!(pacing.tell(start), Tell::Now);
+        // A commit right behind: told when the interval is over, by a timer.
+        let soon = start + Duration::from_millis(2);
+        assert_eq!(
+            pacing.tell(soon),
+            Tell::Later(frame - Duration::from_millis(2))
+        );
+        assert_eq!(pacing.tell(soon + Duration::from_millis(1)), Tell::Waiting);
+        pacing.told(start + frame);
+        assert_eq!(
+            pacing.tell(start + frame + Duration::from_millis(2)),
+            Tell::Later(frame - Duration::from_millis(2))
+        );
+        pacing.told(start + frame * 2);
+        // After a quiet spell: at once again.
+        assert_eq!(pacing.tell(start + frame * 10), Tell::Now);
+        // Told with a frame that only kept the stream going: that counts as well.
+        assert!(pacing.tell_with_idle_frame(start + frame * 20));
+        assert_eq!(
+            pacing.tell(start + frame * 20 + Duration::from_millis(2)),
+            Tell::Later(frame - Duration::from_millis(2))
+        );
+        assert!(!pacing.tell_with_idle_frame(start + frame * 20 + Duration::from_millis(3)));
+    }
+
+    /// The kinds of client the pacing has to do well by.
+    #[derive(Clone, Copy)]
+    enum Client {
+        /// Draws when it is told to (`wl_surface.frame`), and commits this long afterwards.
+        /// Most applications.
+        DrawsWhenTold(Duration),
+        /// Keeps a rhythm of its own, with this much time from one commit to the next, each
+        /// commit up to `off` late.
+        KeepsItsOwnRhythm { every: Duration, off: Duration },
+    }
+
+    struct Run {
+        /// When each frame started rendering, from the beginning of the run.
+        starts: Vec<Duration>,
+        /// How long after the client's commit each of its pictures started rendering. A
+        /// picture that never went out by itself counts until the frame that showed it.
+        waits: Vec<Duration>,
+        most_in_a_second: usize,
+    }
+
+    /// Plays the compositor's event loop with one client and an element that asks for the
+    /// next frame the moment it has one: commits, timers and frames in the order of their
+    /// times.
+    fn run(per_second: u64, client: Client, seconds: u64) -> Run {
+        let mut pacing = pacing(per_second);
+        let begin = Instant::now();
+        let end = begin + Duration::from_secs(seconds);
+        // Rendering takes a moment, and not always the same.
+        let render = |number: usize| Duration::from_micros(300 + (number as u64 * 37) % 900);
+        let off =
+            |number: u64, most: Duration| most.mul_f64(((number * 7919) % 1000) as f64 / 1000.0);
+
+        let mut commits = 0u64;
+        let mut next_commit = Some(begin);
+        let mut tell_timer: Option<Instant> = None;
+        // The frame the element is waiting for: when it was asked for, and when it is to start.
+        let mut asked = begin;
+        let mut frame_at = begin + pacing.frame_asked(begin, None);
+        let mut unshown: Vec<Instant> = Vec::new();
+        let mut starts = Vec::new();
+        let mut waits = Vec::new();
+
+        loop {
+            // The frame can only start once it has been asked for.
+            let frame = frame_at.max(asked);
+            let commit = next_commit.unwrap_or(end);
+            let timer = tell_timer.unwrap_or(end);
+            let now = frame.min(commit).min(timer);
+            if now >= end {
+                break;
+            }
+            if now == commit {
+                commits += 1;
+                unshown.push(now);
+                next_commit = match client {
+                    Client::DrawsWhenTold(draw) => match pacing.tell(now) {
+                        Tell::Now => Some(now + draw),
+                        Tell::Later(wait) => {
+                            tell_timer = Some(now + wait);
+                            None
+                        }
+                        Tell::Waiting => None,
+                    },
+                    Client::KeepsItsOwnRhythm { every, off: most } => {
+                        Some(begin + every * commits as u32 + off(commits, most))
+                    }
+                };
+                if pacing.changed() && now >= asked {
+                    frame_at = now + pacing.room(now);
+                }
+            } else if now == timer {
+                pacing.told(now);
+                tell_timer = None;
+                if let Client::DrawsWhenTold(draw) = client {
+                    next_commit = Some(now + draw);
+                }
+            } else {
+                pacing.frame_started(now);
+                starts.push(now.duration_since(begin));
+                waits.extend(unshown.drain(..).map(|commit| now.duration_since(commit)));
+                asked = now + render(starts.len());
+                frame_at = asked + pacing.frame_asked(asked, Some(now));
+            }
+        }
+        Run {
+            starts,
+            waits,
+            most_in_a_second: pacing.most_in_a_second(),
+        }
+    }
+
+    fn most_within_a_second(starts: &[Duration]) -> usize {
+        (0..starts.len())
+            .map(|index| {
+                starts[index..]
+                    .iter()
+                    .take_while(|&&later| later - starts[index] < SECOND)
+                    .count()
+            })
+            .max()
+            .unwrap_or(0)
+    }
+
+    fn clients(per_second: u64) -> Vec<Client> {
+        let frame = Duration::from_nanos(1_000_000_000 / per_second);
+        vec![
+            Client::DrawsWhenTold(Duration::ZERO),
+            Client::DrawsWhenTold(Duration::from_millis(2)),
+            Client::DrawsWhenTold(frame + Duration::from_millis(3)),
+            // At the frame rate to the nanosecond, a little faster, a little slower, and
+            // three times as fast.
+            Client::KeepsItsOwnRhythm {
+                every: frame,
+                off: Duration::from_millis(2),
+            },
+            Client::KeepsItsOwnRhythm {
+                every: frame.mul_f64(0.999),
+                off: Duration::from_millis(1),
+            },
+            Client::KeepsItsOwnRhythm {
+                every: frame.mul_f64(1.001),
+                off: Duration::from_millis(1),
+            },
+            Client::KeepsItsOwnRhythm {
+                every: frame / 3,
+                off: Duration::ZERO,
+            },
+        ]
+    }
+
+    #[test]
+    fn no_second_holds_more_frames_than_the_frame_rate() {
+        for per_second in [1, 24, 60, 85, 120] {
+            for client in clients(per_second) {
+                let run = run(per_second, client, 6);
+                let most = most_within_a_second(&run.starts);
+                assert!(
+                    most <= per_second as usize && run.most_in_a_second <= per_second as usize,
+                    "{most} frames started within one second at {per_second} frames a second"
+                );
+            }
+        }
+    }
+
+    /// Most applications. Their frames must not come in a rush followed by a pause: once
+    /// things have settled, every frame follows the one before after one frame interval, and
+    /// goes out when the client has committed it.
+    #[test]
+    fn a_client_that_draws_when_told_gets_evenly_spaced_frames_without_waiting() {
+        for per_second in [24, 60, 85, 120] {
+            let frame = Duration::from_nanos(1_000_000_000u64.div_ceil(per_second));
+            let run = run(
+                per_second,
+                Client::DrawsWhenTold(Duration::from_millis(2)),
+                6,
+            );
+            let settled: Vec<Duration> = run
+                .starts
+                .iter()
+                .copied()
+                .filter(|&start| start >= SECOND * 2)
+                .collect();
+            assert!(
+                settled.len() + 1 >= per_second as usize * 4,
+                "only {} frames in four seconds at {per_second} frames a second",
+                settled.len()
+            );
+            for pair in settled.windows(2) {
+                let apart = pair[1] - pair[0];
+                assert!(
+                    apart >= frame && apart <= frame + Duration::from_micros(1),
+                    "two frames {apart:?} apart at {per_second} frames a second"
+                );
+            }
+            let waited = run
+                .waits
+                .iter()
+                .filter(|&&wait| wait > Duration::from_micros(1))
+                .count();
+            assert!(
+                waited <= 2,
+                "{waited} pictures of {} had to wait",
+                run.waits.len()
+            );
+        }
+    }
+
+    fn sorted(mut waits: Vec<Duration>) -> Vec<Duration> {
+        waits.sort();
+        waits
+    }
+
+    /// A client that keeps the rhythm of the frame rate itself, each commit a little late,
+    /// is not held back by more than its own unsteadiness, for as long as it runs: a picture
+    /// that comes early for its place in the second waits until the second is over.
+    #[test]
+    fn a_client_that_keeps_the_rhythm_itself_is_held_back_by_its_unsteadiness_at_most() {
+        let frame = Duration::from_nanos(1_000_000_000 / 85);
+        let unsteady = Duration::from_micros(500);
+        for every in [frame, frame.mul_f64(1.001)] {
+            let run = run(
+                85,
+                Client::KeepsItsOwnRhythm {
+                    every,
+                    off: unsteady,
+                },
+                60,
+            );
+            assert!(
+                run.starts.len() >= 85 * 59,
+                "only {} frames in a minute",
+                run.starts.len()
+            );
+            let waits = sorted(run.waits);
+            let longest = waits[waits.len() - 1];
+            assert!(
+                longest <= unsteady + Duration::from_micros(10),
+                "a picture waited {longest:?}"
+            );
+        }
+        // One that is a thousandth slower than the frame rate, as a timer makes it, hardly
+        // ever comes early for its place.
+        let every = frame.mul_f64(1.001);
+        let waits = sorted(
+            run(
+                85,
+                Client::KeepsItsOwnRhythm {
+                    every,
+                    off: unsteady,
+                },
+                60,
+            )
+            .waits,
+        );
+        let late = waits[waits.len() * 99 / 100];
+        assert!(
+            late <= Duration::from_micros(1),
+            "one picture in a hundred waited {late:?} or more"
+        );
+    }
+
+    /// A very unsteady client at exactly the frame rate loses frames to the one-second rule:
+    /// a picture that would have to wait for more than a moment gives way to the next one.
+    /// Most of its pictures still go out when they are committed, and what is held back
+    /// does not pile up.
+    #[test]
+    fn a_very_unsteady_client_loses_frames_but_does_not_fall_behind() {
+        let frame = Duration::from_nanos(1_000_000_000 / 85);
+        let client = Client::KeepsItsOwnRhythm {
+            every: frame,
+            off: Duration::from_millis(2),
+        };
+        let run = run(85, client, 60);
+        assert!(
+            run.starts.len() >= 85 * 50,
+            "only {} frames in a minute",
+            run.starts.len()
+        );
+        let waits = sorted(run.waits);
+        let median = waits[waits.len() / 2];
+        assert!(
+            median <= GIVE_WAY_AFTER,
+            "half the pictures waited {median:?} or more"
+        );
+        let longest = waits[waits.len() - 1];
+        assert!(longest <= frame * 4, "a picture waited {longest:?}");
+    }
+
+    /// A client that draws three times as fast as the stream gets the newest of its pictures
+    /// into every frame, and the frames evenly spaced.
+    #[test]
+    fn a_client_that_is_faster_than_the_stream_gets_the_whole_frame_rate() {
+        let frame = Duration::from_nanos(1_000_000_000 / 85);
+        let run = run(
+            85,
+            Client::KeepsItsOwnRhythm {
+                every: frame / 3,
+                off: Duration::ZERO,
+            },
+            6,
+        );
+        let settled = run
+            .starts
+            .iter()
+            .filter(|&&start| start >= SECOND * 2)
+            .count();
+        assert!(
+            settled + 2 >= 85 * 4,
+            "only {settled} frames in four seconds"
+        );
+    }
+
+    #[test]
+    fn a_pause_does_not_let_more_frames_through_afterwards() {
+        let mut pacing = pacing(85);
+        let begin = Instant::now();
+        let mut now = begin;
+        let mut starts = Vec::new();
+        // Frames as fast as they may, a pause of three seconds, then as fast as they may again.
+        for round in 0..2 {
+            for _ in 0..200 {
+                pacing.changed();
+                now += pacing.frame_asked(now, None);
+                pacing.frame_started(now);
+                starts.push(now.duration_since(begin));
+            }
+            if round == 0 {
+                now += Duration::from_secs(3);
+            }
+        }
+        let most = most_within_a_second(&starts);
+        assert!(most <= 85, "{most} frames started within one second");
+    }
+}
