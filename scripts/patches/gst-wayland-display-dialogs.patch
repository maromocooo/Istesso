+    /// Puts the windows that have `window` as their parent above it again, and theirs above
+    /// them: a dialog stays in front of the window it belongs to when that window is clicked.
+    pub(crate) fn raise_children_of(&mut self, window: &Window) {
+        use smithay::wayland::seat::WaylandFocus;
+        let Some(surface) = window.wl_surface().map(|s| s.into_owned()) else {
+            return;
+        };
+        let children: Vec<Window> = self
+            .space
+            .elements()
+            .filter(|w| {
+                w.toplevel()
+                    .and_then(|toplevel| toplevel.parent())
+                    .is_some_and(|parent| parent == surface)
+            })
+            .cloned()
+            .collect();
