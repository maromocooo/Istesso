+    /// Gives the keyboard to the window that is on top, when the window that had it is not
+    /// shown any more or nothing has it. A dialog that closes hands the keyboard back to the
+    /// window under it this way.
+    pub(crate) fn keyboard_to_the_top_window(&mut self) {
+        use smithay::utils::IsAlive;
+        let keyboard = self.seat.get_keyboard().unwrap();
+        let lost = match keyboard.current_focus() {
+            Some(FocusTarget::Wayland(window)) => {
+                !window.alive() || !self.space.elements().any(|w| *w == window)
+            }
+            Some(FocusTarget::Popup(_)) => false,
+            None => true,
+        };
