 //!   processes do.
 //!
 //! "Windows" are toplevels: popups and the cursor do not count.
+//!
+//! A third thing is here because it is about windows that come later: where they go. The
+//! compositor has one output and shows one picture. The first window fills it. A window that
+//! has a parent (a dialog: `xdg_toplevel.set_parent`) keeps its own size and lies over the
+//! middle of its parent, inside the output ([`place`]); any other window is put at the corner,
+//! as the first is. Whatever comes later lies above what was there, and has the keyboard
+//! until it goes.
+
+use smithay::utils::{Logical, Point, Rectangle, Size};
+
+/// Where a window of this `size` is put on an output of that size. With a parent (where the
+/// parent lies): over the parent's middle, moved as far as it takes to lie inside the output.
+/// A window larger than the output begins at the output's corner, and what does not fit is
+/// not seen. Without a parent: at the corner.
+pub fn place(
+    size: Size<i32, Logical>,
+    parent: Option<Rectangle<i32, Logical>>,
+    output: Size<i32, Logical>,
+) -> Point<i32, Logical> {
+    let Some(parent) = parent else {
+        return (0, 0).into();
+    };
+    let along = |from: i32, parent: i32, window: i32, output: i32| {
+        (from + (parent - window) / 2).min(output - window).max(0)
+    };
+    (
+        along(parent.loc.x, parent.size.w, size.w, output.w),
+        along(parent.loc.y, parent.size.h, size.h, output.h),
+    )
+        .into()
+}
 
