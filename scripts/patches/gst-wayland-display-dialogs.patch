+//! Integration tests for windows that come after the first (see `comp::windows`): a dialog
+//! an application opens has to be in the picture, in front, where a person looks for it, and
+//! has to take the keyboard and the pointer. A real Wayland client opens the windows.
+
+use crate::comp::FocusTarget;
+use crate::tests::fixture::Fixture;
+use smithay::backend::input::ButtonState;
+use smithay::desktop::Window;
+use smithay::utils::Point;
+use test_log::test;
+
+const WHITE: [u8; 4] = [255, 255, 255, 255];
+
+/// A first window that fills the output of 320 by 240, with the pointer in its middle.
+fn fixture() -> Fixture {
+    let mut f = Fixture::new();
+    f.create_window(320, 240);
+    f.server
+        .pointer_motion_absolute(0, Point::from((160.0, 120.0)));
+    f.round_trip();
+    // The cursor is left out of the frames, which are looked at pixel by pixel here.
+    f.server.set_cursor_sink(Some(Box::new(|_| {})));
+    f
+}
+
+/// Opens a second window that draws its picture once and then waits, as a question does.
+fn open(f: &mut Fixture, child: bool, size: (i32, i32)) {
+    if child {
+        f.client.create_child_window();
+    } else {
+        f.client.create_window();
+    }
+    f.round_trip();
+    f.client.setup_window_of_one_colour(size, WHITE);
+    f.round_trip();
+    f.round_trip();
+}
+
+/// How many pixels of the frame are white, in all of it and in the given part.
+fn white(f: &mut Fixture, (x0, y0, x1, y1): (usize, usize, usize, usize)) -> (usize, usize) {
+    let (frame, _) = f.server.create_frame().expect("no frame");
+    let frame = frame.map_readable().expect("frame cannot be read");
+    let is_white =
+        |x: usize, y: usize| frame.as_slice()[(y * 320 + x) * 4..][..3] == [255, 255, 255];
+    let all = (0..240)
+        .flat_map(|y| (0..320).map(move |x| (x, y)))
+        .filter(|(x, y)| is_white(*x, *y))
+        .count();
+    let part = (y0..y1)
+        .flat_map(|y| (x0..x1).map(move |x| (x, y)))
+        .filter(|(x, y)| is_white(*x, *y))
+        .count();
+    (all, part)
+}
+
+fn windows(f: &Fixture) -> Vec<Window> {
+    f.server.space.elements().cloned().collect()
+}
+
+fn has_the_keyboard(f: &Fixture, window: &Window) -> bool {
+    matches!(
+        f.server.seat.get_keyboard().unwrap().current_focus(),
+        Some(FocusTarget::Wayland(focused)) if &focused == window
+    )
+}
+
+#[test]
+fn a_window_that_draws_once_is_in_the_frame_and_takes_a_click() {
+    let mut f = fixture();
+    let (before, _) = white(&mut f, (0, 0, 0, 0));
+    // A second window without a parent, as some applications open their dialogs. It is told
+    // to fill the output like any window; this one keeps its own size all the same.
+    open(&mut f, false, (120, 80));
+    assert_eq!(
+        f.client.told_to_last_window(),
+        ((320, 240), Some((0, 0)), true)
+    );
+
+    // It has committed its picture exactly once, and it is in the frame: at the corner,
+    // above the first window.
+    let (_, at_the_corner) = white(&mut f, (0, 0, 120, 80));
+    assert_eq!(at_the_corner, 120 * 80);
+    let stack = windows(&f);
+    assert_eq!(stack.len(), 2);
+    assert_eq!(
+        f.server.space.element_location(&stack[1]).unwrap(),
+        (0, 0).into()
+    );
+    assert_eq!(stack[1].geometry().size, (120, 80).into());
+    assert!(has_the_keyboard(&f, &stack[1]));
+
+    // And the pointer reaches it.
+    f.server
+        .pointer_motion_absolute(0, Point::from((60.0, 40.0)));
+    f.round_trip();
+    f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    f.server.pointer_button(0, 0x110, ButtonState::Released);
+    f.round_trip();
+    assert_eq!(f.client.pointer_over_last_window(), (true, 2));
+    assert!(before < 120 * 80, "the first window is not white itself");
+}
+
+#[test]
+fn a_child_keeps_its_size_and_lies_over_the_middle_of_its_parent() {
+    let mut f = fixture();
+    open(&mut f, true, (120, 80));
+    // Not told to fill the output, nor any size: only how much room there is. (An ordinary
+    // window is told no bounds, which travels as 0 by 0.)
+    assert_eq!(
+        f.client.told_to_last_window(),
+        ((0, 0), Some((320, 240)), false)
+    );
+
+    let stack = windows(&f);
+    assert_eq!(stack.len(), 2);
+    // Above its parent, over the parent's middle.
+    assert_eq!(
+        f.server.space.element_location(&stack[1]).unwrap(),
+        (100, 80).into()
+    );
+    let (_, in_the_middle) = white(&mut f, (100, 80, 220, 160));
+    assert_eq!(in_the_middle, 120 * 80);
+    let (_, at_the_corner) = white(&mut f, (0, 0, 100, 80));
+    assert!(at_the_corner < 100 * 80 / 2);
+
+    // The pointer stood in the middle of the output, and the child came up under it: the
+    // pointer is the child's without having moved, and so is a click.
+    assert_eq!(f.client.pointer_over_last_window(), (true, 0));
+    f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    f.server.pointer_button(0, 0x110, ButtonState::Released);
+    f.round_trip();
+    assert_eq!(f.client.pointer_over_last_window(), (true, 2));
+    // One jump out of the child, and it is over the parent; one jump back, over the child.
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    assert!(!f.client.pointer_over_last_window().0);
+    f.server
+        .pointer_motion_absolute(0, Point::from((101.0, 81.0)));
+    f.round_trip();
+    assert!(f.client.pointer_over_last_window().0);
+}
+
+#[test]
+fn a_window_that_comes_has_the_keyboard_and_gives_it_back_when_it_goes() {
+    let mut f = fixture();
+    let parent = windows(&f)[0].clone();
+    assert!(has_the_keyboard(&f, &parent));
+
+    open(&mut f, true, (120, 80));
+    let child = windows(&f)[1].clone();
+    assert!(has_the_keyboard(&f, &child));
+    assert!(!has_the_keyboard(&f, &parent));
+
+    // The question is answered: its window goes, and the keyboard is the parent's again.
+    f.client.close_window();
+    f.round_trip();
+    assert_eq!(windows(&f).len(), 1);
+    assert!(has_the_keyboard(&f, &parent));
+    // So is the pointer, which has not moved, and the question is out of the picture.
+    assert!(f.client.pointer_over_last_window().0);
+    let (_, in_the_middle) = white(&mut f, (100, 80, 220, 160));
+    assert!(in_the_middle < 120 * 80 / 2);
+
+    // The last window goes as well: nothing has the keyboard, and nothing breaks.
+    f.client.close_window();
+    f.round_trip();
+    assert!(
+        f.server
+            .seat
+            .get_keyboard()
+            .unwrap()
+            .current_focus()
+            .is_none()
+    );
+}
+
+#[test]
+fn a_click_on_the_parent_leaves_its_child_in_front() {
+    let mut f = fixture();
+    open(&mut f, true, (120, 80));
+    let (parent, child) = (windows(&f)[0].clone(), windows(&f)[1].clone());
+
+    // A click on the parent, beside the child.
+    f.server
+        .pointer_motion_absolute(0, Point::from((10.0, 10.0)));
+    f.round_trip();
+    f.server.pointer_button(0, 0x110, ButtonState::Pressed);
+    f.server.pointer_button(0, 0x110, ButtonState::Released);
+    f.round_trip();
+    assert_eq!(windows(&f), [parent, child]);
+    let (_, in_the_middle) = white(&mut f, (100, 80, 220, 160));
+    assert_eq!(in_the_middle, 120 * 80);
+}
+
+#[test]
+fn a_child_larger_than_the_output_begins_at_the_corner() {
+    let mut f = fixture();
+    open(&mut f, true, (400, 300));
+    let stack = windows(&f);
+    assert_eq!(
+        f.server.space.element_location(&stack[1]).unwrap(),
+        (0, 0).into()
+    );
+    // What fits is shown, the rest is not, and a frame is still made.
+    let (all, _) = white(&mut f, (0, 0, 0, 0));
+    assert_eq!(all, 320 * 240);
+    assert!(has_the_keyboard(&f, &stack[1]));
+}
+
+#[test]
+fn two_ordinary_windows_are_both_told_to_fill_the_output_and_the_later_is_in_front() {
+    let mut f = fixture();
+    let first = windows(&f)[0].clone();
+    // A second ordinary window, which does as it is told.
+    open(&mut f, false, (320, 240));
+    assert_eq!(
+        f.client.told_to_last_window(),
+        ((320, 240), Some((0, 0)), true)
+    );
+    let stack = windows(&f);
+    assert_eq!(stack[0], first);
+    assert_eq!(
+        f.server.space.element_location(&stack[1]).unwrap(),
+        (0, 0).into()
+    );
+    let (all, _) = white(&mut f, (0, 0, 0, 0));
+    assert_eq!(all, 320 * 240);
+}
