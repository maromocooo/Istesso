+                    .find(|w| w.wl_surface().is_some_and(|s| *s == parent))
+            })
+            .and_then(|parent| {
+                let at = self.space.element_location(parent)?;
+                Some(Rectangle::new(at, parent.geometry().size))
+            });
+        let output = self
+            .output
+            .as_ref()
+            .and_then(|output| output.current_mode())
+            .map(|mode| mode.size.to_logical(1))
