@@ -0,0 +1,410 @@
+//! Trial only: committed text for the client that has the keyboard (Istesso's ADR 0007,
+//! "確定した文字", and ADR 0020, route d). The device a person types on composes the text with
+//! its own input method and sends only what was committed; here it is handed to the text input
+//! (`zwp_text_input_v3`) of the client that has the keyboard, when that client has enabled one.
+//! There is no input method on this side, so this is not Smithay's text-input module (which
+//! passes everything on to an input method and drops it without one).
+//!
+//! A client without an enabled text input gets printable ASCII as key presses of the US layout;
+//! other text is dropped. The text itself is never logged: only how many characters went which
+//! way.
+
+use smithay::backend::input::KeyState;
+use smithay::input::keyboard::Keycode;
+use smithay::reexports::wayland_protocols::wp::text_input::zv3::server::{
+    zwp_text_input_manager_v3::{self, ZwpTextInputManagerV3},
+    zwp_text_input_v3::{self, ZwpTextInputV3},
+};
+use smithay::reexports::wayland_server::{
+    Client, DataInit, Dispatch, DisplayHandle, GlobalDispatch, New, Resource,
+    backend::{ClientId, GlobalId, ObjectId},
+    protocol::wl_surface::WlSurface,
+};
+
+use crate::comp::State;
+
+/// The most characters of one piece of committed text (ADR 0007).
+pub const MOST_CHARS: usize = 256;
+/// The most bytes (UTF-8) of one piece of committed text (ADR 0007).
+pub const MOST_BYTES: usize = 1024;
+
+/// Whether a piece of committed text may be handed on: not empty, within the limits, and
+/// without control characters.
+pub fn acceptable(text: &str) -> bool {
+    !text.is_empty()
+        && text.len() <= MOST_BYTES
+        && text.chars().count() <= MOST_CHARS
+        && !text.chars().any(char::is_control)
+}
+
+/// The key (Linux number) and whether Shift goes with it, for a printable ASCII character on
+/// the US layout.
+pub fn us_key(c: char) -> Option<(u32, bool)> {
+    const LETTERS: [u32; 26] = [
+        30, 48, 46, 32, 18, 33, 34, 35, 23, 36, 37, 38, 50, 49, 24, 25, 16, 19, 31, 20, 22, 47,
+        17, 45, 21, 44,
+    ];
+    Some(match c {
+        'a'..='z' => (LETTERS[(c as u8 - b'a') as usize], false),
+        'A'..='Z' => (LETTERS[(c as u8 - b'A') as usize], true),
+        '1'..='9' => ((c as u8 - b'1') as u32 + 2, false),
+        '0' => (11, false),
+        '!' => (2, true),
+        '@' => (3, true),
+        '#' => (4, true),
+        '$' => (5, true),
+        '%' => (6, true),
+        '^' => (7, true),
+        '&' => (8, true),
+        '*' => (9, true),
+        '(' => (10, true),
+        ')' => (11, true),
+        ' ' => (57, false),
+        '-' => (12, false),
+        '_' => (12, true),
+        '=' => (13, false),
+        '+' => (13, true),
+        '[' => (26, false),
+        '{' => (26, true),
+        ']' => (27, false),
+        '}' => (27, true),
+        '\\' => (43, false),
+        '|' => (43, true),
+        ';' => (39, false),
+        ':' => (39, true),
+        '\'' => (40, false),
+        '"' => (40, true),
+        '`' => (41, false),
+        '~' => (41, true),
+        ',' => (51, false),
+        '<' => (51, true),
+        '.' => (52, false),
+        '>' => (52, true),
+        '/' => (53, false),
+        '?' => (53, true),
+        _ => return None,
+    })
+}
+
+const KEY_LEFTSHIFT: u32 = 42;
+
+/// The text inputs of all clients, and which surface has the keyboard.
+#[derive(Default)]
+pub struct TextInputs {
+    instances: Vec<Instance>,
+    focus: Option<WlSurface>,
+    /// The surfaces that were told the keyboard again (below): each one once, never again.
+    retold: Vec<WlSurface>,
+}
+
+struct Instance {
+    object: ZwpTextInputV3,
+    /// How many `commit` requests the client has made (the serial of `done`).
+    commits: u32,
+    /// What the client asked for since its last `commit`.
+    pending: Option<bool>,
+    enabled: bool,
+    /// The surface it was told it entered, if any.
+    entered: Option<WlSurface>,
+}
+
+fn same_client(a: &ObjectId, b: &ObjectId) -> bool {
+    a.same_client_as(b)
+}
+
+impl TextInputs {
+    pub fn global(dh: &DisplayHandle) -> GlobalId {
+        dh.create_global::<State, ZwpTextInputManagerV3, _>(1, ())
+    }
+
+    fn add(&mut self, object: ZwpTextInputV3) {
+        let mut instance = Instance {
+            object,
+            commits: 0,
+            pending: None,
+            enabled: false,
+            entered: None,
+        };
+        if let Some(focus) = self.focus.as_ref().filter(|s| s.is_alive()) {
+            if same_client(&instance.object.id(), &focus.id()) {
+                instance.object.enter(focus);
+                instance.entered = Some(focus.clone());
+            }
+        }
+        self.instances.push(instance);
+    }
+
+    fn remove(&mut self, id: &ObjectId) {
+        self.instances.retain(|i| &i.object.id() != id);
+    }
+
+    fn instance(&mut self, object: &ZwpTextInputV3) -> Option<&mut Instance> {
+        self.instances.iter_mut().find(|i| &i.object == object)
+    }
+
+    /// The keyboard went to `surface` (or to nobody): the text inputs of the old one's client
+    /// are told they left, those of the new one's client that they entered.
+    pub fn focus_changed(&mut self, surface: Option<WlSurface>) {
+        let surface = surface.filter(|s| s.is_alive());
+        if self.focus == surface {
+            return;
+        }
+        for instance in &mut self.instances {
+            if let Some(old) = instance.entered.take() {
+                if old.is_alive() {
+                    instance.object.leave(&old);
+                }
+            }
+            // Until the client enables it again for the new surface.
+            instance.enabled = false;
+            instance.pending = None;
+        }
+        self.focus = surface;
+        if let Some(focus) = &self.focus {
+            for instance in &mut self.instances {
+                if same_client(&instance.object.id(), &focus.id()) {
+                    instance.object.enter(focus);
+                    instance.entered = Some(focus.clone());
+                }
+            }
+        }
+    }
+
+    /// The surface with the keyboard, when a text input of its client entered it and has not
+    /// enabled itself (nor asked to).
+    fn not_enabled_focus(&mut self) -> Option<WlSurface> {
+        self.retold.retain(|s| s.is_alive());
+        let focus = self.focus.clone().filter(|s| s.is_alive())?;
+        if self.retold.contains(&focus) {
+            return None;
+        }
+        self.instances
+            .iter()
+            .any(|i| i.entered.as_ref() == Some(&focus) && !i.enabled && i.pending.is_none())
+            .then_some(focus)
+    }
+
+    /// Hands `text` to the enabled text input of the client that has the keyboard. False when
+    /// there is none.
+    pub fn commit(&mut self, text: &str) -> bool {
+        let Some(focus) = self.focus.as_ref().filter(|s| s.is_alive()) else {
+            return false;
+        };
+        let Some(instance) = self
+            .instances
+            .iter()
+            .find(|i| i.enabled && i.entered.as_ref() == Some(focus))
+        else {
+            return false;
+        };
+        instance.object.commit_string(Some(text.to_string()));
+        instance.object.done(instance.commits);
+        true
+    }
+}
+
+impl State {
+    /// After the keyboard moved to a window: if a text input of its client entered it and has
+    /// not enabled itself 0.3 s (or 1 s) later, the window is told once more that it has the
+    /// keyboard (keyboard leave, then enter, to that surface only). Seen on the host: the Text
+    /// Editor, when it restores a page from its session, enables its text input only after a
+    /// second keyboard enter (its one text input was created, and told it entered, before).
+    ///
+    /// * Once per surface, never again (`retold`), and never for a client without a text input.
+    /// * Only while no key is down: the leave and the enter go out together in this one callback,
+    ///   so no key event comes between them, and none is held that the client would forget.
+    /// * The seat is not asked: its focus, the active window, the stacking, the keyboard's holder
+    ///   and the recent input serials stay as they are (docs/m3-compositor-windows.md).
+    pub fn text_inputs_check_soon(&mut self) {
+        use smithay::reexports::calloop::timer::{TimeoutAction, Timer};
+        for wait in [300u64, 1000] {
+            let _ = self.handle.insert_source(
+                Timer::from_duration(std::time::Duration::from_millis(wait)),
+                |_, _, state| {
+                    state.tell_keyboard_again_for_text_input();
+                    TimeoutAction::Drop
+                },
+            );
+        }
+    }
+
+    fn tell_keyboard_again_for_text_input(&mut self) {
+        use smithay::input::keyboard::KeyboardTarget;
+        use smithay::utils::SERIAL_COUNTER;
+        if !self.seat.get_keyboard().unwrap().pressed_keys().is_empty() {
+            return;
+        }
+        let Some(surface) = self.text_inputs.not_enabled_focus() else {
+            return;
+        };
+        self.text_inputs.retold.push(surface.clone());
+        let seat = self.seat.clone();
+        KeyboardTarget::leave(&surface, &seat, self, SERIAL_COUNTER.next_serial());
+        KeyboardTarget::enter(&surface, &seat, self, Vec::new(), SERIAL_COUNTER.next_serial());
+        tracing::info!("text input not enabled: the keyboard was told to its window again");
+    }
+
+    /// Committed text from the device (ADR 0007, "確定した文字"): to the enabled text input of
+    /// the client that has the keyboard; otherwise printable ASCII as keys; otherwise dropped.
+    pub fn commit_text(&mut self, text: &str) {
+        let chars = text.chars().count();
+        if !acceptable(text) {
+            tracing::info!(chars, "text dropped: not within the limits");
+            return;
+        }
+        if self.text_inputs.commit(text) {
+            tracing::info!(chars, "text delivered through text-input-v3");
+            return;
+        }
+        let keyboard = self.seat.get_keyboard().unwrap();
+        if keyboard.current_focus().is_none() {
+            tracing::info!(chars, "text dropped: nobody has the keyboard");
+            return;
+        }
+        // On another layout than US (XKB_DEFAULT_LAYOUT, as the everyday trial sets it) only the
+        // keys that are the same on it: letters, digits and the space.
+        let us = std::env::var("XKB_DEFAULT_LAYOUT").map_or(true, |l| l.is_empty() || l == "us");
+        let keys: Option<Vec<(u32, bool)>> = text
+            .chars()
+            .map(|c| if us || c.is_ascii_alphanumeric() || c == ' ' { us_key(c) } else { None })
+            .collect();
+        let Some(keys) = keys else {
+            tracing::info!(
+                chars,
+                "text dropped: the client with the keyboard has no text input enabled, and the text is not ASCII"
+            );
+            return;
+        };
+        let held = keyboard.modifier_state();
+        if held.shift || held.ctrl || held.alt || held.logo {
+            tracing::info!(chars, "text dropped: a modifier key is held");
+            return;
+        }
+        // With Caps Lock on, a letter's case comes from Shift the other way round.
+        let caps = held.caps_lock;
+        for ((code, shift), c) in keys.into_iter().zip(text.chars()) {
+            let shift = shift != (caps && c.is_ascii_alphabetic());
+            let time = std::time::Duration::from(self.clock.now()).as_millis() as u32;
+            if shift {
+                let key = self.scancode_to_keycode(KEY_LEFTSHIFT);
+                self.keyboard_input(time, key, KeyState::Pressed);
+            }
+            let key: Keycode = self.scancode_to_keycode(code);
+            self.keyboard_input(time, key, KeyState::Pressed);
+            self.keyboard_input(time, key, KeyState::Released);
+            if shift {
+                let key = self.scancode_to_keycode(KEY_LEFTSHIFT);
+                self.keyboard_input(time, key, KeyState::Released);
+            }
+        }
+        tracing::info!(chars, "text delivered as keys");
+    }
+}
+
+impl GlobalDispatch<ZwpTextInputManagerV3, ()> for State {
+    fn bind(
+        _: &mut State,
+        _: &DisplayHandle,
+        _: &Client,
+        resource: New<ZwpTextInputManagerV3>,
+        _: &(),
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        data_init.init(resource, ());
+    }
+}
+
+impl Dispatch<ZwpTextInputManagerV3, ()> for State {
+    fn request(
+        state: &mut State,
+        _: &Client,
+        _: &ZwpTextInputManagerV3,
+        request: zwp_text_input_manager_v3::Request,
+        _: &(),
+        _: &DisplayHandle,
+        data_init: &mut DataInit<'_, State>,
+    ) {
+        match request {
+            zwp_text_input_manager_v3::Request::GetTextInput { id, .. } => {
+                let object = data_init.init(id, ());
+                state.text_inputs.add(object);
+            }
+            zwp_text_input_manager_v3::Request::Destroy => {}
+            _ => {}
+        }
+    }
+}
+
+impl Dispatch<ZwpTextInputV3, ()> for State {
+    fn request(
+        state: &mut State,
+        _: &Client,
+        resource: &ZwpTextInputV3,
+        request: zwp_text_input_v3::Request,
+        _: &(),
+        _: &DisplayHandle,
+        _: &mut DataInit<'_, State>,
+    ) {
+        match request {
+            zwp_text_input_v3::Request::Enable => {
+                if let Some(instance) = state.text_inputs.instance(resource) {
+                    instance.pending = Some(true);
+                }
+            }
+            zwp_text_input_v3::Request::Disable => {
+                if let Some(instance) = state.text_inputs.instance(resource) {
+                    instance.pending = Some(false);
+                }
+            }
+            zwp_text_input_v3::Request::Commit => {
+                if let Some(instance) = state.text_inputs.instance(resource) {
+                    instance.commits = instance.commits.wrapping_add(1);
+                    if let Some(enable) = instance.pending.take() {
+                        // Only a text input that was told it entered a surface may be enabled.
+                        instance.enabled = enable && instance.entered.is_some();
+                    }
+                }
+            }
+            zwp_text_input_v3::Request::Destroy => {
+                state.text_inputs.remove(&resource.id());
+            }
+            // Surrounding text, content type, cursor rectangle: nothing on this side uses them.
+            _ => {}
+        }
+    }
+
+    fn destroyed(state: &mut State, _: ClientId, resource: &ZwpTextInputV3, _: &()) {
+        state.text_inputs.remove(&resource.id());
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn limits() {
+        assert!(acceptable("日本語"));
+        assert!(acceptable(&"あ".repeat(256)));
+        assert!(!acceptable(&"あ".repeat(257)));
+        assert!(!acceptable(&"a".repeat(1025)));
+        assert!(!acceptable(&"\u{1F600}".repeat(257)));
+        assert!(!acceptable(""));
+        assert!(!acceptable("a\nb"));
+        assert!(!acceptable("a\u{7f}"));
+        assert!(!acceptable("a\u{85}"));
+    }
+
+    #[test]
+    fn every_printable_ascii_character_has_a_key() {
+        for c in ' '..='~' {
+            assert!(us_key(c).is_some(), "{c:?}");
+        }
+        assert_eq!(us_key('a'), Some((30, false)));
+        assert_eq!(us_key('Z'), Some((44, true)));
+        assert_eq!(us_key('0'), Some((11, false)));
+        assert_eq!(us_key('?'), Some((53, true)));
+        assert_eq!(us_key('あ'), None);
+        assert_eq!(us_key('\t'), None);
+    }
+}
