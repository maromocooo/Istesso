/target
**/*.rs.bk
.DS_Store
*.swp
/dist
# SwiftPM build output (macos/screen-probe)
.build/
# Output of macos/gst-viewer/build.sh
/macos/gst-viewer/build/
# Bundles handed over between machines; never part of the history.
/handoff/
# Left behind by running the scripts in scripts/
__pycache__/

# Notes handed to the agent from other tools; not part of the project
/Claude outputs/
# Output of macos/client/build.sh
/macos/client/build/

# What the owner noticed while using the everyday trial (scripts/daily.sh note); never committed
/trial-notes.md

# Local trial shortcut bundles include this checkout's absolute path.
/build/shortcuts/
